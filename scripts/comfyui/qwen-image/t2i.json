{
  "description": "Qwen-Image text-to-image (GGUF Q4/Q5 by default for 16GB cards, via city96/ComfyUI-GGUF custom nodes). To use a LoRA, add a LoraLoaderModelOnly node between the unet loader and KSampler and bind lora_name/lora_strength to it.",
  "requires": ["prompt"],
  "bindings": {
    "prompt": {"node_id": "6", "field": "text"},
    "negative_prompt": {"node_id": "7", "field": "text"},
    "seed": {"node_id": "3", "field": "seed"},
    "steps": {"node_id": "3", "field": "steps"},
    "width": {"node_id": "5", "field": "width"},
    "height": {"node_id": "5", "field": "height"}
  },
  "graph": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "inputs": {"unet_name": "qwen-image-Q4_K_M.gguf"}
    },
    "2": {
      "class_type": "CLIPLoaderGGUF",
      "inputs": {"clip_name": "qwen_2.5_vl_7b-Q4_K_M.gguf", "type": "qwen_image"}
    },
    "9": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "qwen_image_vae.safetensors"}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""}
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""}
    },
    "5": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {"width": 1328, "height": 1328, "batch_size": 1}
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0],
        "seed": 0,
        "steps": 20,
        "cfg": 3.5,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["3", 0], "vae": ["9", 0]}
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {"images": ["8", 0], "filename_prefix": "zerollama_qwen_image"}
    }
  }
}
