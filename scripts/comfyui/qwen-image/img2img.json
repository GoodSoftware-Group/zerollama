{
  "description": "Qwen-Image img2img (denoise from an uploaded reference image instead of pure noise).",
  "requires": ["prompt", "image"],
  "bindings": {
    "prompt": {"node_id": "6", "field": "text"},
    "negative_prompt": {"node_id": "7", "field": "text"},
    "seed": {"node_id": "3", "field": "seed"},
    "steps": {"node_id": "3", "field": "steps"},
    "image": {"node_id": "20", "field": "image"}
  },
  "graph": {
    "1": {
      "class_type": "UnetLoaderGGUF",
      "inputs": {"unet_name": "qwen-image-Q4_K_M.gguf"}
    },
    "2": {
      "class_type": "CLIPLoaderGGUF",
      "inputs": {"clip_name": "qwen_2.5_vl_7b-Q4_K_M.gguf", "type": "qwen_image"}
    },
    "9": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "qwen_image_vae.safetensors"}
    },
    "20": {
      "class_type": "LoadImage",
      "inputs": {"image": "agent-input.png"}
    },
    "21": {
      "class_type": "VAEEncode",
      "inputs": {"pixels": ["20", 0], "vae": ["9", 0]}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""}
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""}
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["21", 0],
        "seed": 0,
        "steps": 20,
        "cfg": 3.5,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 0.6
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["3", 0], "vae": ["9", 0]}
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {"images": ["8", 0], "filename_prefix": "zerollama_qwen_image_img2img"}
    }
  }
}
