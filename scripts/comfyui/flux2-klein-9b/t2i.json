{
  "description": "FLUX.2 Klein 9B (FP8) text-to-image. Note: the fast MLX path (x/flux2-klein) targets the 4B-shaped variant; Klein 9B runs through Comfy.",
  "requires": ["prompt"],
  "bindings": {
    "prompt": {"node_id": "6", "field": "text"},
    "seed": {"node_id": "3", "field": "noise_seed"},
    "steps": {"node_id": "3", "field": "steps"},
    "width": {"node_id": "5", "field": "width"},
    "height": {"node_id": "5", "field": "height"}
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {"unet_name": "flux2-klein-9b-fp8.safetensors", "weight_dtype": "fp8_e4m3fn"}
    },
    "2": {
      "class_type": "DualCLIPLoader",
      "inputs": {"clip_name1": "clip_l.safetensors", "clip_name2": "t5xxl_fp8_e4m3fn.safetensors", "type": "flux2"}
    },
    "9": {
      "class_type": "VAELoader",
      "inputs": {"vae_name": "flux2_ae.safetensors"}
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {"clip": ["2", 0], "text": ""}
    },
    "11": {
      "class_type": "FluxGuidance",
      "inputs": {"conditioning": ["6", 0], "guidance": 3.5}
    },
    "5": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
    },
    "3": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "model": ["1", 0],
        "positive": ["11", 0],
        "negative": ["11", 0],
        "latent_image": ["5", 0],
        "add_noise": "enable",
        "noise_seed": 0,
        "steps": 12,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "start_at_step": 0,
        "end_at_step": 10000,
        "return_with_leftover_noise": "disable"
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {"samples": ["3", 0], "vae": ["9", 0]}
    },
    "save": {
      "class_type": "SaveImage",
      "inputs": {"images": ["8", 0], "filename_prefix": "zerollama_flux2_klein_9b"}
    }
  }
}
