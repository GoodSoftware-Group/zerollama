From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Tue, 28 Jul 2026 20:00:00 -0700
Subject: [PATCH] convert fp8 native compressed tensors tensor

convert fp8 native compressed tensors tensor
---
 conversion/base.py | 32 ++++++++++++++++++++++++++++----
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/conversion/base.py b/conversion/base.py
index 0e6deed60..71c6144bf 100644
--- a/conversion/base.py
+++ b/conversion/base.py
@@ -523,7 +523,9 @@ class ModelBase:
                 if quant_format == "float-quantized" or quant_format == "int-quantized" or quant_format == "naive-quantized":
                     block_size = weight_config.get("block_structure", None)
                     strategy = weight_config.get("strategy")
-                    assert strategy == "channel" or strategy == "block"
+                    # WHY tensor: compressed-tensors FP8 e2e (e.g. nm-testing TinyLlama) uses
+                    # per-tensor weight_scale + F8_E4M3 — same pack path as ModelOpt.
+                    assert strategy in ("channel", "block", "tensor")
                     assert weight_config.get("group_size") is None  # didn't find a model using this yet
                     is_fp8 = (
                         quant_format == "float-quantized"
@@ -535,10 +537,32 @@ class ModelBase:
                             weight_name = name.removesuffix("_scale")
                             w = self.model_tensors[weight_name]
                             s = self.model_tensors[name]
-                            self.model_tensors[weight_name] = lambda w=w, s=s: dequant_simple(w(), s(), block_size)
+                            is_native_fp8 = False
+                            try:
+                                is_native_fp8 = w().dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+                            except Exception:
+                                is_native_fp8 = False
+                            can_native = False
+                            if self._fp8_native and is_fp8 and is_native_fp8:
+                                if strategy in ("tensor", "channel") and block_size is None:
+                                    can_native = True
+                                elif block_size is not None:
+                                    bs = tuple(int(x) for x in block_size)
+                                    can_native = bool(bs) and (bs[-1] % 32 == 0)
+                            if can_native:
+                                self._fp8_native_tensors.add(weight_name)
+                                self._fp8_native_scales[weight_name] = s
+                                self._fp8_native_block_sizes[weight_name] = (
+                                    None if block_size is None else tuple(int(x) for x in block_size)
+                                )
+                                tensors_to_remove.append(name)
+                            else:
+                                self.model_tensors[weight_name] = lambda w=w, s=s: dequant_simple(w(), s(), block_size)
+                                tensors_to_remove.append(name)
+                                if self._fp8_as_q8 and is_fp8:
+                                    self._fp8_dequantized.add(weight_name)
+                        if name.endswith(".input_scale"):
                             tensors_to_remove.append(name)
-                            if self._fp8_as_q8 and is_fp8:
-                                self._fp8_dequantized.add(weight_name)
                 elif quant_format == "pack-quantized":
                     assert weight_config.get("strategy") == "group"
                     assert weight_config.get("type", "int") == "int"
