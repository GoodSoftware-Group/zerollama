+llama_mark_cost llama_kv_cache::mark_cost() const {
+    llama_mark_cost cost;
+    // A layer reused by another model layer points at the same tensors.
+    std::unordered_set<const ggml_tensor *> seen;
+    for (const auto & layer : layers) {
+        if (!layer.k || layer.k->ne[1] <= 0) {
+            continue;
+        }
+        const int64_t npos = layer.k->ne[1];
+        const int64_t nstr = layer.k->ne[2] > 0 ? layer.k->ne[2] : 1;
+        const ggml_tensor * ts[] = { layer.k, layer.v, layer.k_idx, layer.k_scale, layer.v_scale };
+        for (const ggml_tensor * t : ts) {
+            if (!t || !seen.insert(t).second) {
+                continue;
+            }
+            cost.per_token += ggml_nbytes(t) / (size_t) (npos * nstr);
+        }
+    }
+    return cost;
+}
