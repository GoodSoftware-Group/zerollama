+void llama_get_mark_cost(const struct llama_context * ctx, size_t * recurrent, size_t * per_token) {
+    size_t rec = 0;
+    size_t tok = 0;
+    if (ctx && ctx->get_memory()) {
+        const llama_mark_cost cost = ctx->get_memory()->mark_cost();
+        rec = cost.recurrent;
+        tok = cost.per_token;
+    }
+    if (recurrent) {
+        *recurrent = rec;
+    }
+    if (per_token) {
+        *per_token = tok;
+    }
+}
