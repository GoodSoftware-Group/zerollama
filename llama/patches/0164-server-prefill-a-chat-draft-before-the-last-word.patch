         }
     }
 
+    // Stop every draft and leave its evaluated tokens in the slot. The next
+    // task selects that slot by the shared prefix. Safe only between batches:
+    // process_single_task declines work while a decode is in progress.
+    void yield_prefill_slots() {
+        for (auto & slot : slots) {
+            if (!slot.is_processing() || !slot.task || !slot.task->params.prefill_only) {
+                continue;
+            }
+            SLT_INF(slot, "%s", "prefill gives way\n");
+            send_final_response(slot);
+            slot.release();
+        }
+    }
+
     bool process_single_task(server_task && task, bool is_yielding) {
         // while yielding, an encode / decode is running and only reading the server state is safe
         if (is_yielding && task.type != SERVER_TASK_TYPE_METRICS && task.type != SERVER_TASK_TYPE_SLOT_GET) {
@@ -3373,9 +3393,20 @@ private:
                     }
 
                     const int id_task = task.id;
+                    const bool draft = task.params.prefill_only;
                     const bool is_gen_task =
                         task.type == SERVER_TASK_TYPE_COMPLETION || task.type == SERVER_TASK_TYPE_INFILL;
 
+                    // A draft stays behind work that is already waiting for a slot.
+                    if (draft && queue_tasks.has_deferred_task()) {
+                        SRV_DBG("prefill waits behind a deferred task, id_task = %d\n", id_task);
+                        queue_tasks.defer(std::move(task));
+                        break;
+                    }
+                    // Free the draft before selection so this task can reuse its prefix
+                    // instead of landing on an empty slot.
+                    yield_prefill_slots();
+
                     const auto plan = slot_sched.select(get_slot_infos(), task, get_task_lora(task));
 
                     server_slot * slot = plan.id_slot == -1 ? nullptr : get_slot_by_id(plan.id_slot);
@@ -3430,13 +3461,13 @@ private:
                             SRV_ERR("failed to launch slot with parent task, id_task = %d\n", id_task);
                             break; // drop the task
