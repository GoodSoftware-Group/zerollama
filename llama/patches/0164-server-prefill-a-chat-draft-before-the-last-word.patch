             }
 
             if (slot.state == SLOT_STATE_DONE_PROMPT) {
+                // n_predict == 0 still has a budget while n_gen == 0, so a normal
+                // completion would sample one token and append it to the cache.
+                // A draft must stop on the prompt or the next request's prefix breaks.
+                if (slot.task->params.prefill_only) {
+                    send_final_response(slot);
+                    slot.release();
+                    slot.i_batch = -1;
+                    return;
+                }
+
                 if (slot.task->type == SERVER_TASK_TYPE_EMBEDDING) {
                     // prompt evaluated for embedding
                     send_embedding(slot, batch.view);
@@ -6016,6 +6057,16 @@ std::unique_ptr<server_res_generator> server_routes::handle_completions_impl(
             task.id_slot = json_value(data, "id_slot", -1);
             sse_ping_interval = task.params.sse_ping_interval;
 
+            // Set after the schema so a client cache_prompt/stream/n_predict cannot
+            // turn the draft into a one-token completion.
+            if (json_value(data, "prefill_only", false)) {
+                task.params.prefill_only = true;
+                task.params.n_predict    = 0;
+                task.params.stream       = false;
+                task.params.cache_prompt = true;
+                task.params.n_cmpl       = 1;
+            }
+
             // OAI-compat
             task.params.res_type          = res_type;
             task.params.oaicompat_cmpl_id = completion_id;
@@ -6697,6 +6748,73 @@ void server_routes::init_routes() {
             session);
     };
 
+    // POST /prefill and /v1/prefill. Body is a chat request. The last message
+    // is cut before its last word, the template is rendered, and the prompt is
+    // truncated at U+F8FF so the cache is a prefix of the finished request.
+    this->post_prefill = [this](const server_http_req & req) {
+        auto fail = [this](const std::string & message) {
+            auto res = create_response();
+            res->error(format_error_response(message, ERROR_TYPE_INVALID_REQUEST));
+            return res;
+        };
+
+        json body = json::parse(req.body);
+        if (!body.contains("messages") || !body.at("messages").is_array() || body.at("messages").empty()) {
+            return fail("prefill requires a messages array");
+        }
+        json & last = body.at("messages").back();
+        if (!last.is_object() || !last.contains("content") || !last.at("content").is_string()) {
+            return fail("prefill needs text in the last message");
+        }
+        last["content"] = llama_prefill_before_last_word(last.at("content").get<std::string>()) + LLAMA_PREFILL_END;
+
+        std::vector<raw_buffer> files;
+        common_chat_session session;
+        json parsed = oaicompat_chat_params_parse(
+            ctx_server.vocab,
+            body,
+            meta->chat_params,
+            files,
+            session);
+        if (!files.empty()) {
+            return fail("prefill does not cache prompts with media");
+        }
+        std::string prompt = json_value(parsed, "prompt", std::string());
+        const auto end = prompt.rfind(LLAMA_PREFILL_END);
+        if (end == std::string::npos) {
+            return fail("the chat template dropped the draft");
+        }
+        prompt.resize(end);
+        if (prompt.empty()) {
+            auto res = create_response();
+            res->ok(json{{"object", "prefill"}, {"cached_tokens", 0}, {"prompt_tokens", 0}});
+            return res;
+        }
+        parsed["prompt"]        = prompt;
+        parsed["n_predict"]     = 0;
+        parsed["stream"]        = false;
+        parsed["cache_prompt"]  = true;
+        parsed["prefill_only"]  = true;
+
+        auto res = handle_completions_impl(
+            req,
+            SERVER_TASK_TYPE_COMPLETION,
+            parsed,
+            files,
+            TASK_RESPONSE_TYPE_NONE,
+            session);
+        if (res->status != 200 || res->data.empty()) {
+            return res;
+        }
+        const json done = json::parse(res->data);
+        res->ok(json{
+            {"object",         "prefill"},
+            {"cached_tokens",  json_value(done, "tokens_cached", 0)},
+            {"prompt_tokens",  json_value(done, "tokens_evaluated", 0)},
+        });
+        return res;
+    };
+
     this->post_chat_completions_tok = [this](const server_http_req & req) {
         return handle_count_tokens(req, TASK_RESPONSE_TYPE_OAI_CHAT);
     };
