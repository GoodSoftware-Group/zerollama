From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nobody <>
Date: Thu, 19 Nov 2026 23:40:00 -0800
Subject: [PATCH] server: mark hybrid prompts on a 256-token grid

Recurrent and hybrid state cannot be rewound, and the prefill loop only
checkpointed at turn boundaries. --checkpoint-every-n-tokens was registered
twice, so the flag wrote the min-step and never broke a batch. Hybrid and
recurrent models now checkpoint every 256 tokens (Kinetic's GRID; the legacy
8192 profile spacing stays auto), and a full checkpoint list keeps those
marks spread across the prompt.
---
 common/arg.cpp                  |  16 ++--
 common/common.h                 |   2 +-
 tools/server/server-context.cpp | 125 +++++++++++++++++++++++++-------
 3 files changed, 107 insertions(+), 36 deletions(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index 5626b36..64de59d 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -1726,7 +1726,12 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
     ).set_env("LLAMA_ARG_CTX_CHECKPOINTS").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
     add_opt(common_arg(
         {"-cpent", "--checkpoint-every-n-tokens"}, "N",
-        string_format("create a checkpoint every n tokens during prefill (processing), -1 to disable (default: %d)", params.checkpoint_every_nt),
+        string_format(
+            "checkpoint every N tokens during prefill (default: %d)\n"
+            "0 = auto: a 256-token grid on hybrid and recurrent models, no extra grid otherwise\n"
+            "-1 = disable the grid\n"
+            "8192 on a hybrid or recurrent model is treated as auto (legacy profile spacing)",
+            params.checkpoint_every_nt),
         [](common_params & params, int value) {
             params.checkpoint_every_nt = value;
         }
@@ -1741,15 +1746,6 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.checkpoint_min_step = value;
         }
     ).set_env("LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT").set_examples({LLAMA_EXAMPLE_SERVER}));
-    // Eliza fork L2 profiles emit --checkpoint-every-n-tokens; map onto ggml-org's
-    // checkpoint_min_step so ZEROLLAMA_LLAMA_FORK=1 argv does not crash at startup.
-    add_opt(common_arg(
-        {"-cpent", "--checkpoint-every-n-tokens"}, "N",
-        string_format("alias for --checkpoint-min-step (eliza L2 profiles; default: %d, -1 disables → 0)", params.checkpoint_min_step),
-        [](common_params & params, int value) {
-            params.checkpoint_min_step = value < 0 ? 0 : value;
-        }
-    ).set_env("LLAMA_ARG_CHECKPOINT_EVERY_NT").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
     add_opt(common_arg(
         {"-cram", "--cache-ram"}, "N",
         string_format("set the maximum cache size in MiB (default: %d, 0 for decision models, -1 - no limit, 0 - disable)"
diff --git a/common/common.h b/common/common.h
index aee3558..c41285f 100644
--- a/common/common.h
+++ b/common/common.h
@@ -700,7 +700,7 @@ struct common_params {
     int32_t n_ctx_checkpoints   = 32;    // max number of context checkpoints per slot
     int32_t kv_unified_per_slot = 0;     // max context per parallel slot; 0 = unset
     int32_t checkpoint_min_step = 8192;  // minimum spacing between context checkpoints
-    int32_t checkpoint_every_nt = 8192;  // L2 fork: checkpoint every n tokens during prefill (-1 disable)
+    int32_t checkpoint_every_nt = 0;     // 0 = auto mark grid, -1 = off, >0 = every N prefill tokens
     int32_t cache_ram_mib       = 8192;  // -1 = no limit, 0 - disable, 1 = 1 MiB, etc.
