From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 10 Jul 2026 22:53:11 -0700
Subject: [PATCH] ggml-metal: extend small-batch mat-vec to 16 rows (upstream
 #25453)

---
 ggml/src/ggml-metal/ggml-metal-ops.cpp | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index b7f9b2d0d..1c6f48f62 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -2353,7 +2353,7 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
            op->src[0]->type == GGML_TYPE_Q8_0 ||
            op->src[0]->type == GGML_TYPE_MXFP4 ||
            op->src[0]->type == GGML_TYPE_IQ4_NL ||
-           false) && (ne11 >= 2 && ne11 <= 8)
+           false) && (ne11 >= 2 && ne11 <= 16)
          ) ||
          (
           (
@@ -2362,7 +2362,7 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
            op->src[0]->type == GGML_TYPE_Q6_K ||
            op->src[0]->type == GGML_TYPE_Q2_K ||
            op->src[0]->type == GGML_TYPE_Q3_K ||
-           false) && (ne11 >= 4 && ne11 <= 8)
+           false) && (ne11 >= 4 && ne11 <= 16)
          )
         )
        ) {
@@ -2403,6 +2403,19 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
                 r1ptg = 4; break;
             case 5:
                 r1ptg = 5; break;
+            case 9:
+                r1ptg = 3; break;
+            case 10:
+                r1ptg = 5; break;
+            case 11:
+            case 12:
+                r1ptg = 4; break;
+            case 13:
+            case 14:
+            case 15:
+                r1ptg = 5; break;
+            case 16:
+                r1ptg = 4; break;
             default:
                 GGML_ABORT("unsupported ne11");
         };
