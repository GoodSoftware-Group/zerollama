+// are left unread. Version 2 removes version 1 files: those kept tokens written
+// one at a time, which a GPU resume must not restore. The oldest files go first
+// once the directory passes its byte budget.
 
 #include <algorithm>
 #include <cstdint>
@@ -94,7 +95,7 @@ class llama_warm_disk {
 public:
     static constexpr uint64_t k_budget = 2ull << 30;
     static constexpr char     k_magic[8] = { 'Z', 'R', 'W', 'A', 'R', 'M', 0, 0 };
-    static constexpr uint64_t k_version = 1;
+    static constexpr uint64_t k_version = 2;
     static constexpr uint32_t k_max_tokens = 1u << 20;
     static constexpr uint32_t k_max_ckpts  = 4096;
 
