 #include "server-stream.h"
 #include "server-loop-guard.h"
 #include "server-adaptive-dm.h"
@@ -412,6 +413,16 @@ struct server_slot {
     // used to determine the slot that has been used the longest
     int64_t t_last_used = -1;
 
+    // GPU resume. settle_grid is the prompt batch size. settle_trusted is the
+    // last full batch a later request may reuse (<0 means the whole sequence).
+    // settle_cell is the next batch to rewrite while idle, or <0 when idle
+    // work is finished.
+    int32_t settle_grid    = 0;
+    int32_t settle_trusted = -1;
+    int32_t settle_cell    = -1;
+    int32_t settle_to      = 0;
+    int64_t t_settle_ms    = 0;
+
     // generation props
     int32_t n_ctx   = 0;  // context size per slot
     int32_t n_keep  = 0;
@@ -442,11 +453,50 @@ struct server_slot {
 
     server_prompt prompt;
 
-    bool prompt_save(server_prompt_cache & prompt_cache) const {
+    bool prompt_save(server_prompt_cache & prompt_cache) {
         if (prompt.tokens.size() == 0) {
             return false;
         }
 
+        // Nothing before the first full batch was a resume point. Skip the
+        // copy; the next request runs the sequence again.
+        if (settle_trusted == 0) {
+            return false;
+        }
+
+        // A reply continues past the resume point. Copy the prefix, then put
+        // the tail tokens back so an idle rewrite can run them as a prompt.
+        struct restore_tail {
+            server_tokens & tokens;
+            llama_tokens    tail;
+            bool            on = false;
+            restore_tail(server_tokens & tokens, llama_tokens tail, bool on)
+                : tokens(tokens), tail(std::move(tail)), on(on) {}
+            ~restore_tail() {
+                if (!on) {
+                    return;
+                }
+                for (llama_token tok : tail) {
+                    tokens.push_back(tok);
+                }
+            }
+        } restore(prompt.tokens, {}, false);
+
+        if (settle_trusted > 0 && settle_trusted < prompt.n_tokens()) {
+            const llama_tokens & all = prompt.tokens.get_tokens();
+            const llama_pos cut = prompt.tokens.pos_next(settle_trusted);
+            // seq_pos_min is the sliding-window tail, not the first token.
+            // A cut at the resume mark deletes that tail. The next prompt then
+            // has n_past > 0 and pos_min == -1, and pre_decode aborts.
+            const llama_pos pos_min = ctx_tgt ? llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), id) : -1;
+            if (pos_min >= 0 && pos_min < cut) {
+                restore.tail.assign(all.begin() + settle_trusted, all.end());
+                mem.seq_rm(id, cut, -1);
+                prompt.tokens.keep_first((size_t) settle_trusted);
+                restore.on = true;
+            }
+        }
+
         const int64_t t_start = ggml_time_us();
 
         const size_t cur_size_tgt =           llama_state_seq_get_size_ext(ctx_tgt, id, LLAMA_STATE_SEQ_FLAGS_NONE);
@@ -559,6 +602,35 @@ struct server_slot {
         mem.seq_rm(id, -1, -1);
 
         prompt.clear();
+        settle_trusted = -1;
+        settle_cell    = -1;
+        settle_to      = 0;
+    }
+
+    // Record the resume point after a reply. Prompt-only sequences stay as
+    // they are: every token was written by a prompt batch.
+    void arm_settle() {
+        settle_cell    = -1;
+        settle_to      = 0;
+        settle_trusted = -1;
+        t_settle_ms    = 0;
+        if (settle_grid < 32 || !task || prompt.tokens.has_mtmd) {
+            return;
+        }
+        const int32_t n_all    = prompt.n_tokens();
+        const int32_t n_prompt = task->n_tokens();
+        if (n_prompt <= 0 || n_all <= n_prompt) {
+            return;
+        }
+        const int32_t mark = llama_settle_mark(n_prompt, settle_grid);
+        const int32_t end  = llama_settle_end(mark, n_all, settle_grid);
+        settle_trusted = mark;
+        if (end > mark) {
+            settle_cell = mark;
+            settle_to   = end;
+            t_settle_ms = ggml_time_ms();
+        }
+        SLT_TRC(*this, "GPU resume at token %d through %d\n", settle_trusted, end);
     }
 
     std::vector<common_adapter_lora_info> lora;
@@ -895,6 +967,8 @@ struct server_slot {
                 prompt_clear();
             }
 
+            arm_settle();
+
             callback_on_reset(*this);
 
             reset();
@@ -1364,6 +1438,9 @@ private:
     // Prefill checkpoint spacing. 0 means no extra marks beyond turn boundaries.
     int32_t prompt_mark_grid = 0;
 
+    // GPU prompt batch used as a resume grid. 0 keeps the whole sequence.
+    int32_t settle_grid = 0;
+
     // slots / clients
     std::vector<server_slot> slots;
 
@@ -1830,6 +1907,29 @@ private:
             return false;
         }
 
+        settle_grid = 0;
+        {
+            bool has_gpu = false;
+            for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+                const enum ggml_backend_dev_type type = ggml_backend_dev_type(ggml_backend_dev_get(i));
+                if (type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+                    has_gpu = true;
+                    break;
+                }
+            }
+            const char * settle_off = getenv("LLAMA_SETTLE");
+            const bool off = settle_off && settle_off[0] == '0';
+            // A draft context has its own cache; leave both sequences alone.
+            if (!off && has_gpu && params_base.n_gpu_layers != 0 && ctx_dft == nullptr &&
+                    ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_PART && ctx_tgt != nullptr) {
+                const int32_t grid = (int32_t) llama_n_ubatch(ctx_tgt);
+                if (grid >= 32) {
+                    settle_grid = grid;
+                    SRV_INF("GPU prompt resumes on a %d-token grid; the reply is rewritten while idle (LLAMA_SETTLE=0 disables)\n", settle_grid);
+                }
+            }
+        }
+
         for (int i = 0; i < params_base.n_parallel; i++) {
             server_slot & slot = slots[i];
 
@@ -1839,6 +1939,7 @@ private:
             slot.mem.init(ctx_tgt, ctx_dft);
             slot.spec    = spec.get();
             slot.n_ctx   = n_ctx_slot();
+            slot.settle_grid = settle_grid;
 
             slot.mctx                   = mctx;
             slot.prompt.tokens.has_mtmd = mctx != nullptr;
@@ -2046,6 +2147,11 @@ private:
         queue_tasks.on_update_slots([this]() {
             update_slots();
         });
+        if (settle_grid > 0) {
+            queue_tasks.on_idle([this]() {
