+            });
+        }
         queue_tasks.on_sleeping_state([this](bool sleeping) {
             handle_sleeping_state(sleeping);
         });
@@ -2199,6 +2305,12 @@ private:
     void update_prompt_cache(server_slot & slot, const server_task & task) {
         SRV_TRC("%s", "updating prompt cache\n");
 
+        // The live sequence is the resume point. A saved copy would replace it
+        // with an older prefix and drop the reply the idle rewrite is building.
+        if (slot.settle_trusted >= 0 && slot.prompt.tokens.get_common_prefix(task.tokens) > 0) {
+            return;
+        }
+
         const int64_t t_start = ggml_time_us();
 
         slot.prompt_save(*prompt_cache);
@@ -4238,6 +4350,74 @@ private:
         return false;
     }
 
+    // Rewrite one full prompt batch of a finished reply. Returns false when
+    // there is nothing to do yet, so the caller keeps waiting.
+    bool settle_idle() {
+        if (settle_grid < 32) {
+            return false;
+        }
+        for (auto & slot : slots) {
+            if (slot.is_processing()) {
+                return false;
+            }
+        }
+        server_slot * cur = nullptr;
+        for (auto & slot : slots) {
+            if (slot.settle_cell >= 0 && slot.settle_cell < slot.settle_to) {
+                cur = &slot;
+                break;
+            }
+        }
+        if (cur == nullptr || ggml_time_ms() - cur->t_settle_ms < LLAMA_SETTLE_IDLE_MS) {
+            return false;
+        }
+        const int32_t from = cur->settle_cell;
+        const int32_t n    = settle_grid;
+        if (n > batch.n_tokens_alloc || from + n > cur->settle_to || from + n > cur->prompt.n_tokens()) {
+            cur->settle_cell = -1;
+            return false;
+        }
+
+        batch.clear();
+        // seq_pos_min is the sliding-window tail. Cutting at the resume mark
+        // deletes that tail, and the rewrite then attends to a hole.
+        const llama_pos cut = cur->prompt.tokens.pos_next(from);
+        const llama_pos pos_min = llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), cur->id);
+        if (pos_min < 0 || pos_min >= cut) {
+            SLT_TRC(*cur, "skipping GPU resume at token %d, window starts at %d\n", from, pos_min);
+            cur->settle_cell = -1;
+            return false;
+        }
+        cur->mem.seq_rm(cur->id, cut, -1);
+        for (int32_t i = 0; i < n; i++) {
+            const llama_token tok = cur->prompt.tokens[(size_t) (from + i)];
+            const llama_pos   pos = cur->prompt.tokens.pos_next(from + i);
+            if (!batch.add(cur->id, tok, pos, /* output */ false, /* is_prompt */ true)) {
+                batch.clear();
+                cur->settle_cell = -1;
+                SLT_WRN(*cur, "settle could not queue the batch at token %d\n", from);
+                return false;
+            }
+        }
+        llama_set_embeddings(ctx_tgt, false);
+        batch.render(0, n);
+        const int32_t ret = llama_process(ctx_tgt, LLAMA_PROCESS_TYPE_DECODE, batch.view.get());
+        batch.clear();
+        if (ret != 0) {
+            SLT_WRN(*cur, "settle could not rewrite the reply from token %d\n", from);
+            cur->settle_cell = -1;
+            return false;
+        }
+        llama_synchronize(ctx_tgt);
+        cur->settle_cell    = from + n;
+        cur->settle_trusted = cur->settle_cell;
+        SLT_TRC(*cur, "rewrote tokens [%d, %d) as a prompt batch\n", from, from + n);
+        if (cur->settle_cell >= cur->settle_to) {
+            cur->settle_cell = -1;
+        }
+        return true;
+    }
+
     void update_slots() {
 #ifdef DEBUG_TIMINGS
         static int64_t t_prev = 0;
@@ -4904,6 +5075,15 @@ private:
                                 n_past = 0;
                             }
 
+                            // Tokens past the last full prompt batch were written one
+                            // at a time. Run them again with the prompt.
+                            if (slot.settle_trusted >= 0) {
+                                n_past = std::min(n_past, (int) slot.settle_trusted);
+                            }
+                            slot.settle_trusted = -1;
+                            slot.settle_cell    = -1;
+                            slot.settle_to      = 0;
+
                             llama_pos pos_next = slot.prompt.tokens.pos_next(n_past);
 
                             // number of cached tokens shared with the new prompt, before any checkpoint is restored
@@ -4916,7 +5096,10 @@ private:
                                 const auto pos_min = llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), slot.id);
                                 if (pos_min == -1) {
-                                    SLT_ERR(slot, "n_past = %d, slot.prompt.tokens.size() = %d, seq_id = %d, pos_min = %d\n", n_past, (int) slot.prompt.tokens.size(), slot.id, pos_min);
-                                    GGML_ABORT("pos_min == -1, but n_past > 0 - should not happen: https://github.com/ggml-org/llama.cpp/pull/13833#discussion_r2116181237");
-                                }
+                                    // No cell remains for this sequence. Reusing n_past would
+                                    // read a cache that is already gone, so run the prompt again.
+                                    SLT_WRN(slot, "n_past = %d, slot.prompt.tokens.size() = %d, seq_id = %d, pos_min = %d; reprocessing the prompt\n", n_past, (int) slot.prompt.tokens.size(), slot.id, pos_min);
+                                    n_past   = 0;
+                                    pos_next = 0;
+                                } else {
 
                                 // when the prompt prefix does not match, print the tokens around the mismatch
@@ -4992,3 +5175,4 @@ private:
                                 pos_next = reuse.pos_next;
                                 n_past   = reuse.n_past;
+                                }
                             }
