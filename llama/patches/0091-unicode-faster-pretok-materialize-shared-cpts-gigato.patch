From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Thu, 30 Jul 2026 03:00:25 -0700
Subject: [PATCH] unicode: faster pretok materialize + shared cpts (gigatoken
 lessons)

Skip noop UTF-8 roundtrip in GPT-2 byte remap; append UTF-8 without per-cpt
temporary strings; pass shared codepoints into custom regex splitters so
unicode_regex_split does not decode the megaprompt twice. Identity-safe.
See docs/faster-bpe-tokenize.md (M15d / 0108).
---
 src/unicode.cpp | 108 +++++++++++++++++++++++-------------------------
 1 file changed, 51 insertions(+), 57 deletions(-)

diff --git a/src/unicode.cpp b/src/unicode.cpp
index 93996f9..14cfebf 100644
--- a/src/unicode.cpp
+++ b/src/unicode.cpp
@@ -194,30 +194,27 @@ static std::unordered_map<std::string, uint8_t> unicode_utf8_to_byte_map() {
 }
 
 static std::vector<std::string> unicode_byte_encoding_process(const std::vector<std::string> & bpe_words) {
+    // WHY: previous code decoded each word to codepoints then re-encoded to the same UTF-8
+    // (identity roundtrip) before GPT-2 byte remapping — pure waste on the megaprompt path.
+    // Words here were just built from unicode_cpt_to_utf8, so they are valid UTF-8.
     std::vector<std::string> bpe_encoded_words;
+    bpe_encoded_words.reserve(bpe_words.size());
     for (const auto & word : bpe_words) {
-        std::string text_utf;
-        auto utf_word =  unicode_cpts_from_utf8(word);
-        for (size_t i = 0; i < utf_word.size(); ++i) {
-            text_utf += unicode_cpt_to_utf8(utf_word[i]);
-        }
-
         std::string encoded_token;
-        for (char & c : text_utf) {
+        encoded_token.reserve(word.size() * 2); // remapped bytes are often 2-byte UTF-8
+        for (unsigned char c : word) {
             encoded_token += unicode_byte_to_utf8(c);
         }
-        bpe_encoded_words.emplace_back(encoded_token);
+        bpe_encoded_words.emplace_back(std::move(encoded_token));
     }
     return bpe_encoded_words;
 }
 
