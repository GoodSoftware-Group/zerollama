From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Sat, 24 Oct 2026 20:34:52 -0700
Subject: [PATCH] convert fp8 native compressed tensors tensor

---
 conversion/base.py.rej | 88 ++++++++++++++++++++++--------------------
 1 file changed, 47 insertions(+), 41 deletions(-)

diff --git a/conversion/base.py.rej b/conversion/base.py.rej
index b273699f7..ebff5c42f 100644
--- a/conversion/base.py.rej
+++ b/conversion/base.py.rej
@@ -1,42 +1,48 @@
 diff a/conversion/base.py b/conversion/base.py	(rejected hunks)
-@@ -558,7 +582,7 @@ class ModelBase:
-             elif quant_method == "modelopt":
-                 # Mixed-precision ModelOpt models: NVFP4 tensors are handled by
-                 # _generate_nvfp4_tensors; FP8 tensors have 1D weight_scale and
--                # are dequantized here. k/v scale tensors are unused.
-+                # are dequantized here (or packed native with --fp8-native).
-                 for name in self.model_tensors.keys():
-                     if name.endswith(".weight_scale"):
-                         weight_name = name.removesuffix("_scale")
-@@ -567,13 +591,24 @@ class ModelBase:
-                             continue
-                         w = self.model_tensors[weight_name]
-                         s = self.model_tensors[name]
--                        is_fp8_weight = False
--                        if self._fp8_as_q8:
--                            is_fp8_weight = w().dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
--                        self.model_tensors[weight_name] = lambda w=w, s=s: dequant_simple(w(), s(), None)
--                        tensors_to_remove.append(name)
--                        if is_fp8_weight:
--                            self._fp8_dequantized.add(weight_name)
-+                        is_fp8_e4m3 = False
-+                        try:
-+                            is_fp8_e4m3 = w().dtype == torch.float8_e4m3fn
-+                        except Exception:
-+                            is_fp8_e4m3 = False
-+                        if self._fp8_native and is_fp8_e4m3:
-+                            # Keep E4M3 bytes; absorb per-tensor/per-row scale at pack time.
-+                            self._fp8_native_tensors.add(weight_name)
-+                            self._fp8_native_scales[weight_name] = s
-+                            tensors_to_remove.append(name)
-+                        else:
-+                            is_fp8_weight = False
-+                            if self._fp8_as_q8:
-+                                is_fp8_weight = w().dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
-+                            self.model_tensors[weight_name] = lambda w=w, s=s: dequant_simple(w(), s(), None)
-+                            tensors_to_remove.append(name)
-+                            if is_fp8_weight:
-+                                self._fp8_dequantized.add(weight_name)
-                     if name.endswith((".input_scale", ".k_scale", ".v_scale")):
-                         tensors_to_remove.append(name)
-             elif quant_method is not None:
+@@ -536,7 +536,9 @@ class ModelBase:
+                 if quant_format == "float-quantized" or quant_format == "int-quantized" or quant_format == "naive-quantized":
+                     block_size = weight_config.get("block_structure", None)
+                     strategy = weight_config.get("strategy")
+-                    assert strategy == "channel" or strategy == "block"
++                    # WHY tensor: compressed-tensors FP8 e2e (e.g. nm-testing TinyLlama) uses
++                    # per-tensor weight_scale + F8_E4M3 — same pack path as ModelOpt.
++                    assert strategy in ("channel", "block", "tensor")
+                     assert weight_config.get("group_size") is None  # didn't find a model using this yet
+                     is_fp8 = (
+                         quant_format == "float-quantized"
+@@ -548,10 +550,32 @@ class ModelBase:
+                             weight_name = name.removesuffix("_scale")
+                             w = self.model_tensors[weight_name]
+                             s = self.model_tensors[name]
+-                            self.model_tensors[weight_name] = lambda w=w, s=s: dequant_simple(w(), s(), block_size)
++                            is_native_fp8 = False
++                            try:
++                                is_native_fp8 = w().dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
++                            except Exception:
++                                is_native_fp8 = False
++                            can_native = False
++                            if self._fp8_native and is_fp8 and is_native_fp8:
++                                if strategy in ("tensor", "channel") and block_size is None:
++                                    can_native = True
++                                elif block_size is not None:
++                                    bs = tuple(int(x) for x in block_size)
++                                    can_native = bool(bs) and (bs[-1] % 32 == 0)
++                            if can_native:
++                                self._fp8_native_tensors.add(weight_name)
++                                self._fp8_native_scales[weight_name] = s
++                                self._fp8_native_block_sizes[weight_name] = (
++                                    None if block_size is None else tuple(int(x) for x in block_size)
++                                )
++                                tensors_to_remove.append(name)
++                            else:
++                                self.model_tensors[weight_name] = lambda w=w, s=s: dequant_simple(w(), s(), block_size)
++                                tensors_to_remove.append(name)
++                                if self._fp8_as_q8 and is_fp8:
++                                    self._fp8_dequantized.add(weight_name)
++                        if name.endswith(".input_scale"):
+                             tensors_to_remove.append(name)
+-                            if self._fp8_as_q8 and is_fp8:
+-                                self._fp8_dequantized.add(weight_name)
+                 elif quant_format == "pack-quantized":
+                     assert weight_config.get("strategy") == "group"
+                     assert weight_config.get("type", "int") == "int"
