diff --git a/gguf-py/gguf/quants.py b/gguf-py/gguf/quants.py
index a5d85ac95..c26b516cf 100644
--- a/gguf-py/gguf/quants.py
+++ b/gguf-py/gguf/quants.py
@@ -837,12 +837,64 @@ class FP8_E4M3(__Quant, qtype=GGMLQuantizationType.FP8_E4M3):
         vals = cls.e4m3_to_fp32(qs)
         return d * vals
 
+    @classmethod
+    def expand_block_scales_to_ggml(
+        cls,
+        scale: np.ndarray,
+        shape: tuple[int, int],
+        block_size: Sequence[int],
+    ) -> np.ndarray:
+        """Expand HF block scales to per-GGML-block F32 scales ``(rows, cols/32)``.
+
+        Mirrors ``dequant_simple`` (repeat_interleave + crop), then samples one
+        scale per 32-wide GGML block along the last dim. Requires
+        ``block_size[-1] % 32 == 0`` so each GGML block is uniform.
+        """
+        rows, cols = shape
+        if cols % 32 != 0:
+            raise ValueError(f"FP8_E4M3 pack requires cols % 32 == 0, got {cols}")
+        bs = tuple(int(x) for x in block_size)
+        if not bs or bs[-1] % 32 != 0:
+            raise ValueError(
+                f"FP8_E4M3 block pack needs block_size[-1] % 32 == 0, got {bs}"
+            )
+        scale_arr = np.asarray(scale, dtype=np.float32)
+        # Drop leading singleton dims (e.g. expert batch).
+        while scale_arr.ndim > len(bs) and scale_arr.shape[0] == 1:
+            scale_arr = scale_arr.reshape(scale_arr.shape[1:])
+        if scale_arr.ndim != len(bs):
+            raise ValueError(
+                f"scale ndim {scale_arr.ndim} != len(block_size) {len(bs)} "
+                f"(scale shape {scale_arr.shape}, block_size {bs})"
+            )
+        # Broadcast like dequant_simple onto (rows, cols) for 2D weights.
+        if len(bs) == 1:
+            # scale along last dim only → shape (ceil(cols/bs0),) or (rows, ceil(cols/bs0))
+            if scale_arr.ndim == 1:
+                s = np.repeat(scale_arr, bs[0])[:cols]
+                s = np.broadcast_to(s, (rows, cols)).copy()
+            else:
+                s = np.repeat(scale_arr, bs[0], axis=-1)[..., :cols]
+                if s.shape[0] != rows:
+                    raise ValueError(f"scale rows {s.shape[0]} != weight rows {rows}")
+        else:
+            # Trailing dims match weight; typical FP8: block_size=[128,128].
+            s = scale_arr
+            for i, size in enumerate(bs):
+                s = np.repeat(s, size, axis=i)
+            s = s[:rows, :cols]
+        n_blocks = cols // 32
+        return s[:, 0:cols:32].reshape(rows, n_blocks)
+
     @classmethod
     def pack_e4m3_with_scale(cls, qs: np.ndarray, scale: float | np.ndarray) -> np.ndarray:
-        """Pack raw float8_e4m3fn bytes with per-tensor or per-row F32 scale into blocks.
+        """Pack raw float8_e4m3fn bytes with per-tensor, per-row, or per-block F32 scale.
 
         qs: uint8 array shaped (rows, cols) with cols % 32 == 0.
-        scale: scalar or per-row array.
+        scale:
+          - scalar / size-1 → broadcast to all blocks
+          - shape (rows,) → same scale for every block in the row
+          - shape (rows, cols/32) → per-GGML-block scale (e.g. from 128×128 maps)
         Returns uint8 array shaped (rows, (cols/32)*34) for GGUFWriter.
         """
         qs = np.asarray(qs, dtype=np.uint8)
@@ -854,22 +906,24 @@ class FP8_E4M3(__Quant, qtype=GGMLQuantizationType.FP8_E4M3):
             raise ValueError(f"FP8_E4M3 pack requires cols % 32 == 0, got {cols}")
         n_blocks_per_row = cols // 32
         scale_arr = np.asarray(scale, dtype=np.float32)
-        if scale_arr.ndim == 0:
-            scale_arr = np.full((rows,), float(scale_arr), dtype=np.float32)
-        else:
+        if scale_arr.ndim == 0 or scale_arr.size == 1:
+            block_scales = np.full((rows, n_blocks_per_row), float(scale_arr.reshape(-1)[0]), dtype=np.float32)
+        elif scale_arr.ndim == 1 or (scale_arr.ndim == 2 and scale_arr.shape[1] == 1):
             scale_arr = scale_arr.reshape(-1)
-            if scale_arr.size == 1:
-                scale_arr = np.full((rows,), float(scale_arr[0]), dtype=np.float32)
             if scale_arr.size != rows:
                 raise ValueError(f"scale size {scale_arr.size} != rows {rows}")
-
-        out = np.empty((rows, n_blocks_per_row, 34), dtype=np.uint8)
-        for r in range(rows):
-            d_f16 = np.frombuffer(np.float16(scale_arr[r]).tobytes(), dtype=np.uint8)
-            for b in range(n_blocks_per_row):
-                out[r, b, 0:2] = d_f16
-                out[r, b, 2:] = flat_rows[r, b * 32:(b + 1) * 32]
-        return out.reshape(rows, n_blocks_per_row * 34)
+            block_scales = np.repeat(scale_arr.reshape(rows, 1), n_blocks_per_row, axis=1)
+        elif scale_arr.ndim == 2 and scale_arr.shape == (rows, n_blocks_per_row):
+            block_scales = scale_arr
+        else:
+            raise ValueError(
+                f"scale shape {scale_arr.shape} unsupported "
+                f"(want scalar, ({rows},), or ({rows}, {n_blocks_per_row}))"
+            )
+
+        d_f16 = block_scales.astype(np.float16).view(np.uint8).reshape(rows, n_blocks_per_row, 2)
+        qs_blocks = flat_rows.reshape(rows, n_blocks_per_row, 32)
+        return np.concatenate([d_f16, qs_blocks], axis=-1).reshape(rows, n_blocks_per_row * 34)
 
 
 
