From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Tue, 14 Jul 2026 20:47:17 -0700
Subject: [PATCH] convert: native FP8 pack for 128x128 weight_scale_inv

Expand HF block scales onto GGML 32-wide blocks when block_size[-1]%32==0
so --fp8-native skips full F16 dequant for DeepSeek-style FP8.
---
 conversion/base.py     | 33 +++++++++++++++--
 convert_hf_to_gguf.py  |  3 +-
 gguf-py/gguf/quants.py | 84 ++++++++++++++++++++++++++++++++++--------
 3 files changed, 100 insertions(+), 20 deletions(-)

diff --git a/conversion/base.py b/conversion/base.py
index 71c6144bf..e01ed6a6c 100644
--- a/conversion/base.py
+++ b/conversion/base.py
@@ -166,6 +166,7 @@ class ModelBase:
         self._fp8_dequantized: set[str] = set()
         self._fp8_native_tensors: set[str] = set()
         self._fp8_native_scales: dict[str, Callable[[], Tensor]] = dict()
+        self._fp8_native_block_sizes: dict[str, Sequence[int] | None] = dict()
         if self._fp8_native and self._fp8_as_q8:
             logger.warning("--fp8-native overrides --fp8-as-q8")
             self._fp8_as_q8 = False
@@ -453,17 +454,28 @@ class ModelBase:
                             is_fp8_e4m3 = w().dtype == torch.float8_e4m3fn
                         except Exception:
                             is_fp8_e4m3 = False
-                        # Native path only for scalar / 1D scales (no 128×128 block map yet).
-                        if self._fp8_native and is_fp8_e4m3 and block_size is None:
+                        # Native: scalar/1D scales, or block maps whose last dim is a multiple of 32
+                        # (e.g. weight_block_size=[128,128] → one GGML d per 32 cols inside each tile).
+                        can_native = False
+                        if self._fp8_native and is_fp8_e4m3:
+                            if block_size is None:
+                                can_native = True
+                            else:
+                                bs = tuple(int(x) for x in block_size)
+                                can_native = bool(bs) and (bs[-1] % 32 == 0)
+                        if can_native:
                             self._fp8_native_tensors.add(weight_name)
                             # scale_inv multiplies dequant; store as-is
                             self._fp8_native_scales[weight_name] = s
+                            self._fp8_native_block_sizes[weight_name] = (
+                                None if block_size is None else tuple(int(x) for x in block_size)
+                            )
                             tensors_to_remove.append(name)
                         else:
                             if self._fp8_native and is_fp8_e4m3 and block_size is not None:
                                 logger.warning(
                                     f"{weight_name}: FP8 weight_block_size={block_size} not supported "
-                                    "by --fp8-native yet; falling back to dequant"
+                                    "by --fp8-native (need block_size[-1] % 32 == 0); falling back to dequant"
                                 )
                             self.model_tensors[weight_name] = lambda w=w, s=s, bs=block_size: dequant_simple(w(), s(), bs)
                             tensors_to_remove.append(name)
@@ -611,6 +623,7 @@ class ModelBase:
                             # Keep E4M3 bytes; absorb per-tensor/per-row scale at pack time.
                             self._fp8_native_tensors.add(weight_name)
                             self._fp8_native_scales[weight_name] = s
+                            self._fp8_native_block_sizes[weight_name] = None
                             tensors_to_remove.append(name)
                         else:
                             is_fp8_weight = False
@@ -718,6 +731,18 @@ class ModelBase:
         scale_t = LazyTorchTensor.to_eager(self._fp8_native_scales[name]())
         scale = scale_t.detach().float().cpu().numpy()
         qs = data_torch.view(torch.uint8).cpu().numpy()
+        if qs.ndim == 1:
+            qs = qs.reshape(1, -1)
+        block_size = self._fp8_native_block_sizes.get(name)
+        if block_size is not None:
+            if qs.ndim != 2:
+                raise ValueError(
+                    f"{name}: --fp8-native block_size={block_size} expects 2D weight, got shape {qs.shape}"
+                )
+            block_scales = gguf.quants.FP8_E4M3.expand_block_scales_to_ggml(
+                scale, (qs.shape[0], qs.shape[1]), block_size
+            )
+            return gguf.quants.FP8_E4M3.pack_e4m3_with_scale(qs, block_scales)
         # Per-row scale: (out_features,) or (out_features, 1); else scalar / broadcast.
         if scale.ndim >= 1 and scale.size == qs.shape[0]:
             scale_arg = scale.reshape(qs.shape[0])
@@ -726,7 +751,7 @@ class ModelBase:
         else:
             raise ValueError(
                 f"{name}: unsupported FP8 scale shape {scale.shape} for --fp8-native "
-                f"(want scalar or per-row matching {qs.shape[0]})"
+                f"(want scalar, per-row matching {qs.shape[0]}, or block map)"
             )
         return gguf.quants.FP8_E4M3.pack_e4m3_with_scale(qs, scale_arg)
 
