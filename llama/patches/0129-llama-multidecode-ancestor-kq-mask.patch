+void llama_kv_cache::set_input_kq_mask_multidecode(ggml_tensor * dst, const llama_ubatch * ubatch, const slot_info & sinfo) const {
+    const uint32_t n_tokens = ubatch->n_tokens;
+
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst->buffer));
+    GGML_ASSERT(ubatch->parent != nullptr);
+    GGML_ASSERT(sinfo.n_stream() == 1); // MultiDecode v0: single stream
+    GGML_ASSERT(swa_type == LLAMA_SWA_TYPE_NONE);
+
+    const int64_t n_kv     = dst->ne[0];
+    const int64_t n_stream = dst->ne[3];
+    GGML_ASSERT(n_stream == 1);
+    GGML_ASSERT(n_tokens % n_stream == 0);
+    GGML_ASSERT(sinfo.size() == n_tokens);
+
+    // reverse map: cell index -> ubatch token index (v0 fresh forest = all cells from this ubatch)
+    std::vector<int32_t> cell_to_tok(n_kv, -1);
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        const uint32_t cell = sinfo.idxs[0][i];
+        GGML_ASSERT(cell < (uint32_t) n_kv);
+        cell_to_tok[cell] = (int32_t) i;
+    }
+
+    auto fill = [&](auto * data) {
+        using T = std::remove_reference_t<decltype(*data)>;
+        const T mask_keep = llama_cast<T>(0.0f);
+        const T mask_drop = llama_cast<T>(-INFINITY);
+
+        const llama_seq_id seq_id = ubatch->seq_id[0][0];
+        const auto & cells = (*v_cells).at(seq_to_stream[seq_id]);
+
+        for (uint32_t i = 0; i < n_tokens; ++i) {
+            // ancestor bitset over ubatch token indices
+            std::vector<char> allow(n_tokens, 0);
+            allow[i] = 1;
+            int32_t cur = ubatch->parent[i];
+            int depth = 0;
+            while (cur >= 0 && depth <= (int) n_tokens) {
+                GGML_ASSERT(cur < (int32_t) n_tokens);
+                allow[cur] = 1;
+                cur = ubatch->parent[cur];
+                ++depth;
+            }
+
+            const uint64_t idst = n_kv * i;
+            for (uint32_t j = 0; j < (uint32_t) n_kv; ++j) {
+                if (cells.is_empty(j) || !cells.seq_has(j, seq_id)) {
+                    data[idst + j] = mask_drop;
+                    continue;
+                }
+                const int32_t tok = cell_to_tok[j];
+                if (tok >= 0 && allow[tok]) {
+                    data[idst + j] = mask_keep;
+                } else {
+                    // cell not in this ubatch forest map, or not an ancestor — drop
+                    data[idst + j] = mask_drop;
+                }
+            }
+        }
+    };
+
+    if (dst->type == GGML_TYPE_F16) {
+        fill((ggml_fp16_t *) dst->data);
+    } else {
+        fill((float *) dst->data);
+    }
+}
