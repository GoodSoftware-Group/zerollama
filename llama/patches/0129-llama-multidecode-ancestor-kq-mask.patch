@@ -0,0 +1,245 @@
+// MultiDecode exactness lab (zerollama 0129)
+//
+// Packs shared prefix + 2 branches into one forest decode with parent[] + tree-depth pos[],
+// then compares leaf logits to two independent linear prefills.
+//
+// Usage:
+//   MULTIDECODE_MODEL=/path/model.gguf ./llama-multidecode-exactness
+//   # or: ./llama-multidecode-exactness -m /path/model.gguf
+// Skip (exit 0) if no model is provided.
+
+#include "llama.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+static void print_usage(const char * argv0) {
+    fprintf(stderr,
+            "usage: %s [-m model.gguf] [-ngl N]\n"
+            "  or set MULTIDECODE_MODEL=/path/model.gguf\n"
+            "  exits 0 without a model (CI skip)\n",
+            argv0);
+}
+
+static std::vector<llama_token> tokenize(const llama_vocab * vocab, const std::string & text, bool add_special) {
+    const int n = -llama_tokenize(vocab, text.c_str(), text.size(), nullptr, 0, add_special, true);
+    std::vector<llama_token> out(n);
+    if (llama_tokenize(vocab, text.c_str(), text.size(), out.data(), out.size(), add_special, true) < 0) {
+        fprintf(stderr, "tokenize failed\n");
+        exit(1);
+    }
+    return out;
+}
+
+static float max_abs_diff(const float * a, const float * b, int n) {
+    float m = 0.0f;
+    for (int i = 0; i < n; ++i) {
+        m = std::max(m, std::fabs(a[i] - b[i]));
+    }
+    return m;
+}
+
+static int decode_linear_leaf_logits(
+        llama_context * ctx,
+        const std::vector<llama_token> & tokens,
+        std::vector<float> & out_logits) {
+    llama_memory_clear(llama_get_memory(ctx), true);
+
+    const int n = (int) tokens.size();
+    llama_batch batch = llama_batch_init(n, 0, 1);
+    batch.n_tokens = n;
+    for (int i = 0; i < n; ++i) {
+        batch.token[i]     = tokens[i];
+        batch.pos[i]       = i;
+        batch.n_seq_id[i]  = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i]    = (i == n - 1) ? 1 : 0;
+    }
+    // parent stays NULL (standard causal)
+    if (llama_decode(ctx, batch) != 0) {
+        fprintf(stderr, "linear llama_decode failed\n");
+        llama_batch_free(batch);
+        return 1;
+    }
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+    const float * logits = llama_get_logits_ith(ctx, n - 1);
+    if (!logits) {
+        fprintf(stderr, "linear: null logits\n");
+        llama_batch_free(batch);
+        return 1;
+    }
+    out_logits.assign(logits, logits + n_vocab);
+    llama_batch_free(batch);
+    return 0;
+}
+
+int main(int argc, char ** argv) {
+    std::string model_path;
+    int ngl = 99;
+
+    if (const char * env = getenv("MULTIDECODE_MODEL")) {
+        model_path = env;
+    }
+
+    for (int i = 1; i < argc; ++i) {
+        if (strcmp(argv[i], "-m") == 0 && i + 1 < argc) {
+            model_path = argv[++i];
+        } else if (strcmp(argv[i], "-ngl") == 0 && i + 1 < argc) {
+            ngl = std::atoi(argv[++i]);
+        } else if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "--help") == 0) {
+            print_usage(argv[0]);
+            return 0;
+        }
+    }
+
+    if (model_path.empty()) {
+        fprintf(stderr, "multidecode-exactness: no model (set MULTIDECODE_MODEL or -m); skip\n");
+        return 0;
+    }
+
+    ggml_backend_load_all();
+
+    llama_model_params mparams = llama_model_default_params();
+    mparams.n_gpu_layers = ngl;
+    llama_model * model = llama_model_load_from_file(model_path.c_str(), mparams);
+    if (!model) {
+        fprintf(stderr, "failed to load model: %s\n", model_path.c_str());
+        return 1;
+    }
+
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+
+    // Forest: prefix + two short branches (shared root path)
+    const auto prefix = tokenize(vocab, "The capital of France is", true);
+    const auto branch_a = tokenize(vocab, " Paris", false);
+    const auto branch_b = tokenize(vocab, " Lyon", false);
+
+    if (prefix.empty() || branch_a.empty() || branch_b.empty()) {
+        fprintf(stderr, "empty tokenize result\n");
+        return 1;
+    }
+
+    // Build flat forest batch:
+    //   [prefix...][branch_a...][branch_b...]
+    // parents: chain within each path; branch roots attach to last prefix token
+    std::vector<llama_token> forest_tok;
+    std::vector<llama_pos>   forest_pos;
+    std::vector<int32_t>     forest_parent;
+    std::vector<int8_t>      forest_logits;
+
+    auto append_chain = [&](const std::vector<llama_token> & toks, int32_t parent0, llama_pos depth0, bool mark_leaf) {
+        int32_t prev = parent0;
+        for (size_t i = 0; i < toks.size(); ++i) {
+            forest_tok.push_back(toks[i]);
+            forest_pos.push_back(depth0 + (llama_pos) i);
+            forest_parent.push_back(prev);
+            forest_logits.push_back(0);
+            prev = (int32_t) forest_tok.size() - 1;
+        }
+        if (mark_leaf && !forest_logits.empty()) {
+            forest_logits.back() = 1;
+        }
+        return prev; // last index
+    };
+
+    // prefix: roots with parent -1, depths 0..n-1
+    int32_t last_prefix = -1;
+    for (size_t i = 0; i < prefix.size(); ++i) {
+        forest_tok.push_back(prefix[i]);
+        forest_pos.push_back((llama_pos) i);
+        forest_parent.push_back(last_prefix);
+        forest_logits.push_back(0);
+        last_prefix = (int32_t) forest_tok.size() - 1;
+    }
+    const int leaf_a = append_chain(branch_a, last_prefix, (llama_pos) prefix.size(), true);
+    const int leaf_b = append_chain(branch_b, last_prefix, (llama_pos) prefix.size(), true);
+    (void) leaf_a;
+    (void) leaf_b;
+
+    const int n_forest = (int) forest_tok.size();
+    fprintf(stderr, "forest tokens=%d prefix=%zu branch_a=%zu branch_b=%zu leaves=%d,%d\n",
+            n_forest, prefix.size(), branch_a.size(), branch_b.size(), leaf_a, leaf_b);
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx   = n_forest + 32;
+    cparams.n_batch = n_forest;
+    cparams.n_ubatch = n_forest;
+    cparams.n_seq_max = 1;
+
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (!ctx) {
+        fprintf(stderr, "failed to create context\n");
+        return 1;
+    }
+
+    // --- Path A: MultiDecode forest ---
+    llama_memory_clear(llama_get_memory(ctx), true);
+    llama_batch batch = llama_batch_init(n_forest, 0, 1);
+    batch.n_tokens = n_forest;
+    batch.parent = (int32_t *) malloc(sizeof(int32_t) * n_forest);
+    for (int i = 0; i < n_forest; ++i) {
+        batch.token[i]     = forest_tok[i];
+        batch.pos[i]       = forest_pos[i];
+        batch.parent[i]    = forest_parent[i];
+        batch.n_seq_id[i]  = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i]    = forest_logits[i];
+    }
+
+    if (llama_decode(ctx, batch) != 0) {
+        fprintf(stderr, "MultiDecode llama_decode failed\n");
+        llama_batch_free(batch);
+        llama_free(ctx);
+        llama_model_free(model);
+        return 1;
+    }
+
+    // logits rows appear in batch order for marked outputs → leaf_a then leaf_b
+    const float * md_a = llama_get_logits_ith(ctx, leaf_a);
+    const float * md_b = llama_get_logits_ith(ctx, leaf_b);
+    if (!md_a || !md_b) {
+        fprintf(stderr, "MultiDecode: null leaf logits (a=%p b=%p)\n", (const void *) md_a, (const void *) md_b);
+        llama_batch_free(batch);
+        llama_free(ctx);
+        llama_model_free(model);
+        return 1;
+    }
+    std::vector<float> md_logits_a(md_a, md_a + n_vocab);
+    std::vector<float> md_logits_b(md_b, md_b + n_vocab);
+    llama_batch_free(batch);
+
+    // --- Path B: two linear prefills ---
+    std::vector<llama_token> path_a = prefix;
+    path_a.insert(path_a.end(), branch_a.begin(), branch_a.end());
+    std::vector<llama_token> path_b = prefix;
+    path_b.insert(path_b.end(), branch_b.begin(), branch_b.end());
+
+    std::vector<float> lin_a, lin_b;
+    if (decode_linear_leaf_logits(ctx, path_a, lin_a) != 0) {
+        return 1;
+    }
+    if (decode_linear_leaf_logits(ctx, path_b, lin_b) != 0) {
+        return 1;
+    }
+
+    const float eps = 2e-2f; // fp16-tolerant
+    const float da = max_abs_diff(md_logits_a.data(), lin_a.data(), n_vocab);
+    const float db = max_abs_diff(md_logits_b.data(), lin_b.data(), n_vocab);
+
+    fprintf(stderr, "max_abs_diff leaf_a=%.6g leaf_b=%.6g (eps=%.3g)\n", da, db, eps);
+
+    llama_free(ctx);
+    llama_model_free(model);
+
+    if (da > eps || db > eps) {
+        fprintf(stderr, "FAIL: MultiDecode logits diverge from linear baselines\n");
+        return 1;
+    }
+    fprintf(stderr, "PASS: MultiDecode leaf logits match linear prefills\n");
+    return 0;
+}
