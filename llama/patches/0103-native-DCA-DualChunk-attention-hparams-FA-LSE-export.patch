-static bool ane_metal_draft_hidden_for_leg(
-        llama_context * ctx_dft, int32_t i_batch, bool post_output_norm, std::vector<float> & h) {
-    if (!ctx_dft || i_batch < 0) {
-        return false;
-    }
-    const llama_model * model = llama_get_model(ctx_dft);
-    const int n_embd = llama_model_n_embd(model);
-    if (n_embd <= 0) {
-        return false;
-    }
-    h.assign((size_t) n_embd, 0.f);
-    const bool dflash_post = ane_dflash_t_embd_is_post_output_norm(model);
-    const float * metal = llama_get_embeddings_ith(ctx_dft, i_batch);
-    const float * pre   = llama_get_embeddings_pre_norm_ith(ctx_dft, i_batch);
-
-    if (!post_output_norm) {
-        if (pre) {
-            for (int i = 0; i < n_embd; ++i) {
-                h[(size_t) i] = pre[i];
-            }
-            return true;
-        }
-        if (metal && !dflash_post) {
-            for (int i = 0; i < n_embd; ++i) {
-                h[(size_t) i] = metal[i];
-            }
-            return true;
-        }
-        return false;
-    }
-
-    if (dflash_post && metal) {
-        for (int i = 0; i < n_embd; ++i) {
-            h[(size_t) i] = metal[i];
-        }
-        return true;
-    }
-    if (metal) {
-        for (int i = 0; i < n_embd; ++i) {
-            h[(size_t) i] = metal[i];
-        }
-        ane_apply_output_norm_file(h);
-        return true;
-    }
-    if (pre) {
-        for (int i = 0; i < n_embd; ++i) {
-            h[(size_t) i] = pre[i];
-        }
-        ane_apply_output_norm_file(h);
-        return true;
-    }
-    return false;
-}
