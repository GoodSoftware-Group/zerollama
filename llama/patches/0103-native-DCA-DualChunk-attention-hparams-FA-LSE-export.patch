-            g.n_heads_kv = llama_model_n_head_kv(model);
-        }
-        if (g.head_dim <= 0 && g.n_heads_kv > 0 && oc > 0 && oc % g.n_heads_kv == 0) {
-            g.head_dim = oc / g.n_heads_kv;
-        }
-    }
-    if (g.n_heads_kv <= 0 || g.head_dim <= 0 || g.n_heads_kv * g.head_dim != oc) {
-        g.n_heads_kv = 1;
