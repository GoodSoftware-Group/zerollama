-// P39: shared host fp32 replay for draft layers 1..n-1 (ref + runtime).
-static bool ane_dflash_apply_host_layer_tail(
-        llama_context * ctx_dft,
-        std::vector<float> & h,
-        int oc_q, int oc_kv, int oc_ff,
-        bool log_bisect) {
