-        note = "cross";
-    } else {
-        log_ane_metal_golden_leg(step, "handoff_input", 0.f, pack_len, "no_metal_row");
-        return;
-    }
-    const float cos = ane_vec_cosine(metal_row.data(), packed, pack_len);
-    log_ane_metal_golden_leg(step, "handoff_input", cos, pack_len, note);
-}
