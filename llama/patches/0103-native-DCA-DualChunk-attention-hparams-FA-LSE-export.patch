-static void matmul_golden_reference_t(const float * input, int ic, int oc,
-                                      const std::vector<float> & W, bool w_transposed,
-                                      std::vector<float> & ref) {
-    ref.assign((size_t) oc, 0.f);
-    if (!input || (int) W.size() < ic * oc) {
-        return;
-    }
-    for (int o = 0; o < oc; ++o) {
-        double sum = 0.0;
-        for (int i = 0; i < ic; ++i) {
