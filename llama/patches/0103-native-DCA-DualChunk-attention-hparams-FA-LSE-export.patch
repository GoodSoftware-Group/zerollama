-        const std::string name = std::string("MTL") + std::to_string(i);
-        if (ggml_backend_dev_t dev = ggml_backend_dev_by_name(name.c_str())) {
-            return dev;
-        }
-    }
-    return ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
-}
