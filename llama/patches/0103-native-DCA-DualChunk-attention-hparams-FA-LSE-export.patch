-                ? (size_t) o * (size_t) ic + (size_t) i
-                : (size_t) i * (size_t) oc + (size_t) o;
-            sum += (double) input[i] * (double) W[idx];
-        }
-        ref[(size_t) o] = (float) sum;
-    }
