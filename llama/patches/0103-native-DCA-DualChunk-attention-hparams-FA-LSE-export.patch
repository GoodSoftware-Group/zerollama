-static void ane_softmax_inplace(std::vector<float> & scores) {
-    if (scores.empty()) {
-        return;
-    }
-    float maxv = scores[0];
-    for (float s : scores) {
-        if (s > maxv) {
-            maxv = s;
-        }
-    }
-    double sum = 0.0;
-    for (float & s : scores) {
-        s = std::exp((double) s - (double) maxv);
-        sum += s;
-    }
-    if (sum <= 0.0) {
-        const float u = 1.f / (float) scores.size();
-        for (float & s : scores) {
-            s = u;
-        }
-        return;
-    }
-    for (float & s : scores) {
-        s = (float) ((double) s / sum);
-    }
-}
