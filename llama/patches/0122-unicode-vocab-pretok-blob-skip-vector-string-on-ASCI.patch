+
+// WHY (0119): ASCII custom pretok can emit words as contiguous storage + lens instead of
+// ~370k std::string/MiB. BPE session walks (ptr,len); pointers must outlive tokenize().
+// Opt-out: LLAMA_BPE_NO_PRETOK_BLOB=1 (same binary A/B).
+struct unicode_pretok_blob {
+    std::string storage;
+    std::vector<size_t> lens;
+    bool use_storage = false;
+
+    const char * base(const std::string & text) const {
+        return use_storage ? storage.data() : text.data();
+    }
+};
