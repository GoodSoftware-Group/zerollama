+    unicode_fill_blob_from_byte_offsets(text, bpe_offsets, byte_encode, blob);
+    std::vector<std::string> bpe_words;
+    bpe_words.reserve(blob.lens.size());
+    const char * p = blob.base(text);
+    size_t off = 0;
