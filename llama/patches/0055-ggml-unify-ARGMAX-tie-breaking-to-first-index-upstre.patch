From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Odilitime <janesmith@airmail.cc>
Date: Sun, 12 Jul 2026 14:34:39 -0700
Subject: [PATCH] ggml: unify ARGMAX tie-breaking to first index (upstream
 #25032)

Metal simd reduction and CPU vec_argmax now keep the smallest index on
ties to match torch/numpy and other backends.
---
 ggml/src/ggml-cpu/vec.h              | 7 +++++--
 ggml/src/ggml-metal/ggml-metal.metal | 6 ++++--
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cpu/vec.h b/ggml/src/ggml-cpu/vec.h
index 5de9cb5b7..adb96d78e 100644
--- a/ggml/src/ggml-cpu/vec.h
+++ b/ggml/src/ggml-cpu/vec.h
@@ -1559,8 +1559,11 @@ inline static void ggml_vec_argmax_f32(const int n, int * s, const float * x) {
     float max = -INFINITY;
     int idx = 0;
     for (int i = 0; i < n; ++i) {
-        max = MAX(max, x[i]);
-        if (max == x[i]) { idx = i; }
+        // first index wins on ties (torch.argmax / np.argmax convention)
+        if (x[i] > max) {
+            max = x[i];
+            idx = i;
+        }
     }
     *s = idx;
 }
diff --git a/ggml/src/ggml-metal/ggml-metal.metal b/ggml/src/ggml-metal/ggml-metal.metal
index 25e4fd6ca..d762c36c1 100644
--- a/ggml/src/ggml-metal/ggml-metal.metal
+++ b/ggml/src/ggml-metal/ggml-metal.metal
@@ -3241,7 +3241,9 @@ kernel void kernel_argmax_f32(
 
     // find the argmax value in the block
     float max_val = simd_max(lmax);
-    int32_t arg_val = simd_max(select(-1, larg, lmax == max_val));
+    // keep the smallest index on ties: non-max threads get a sentinel so simd_min ignores them
+    constexpr int32_t ARGMAX_SENTINEL = numeric_limits<int32_t>::max();
+    int32_t arg_val = simd_min(select(ARGMAX_SENTINEL, larg, lmax == max_val));
 
     device int32_t * dst_i32 = (device int32_t *) dst;
 
@@ -3267,7 +3269,7 @@ kernel void kernel_argmax_f32(
         arg_val = shared_argmax[tiisg];
 
         float max_val_reduced   = simd_max(max_val);
-        int32_t arg_val_reduced = simd_max(select(-1, arg_val, max_val == max_val_reduced));
+        int32_t arg_val_reduced = simd_min(select(ARGMAX_SENTINEL, arg_val, max_val == max_val_reduced));
 
         dst_i32[tgpig] = arg_val_reduced;
 
