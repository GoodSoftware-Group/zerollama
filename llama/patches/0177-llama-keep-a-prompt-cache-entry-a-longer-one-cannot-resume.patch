 tools/server/server-slot-sched.cpp |  28 ++++++--
 tools/server/server-slot-sched.h   |   4 ++
 tools/server/server-warm-cover.h   | 105 +++++++++++++++++++++++++++++
 tools/server/server-warm-disk.h    |  94 +++++++++++++++++++++++---
 5 files changed, 226 insertions(+), 14 deletions(-)
 create mode 100644 tools/server/server-warm-cover.h

