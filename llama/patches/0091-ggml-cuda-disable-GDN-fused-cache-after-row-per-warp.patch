From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 17 Jul 2026 13:25:51 -0700
Subject: [PATCH] ggml-cuda: disable GDN fused-cache after row-per-warp kernel

Patch 0084 removed ggml_cuda_op_gated_delta_net_fused_cache but left the
fusion detector/call site, breaking llama-server link. Disable fusion and
add a stub for the declared symbol.
---
 ggml/src/ggml-cuda/gated_delta_net.cu | 15 +++++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu       |  8 ++++++++
 2 files changed, 23 insertions(+)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu
index 8a7bdb3bb..89951710f 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu
@@ -233,6 +233,14 @@ static void launch_gated_delta_net(const float * q_d,
     }
 }
 
+void ggml_cuda_op_gated_delta_net_fused_cache(
+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_cuda_gated_delta_net_fused_cache cache) {
+    // Stub for link compatibility with ggml-cuda.cu fusion detector. Fusion is disabled
+    // (try_gdn_cache_fusion returns 0) because the row-per-warp kernel dropped cache writes.
+    GGML_UNUSED(cache);
+    ggml_cuda_op_gated_delta_net(ctx, dst);
+}
+
 void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     ggml_tensor * src_q     = dst->src[0];
     ggml_tensor * src_k     = dst->src[1];
@@ -306,3 +314,10 @@ void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor *
                                       sv2, sv3, sb1, sb2, sb3, neqk1, rq3, scale, stream);
     }
 }
+
+// Stub: patch 0084 removed the fused-cache kernel; fusion matcher is disabled above.
+void ggml_cuda_op_gated_delta_net_fused_cache(
+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_cuda_gated_delta_net_fused_cache cache) {
+    GGML_UNUSED(cache);
+    ggml_cuda_op_gated_delta_net(ctx, dst);
+}
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 7368a0515..8bc0cb24f 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2694,6 +2694,13 @@ static bool ggml_cuda_should_fuse_rope_set_rows(const ggml_tensor * rope,
 // (slot i -> rollback group i, slot 0 newest), so the kernel can write them and skip the cpy.
 static int ggml_cuda_try_gdn_cache_fusion(
         const ggml_cgraph * cgraph, int node_idx, ggml_cuda_gated_delta_net_fused_cache & fused_state_cpy) {
+    // WHY disabled: patch 0084 rewrote GDN kernels and removed ggml_cuda_op_gated_delta_net_fused_cache
+    // implementation; matching here would skip cpy nodes without writing the fused cache.
+    (void) cgraph;
+    (void) node_idx;
+    (void) fused_state_cpy;
+    return 0;
+#if 0
     const ggml_tensor * gdn = cgraph->nodes[node_idx];
     // the kernel skips the snapshot tail, so the gdn output must not be a graph output
     if (gdn->op != GGML_OP_GATED_DELTA_NET || gdn->type != GGML_TYPE_F32 ||
@@ -2752,6 +2759,7 @@ static int ggml_cuda_try_gdn_cache_fusion(
     fused_state_cpy.data        = (float *) dst->data; // rollback group 0 (newest)
     fused_state_cpy.slot_stride = K > 1 ? (int64_t) (dst->nb[2] / sizeof(float)) : 0;
     return skip;
+#endif
 }
 
 static bool ggml_cuda_topk_moe_fusion(const struct ggml_cgraph * cgraph, int node_idx, ggml_cuda_topk_moe_args & args) {
