From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 10 Jul 2026 23:00:03 -0700
Subject: [PATCH] ggml-metal: fuse RMS_NORM+MUL+SWIGLU for Qwen3-Next (upstream
 #16143)

Rebased onto current get_pipeline_norm / float4 rms kernels: n_fuse=4
selects mul_swiglu pipelines; returns 3 so the encoder skips glu.
---
 ggml/src/ggml-metal/ggml-metal-device.cpp |  1 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp    | 49 ++++++++++++++++++++---
 ggml/src/ggml-metal/ggml-metal.metal      | 10 +++++
 3 files changed, 54 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index ac8bf477..aeaa929d 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -1713,6 +1713,7 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_norm(ggml_metal_
                 case 1: snprintf(base, 256, "kernel_rms_norm_f32%s", suffix);         break;
                 case 2: snprintf(base, 256, "kernel_rms_norm_mul_f32%s", suffix);     break;
                 case 3: snprintf(base, 256, "kernel_rms_norm_mul_add_f32%s", suffix); break;
+                case 4: snprintf(base, 256, "kernel_rms_norm_mul_swiglu_f32%s", suffix); break;
                 default: GGML_ABORT("fatal error");
             } break;
         default: GGML_ABORT("fatal error");
diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index c3d25f91..70effdce 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -3476,11 +3476,11 @@ int ggml_metal_op_norm(ggml_metal_op_t ctx, int idx) {
 
     int n_fuse = 1;
 
-    ggml_metal_buffer_id bid_fuse[2] = { bid_src0, bid_src0 };
+    ggml_metal_buffer_id bid_fuse[3] = { bid_src0, bid_src0, bid_src0 };
 
     // d[0] = norm(a)
     // d[1] = mul(d[0], b)
-    // d[2] = add(d[1], c)
+    // d[2] = add(d[1], c)  OR  swiglu_split(gate, d[1])  (RMS_NORM only; n_fuse=4)
     if (use_fusion) {
         fops[0] = op->op;
         fops[1] = GGML_OP_MUL;
@@ -3525,6 +3525,31 @@ int ggml_metal_op_norm(ggml_metal_op_t ctx, int idx) {
 
         ++n_fuse;
 
+        // Qwen3-Next gated RMS: RMS_NORM + MUL + SWIGLU_SPLIT (upstream #16143)
+        // Prefer over ADD when only MUL fused so far.
+        if (op->op == GGML_OP_RMS_NORM && n_fuse == 2 && idx + 2 < ctx->n_nodes()) {
+            ggml_op glu_ops[2] = { GGML_OP_MUL, GGML_OP_GLU };
+            if (ctx->can_fuse(idx + 1, glu_ops, 2)) {
+                ggml_tensor * mul = ctx->node(idx + 1);
+                ggml_tensor * glu = ctx->node(idx + 2);
+                if (mul == glu->src[1] &&
+                    glu->src[0] &&
+                    glu->src[0]->ne[0] == op->ne[0] &&
+                    ggml_is_contiguous_rows(glu->src[0]) &&
+                    ggml_get_glu_op(glu) == GGML_GLU_OP_SWIGLU &&
+                    glu->src[0]->type == GGML_TYPE_F32) {
+                    bid_fuse[2] = ggml_metal_get_buffer_id(glu->src[0]);
+                    args.nef1[2] = glu->src[0]->ne[1];
+                    args.nef2[2] = glu->src[0]->ne[2];
+                    args.nef3[2] = glu->src[0]->ne[3];
+                    args.nbf1[2] = glu->src[0]->nb[1];
+                    args.nbf2[2] = glu->src[0]->nb[2];
+                    args.nbf3[2] = glu->src[0]->nb[3];
+                    n_fuse = 4;
+                }
+            }
+        }
+
         if (debug_fusion > 1 && n_fuse > 1) {
             if (n_fuse == 2) {
                 GGML_LOG_DEBUG("%s: fuse: %s + MUL\n", __func__, ggml_op_name(op->op));
@@ -3532,13 +3557,18 @@ int ggml_metal_op_norm(ggml_metal_op_t ctx, int idx) {
             if (n_fuse == 3) {
                 GGML_LOG_DEBUG("%s: fuse: %s + MUL + ADD\n", __func__, ggml_op_name(op->op));
             }
+            if (n_fuse == 4) {
+                GGML_LOG_DEBUG("%s: fuse: %s + MUL + SWIGLU\n", __func__, ggml_op_name(op->op));
+            }
         }
     }
 
     if (n_fuse > 1) {
-        bid_dst = ggml_metal_get_buffer_id(ctx->node(idx + n_fuse - 1));
+        // n_fuse==4 skips 3 ops (rms, mul, glu) → last node at idx+2
+        const int last = (n_fuse == 4) ? 2 : (n_fuse - 1);
+        bid_dst = ggml_metal_get_buffer_id(ctx->node(idx + last));
 
-        for (int i = 1; i < n_fuse; ++i) {
+        for (int i = 1; i <= last; ++i) {
             if (!ggml_metal_op_concurrency_check(ctx, ctx->node(idx + i))) {
                 ggml_metal_op_concurrency_reset(ctx);
 
@@ -3565,13 +3595,20 @@ int ggml_metal_op_norm(ggml_metal_op_t ctx, int idx) {
     ggml_metal_encoder_set_buffer  (enc, bid_src0,    1);
     ggml_metal_encoder_set_buffer  (enc, bid_fuse[0], 2);
     ggml_metal_encoder_set_buffer  (enc, bid_fuse[1], 3);
-    ggml_metal_encoder_set_buffer  (enc, bid_dst,     4);
+    // RMS kernels always take src1_2 (gate / unused); NORM keeps the 4-buffer ABI.
+    if (op->op == GGML_OP_RMS_NORM) {
+        ggml_metal_encoder_set_buffer  (enc, bid_fuse[2], 4);
+        ggml_metal_encoder_set_buffer  (enc, bid_dst,     5);
+    } else {
+        ggml_metal_encoder_set_buffer  (enc, bid_dst,     4);
+    }
 
     ggml_metal_encoder_set_threadgroup_memory_size(enc, smem, 0);
 
     ggml_metal_encoder_dispatch_threadgroups(enc, ne01, ne02, ne03, nth, 1, 1);
 
-    return n_fuse;
+    // Caller advances by return value; for SWIGLU fuse skip rms+mul+glu (3 nodes).
+    return n_fuse == 4 ? 3 : n_fuse;
 }
 
 int ggml_metal_op_rope(ggml_metal_op_t ctx, int idx) {
diff --git a/ggml/src/ggml-metal/ggml-metal.metal b/ggml/src/ggml-metal/ggml-metal.metal
index 1bb5f250..ac91de67 100644
--- a/ggml/src/ggml-metal/ggml-metal.metal
+++ b/ggml/src/ggml-metal/ggml-metal.metal
@@ -3191,12 +3191,14 @@ template [[host_name("kernel_norm_mul_add_f32_4")]] kernel kernel_norm_fuse_t ke
 // F == 1 : rms_norm (no fuse)
 // F == 2 : rms_norm + mul
 // F == 3 : rms_norm + mul + add
+// F == 4 : rms_norm + mul + swiglu (Qwen3-Next gated RMS; upstream #16143)
 template <typename T, short F>
 kernel void kernel_rms_norm_fuse_impl(
         constant ggml_metal_kargs_norm & args,
         device const char * src0,
         device const char * src1_0,
         device const char * src1_1,
+        device const char * src1_2,
         device       char * dst,
         threadgroup float * shmem_f32 [[threadgroup(0)]],
         uint3   tgpig[[threadgroup_position_in_grid]],
@@ -3216,6 +3218,8 @@ kernel void kernel_rms_norm_fuse_impl(
 
     device const T * f0 = (device const T *) (src1_0 + (i03%args.nef3[1])*args.nbf3[1] + (i02%args.nef2[1])*args.nbf2[1] + (i01%args.nef1[1])*args.nbf1[1]);
     device const T * f1 = (device const T *) (src1_1 + (i03%args.nef3[2])*args.nbf3[2] + (i02%args.nef2[2])*args.nbf2[2] + (i01%args.nef1[2])*args.nbf1[2]);
+    // F==4 reuses f1 slot indexing via src1_2 (gate); f1 pointer above unused for F==4
+    device const T * gate = (device const T *) (src1_2 + (i03%args.nef3[2])*args.nbf3[2] + (i02%args.nef2[2])*args.nbf2[2] + (i01%args.nef1[2])*args.nbf1[2]);
 
     float sumf = 0.0f;
 
@@ -3250,6 +3254,10 @@ kernel void kernel_rms_norm_fuse_impl(
         if (F == 3) {
             y[i00] = (x[i00]*scale)*f0[i00] + f1[i00];
         }
+        if (F == 4) {
+            T g = gate[i00];
+            y[i00] = (x[i00]*scale)*f0[i00] * (g / (T(1.0f) + exp(-g)));
+        }
     }
 }
 
@@ -3258,10 +3266,12 @@ typedef decltype(kernel_rms_norm_fuse_impl<float4, 1>) kernel_rms_norm_fuse_t;
 template [[host_name("kernel_rms_norm_f32")]]         kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float, 1>;
 template [[host_name("kernel_rms_norm_mul_f32")]]     kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float, 2>;
 template [[host_name("kernel_rms_norm_mul_add_f32")]] kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float, 3>;
+template [[host_name("kernel_rms_norm_mul_swiglu_f32")]] kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float, 4>;
 
 template [[host_name("kernel_rms_norm_f32_4")]]         kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float4, 1>;
 template [[host_name("kernel_rms_norm_mul_f32_4")]]     kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float4, 2>;
 template [[host_name("kernel_rms_norm_mul_add_f32_4")]] kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float4, 3>;
+template [[host_name("kernel_rms_norm_mul_swiglu_f32_4")]] kernel kernel_rms_norm_fuse_t kernel_rms_norm_fuse_impl<float4, 4>;
 
 template <typename T0, typename T>
 kernel void kernel_l2_norm_impl(
