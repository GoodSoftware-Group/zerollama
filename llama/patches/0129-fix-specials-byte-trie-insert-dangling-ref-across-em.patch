From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama-vendor <zerollama@local>
Date: Tue, 4 Aug 2026 00:00:00 -0700
Subject: [PATCH] fix: specials byte-trie insert dangling ref across
 emplace_back
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Holding uint32_t& into nodes[].child across vector::emplace_back is UB when
growth reallocates. LFM2-MoE (~1.6k [PAD*] specials) hit this during vocab
load → SIGSEGV in llm_specials_byte_trie::insert (worse under CUDA heap
pressure). Write the child index after emplace using indices only.
---
 src/llama-vocab.cpp | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/llama-vocab.cpp b/src/llama-vocab.cpp
index e88971c47..82e4d5dae 100644
--- a/src/llama-vocab.cpp
+++ b/src/llama-vocab.cpp
@@ -100,12 +100,16 @@ struct llm_specials_byte_trie {
         uint32_t cur = 0;
         for (size_t i = 0; i < len; ++i) {
             const unsigned char c = (unsigned char) key[i];
-            uint32_t & slot = nodes[cur].child[c];
-            if (slot == npos) {
-                slot = (uint32_t) nodes.size();
+            // WHY: never hold a reference into nodes across emplace_back — growth
+            // reallocates and leaves a dangling child slot (SIGSEGV on large
+            // specials sets, e.g. LFM2 [PAD*] vocab during CUDA-backed loads).
+            uint32_t next = nodes[cur].child[c];
+            if (next == npos) {
+                next = (uint32_t) nodes.size();
                 nodes.emplace_back();
+                nodes[cur].child[c] = next;
             }
-            cur = slot;
+            cur = next;
         }
         nodes[cur].has_value = true;
         nodes[cur].value = id;
