From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Wed, 21 Oct 2026 15:45:00 -0700
Subject: [PATCH] server: DI3 expose verified accept_by_pos on timings + slots

WHY: adaptive-dm already used per-pos EWMA inside decide_profit_n_max; lab
A/B needed the curve on the wire (timings = per-request counts; slots =
controller EWMA). Not a DSpark confidence head; no production default flip.
Lab opt-in via --spec-dm-adaptive profit / ZEROLLAMA_SPEC_DM_ADAPTIVE.
---
 tools/server/server-adaptive-dm.h | 16 +
 tools/server/server-common.cpp    | 10 +
 tools/server/server-common.h      |  6 +-
 tools/server/server-context.cpp   | 40 +-
 tools/server/unit/common.h        |  3 +
 tools/server/unit/di3_adaptive_dm_stubs.h | 44 +
 tools/server/unit/log.h           |  6 +
 tools/server/unit/test-di3-accept-by-pos.cpp | 60 +
 8 files changed

diff --git a/tools/server/server-adaptive-dm.h b/tools/server/server-adaptive-dm.h
index 55e741f0..52d21688 100644
--- a/tools/server/server-adaptive-dm.h
+++ b/tools/server/server-adaptive-dm.h
@@ -1168,6 +1168,22 @@ struct server_adaptive_dm_state {
         }
     }
 
+    // DI3: export verified per-position EWMA (ex-post accept, not a confidence head).
+    // Returns number of positions with samples > 0 written into out[].
+    int export_verified_accept_by_pos(float * out, int out_cap) const {
+        if (!out || out_cap <= 0) {
+            return 0;
+        }
+        int n = 0;
+        for (int pos = 0; pos < PROFIT_POSITIONS && n < out_cap; ++pos) {
+            if (profit_pos_samples[pos] <= 0) {
+                break;
+            }
+            out[n++] = std::clamp(profit_pos_accept_ewma[pos], 0.0f, 1.0f);
+        }
+        return n;
+    }
+
     void observe_profit_timing(
             int requested_n_max,
             int actual_n_draft,
diff --git a/tools/server/server-common.cpp b/tools/server/server-common.cpp
index 6aa1dcdd..5aae3bad 100644
--- a/tools/server/server-common.cpp
+++ b/tools/server/server-common.cpp
@@ -99,6 +99,16 @@ json server_slot_stats::to_json() const {
     if (n_draft_tokens > 0) {
         base["draft_n"]          = n_draft_tokens;
         base["draft_n_accepted"] = n_draft_accepted;
+        base["accept_rate"]      = (double) n_draft_accepted / (double) n_draft_tokens;
+        if (n_draft_verif_steps > 0 && !n_accepted_per_pos.empty()) {
+            json rates = json::array();
+            for (uint64_t accepted : n_accepted_per_pos) {
+                rates.push_back((double) accepted / (double) n_draft_verif_steps);
+            }
+            // DI3: verified empirical per-depth accept (not predicted confidence).
+            base["accept_by_pos"]      = rates;
+            base["accept_by_pos_kind"] = "verified";
+        }
     }
 
     return base;
