From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nobody <>
Date: Thu, 15 Oct 2026 16:14:58 +1000
Subject: [PATCH] fix: compile TBQ fattn-vec instances for HIP

ggml-cuda/CMakeLists.txt appends template-instances/fattn-vec*tbq*.cu because
the TBQ KV types are outside ggml_cuda_fattn_vec_instances' FA_TYPES; ggml-hip
did not, so libggml-hip.so failed to load with an undefined
ggml_cuda_flash_attn_ext_vec_case<64, TBQ3_0, TBQ3_0>. Found on gfx1100.
---
 ggml/src/ggml-hip/CMakeLists.txt | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/ggml/src/ggml-hip/CMakeLists.txt b/ggml/src/ggml-hip/CMakeLists.txt
index a6a6b7271..48268dc62 100644
--- a/ggml/src/ggml-hip/CMakeLists.txt
+++ b/ggml/src/ggml-hip/CMakeLists.txt
@@ -72,6 +72,10 @@ list(APPEND GGML_SOURCES_ROCM ${SRCS})
 
 ggml_cuda_fattn_vec_instances(${CMAKE_CURRENT_SOURCE_DIR}/../ggml-cuda SRCS)
 list(APPEND GGML_SOURCES_ROCM ${SRCS})
+# zerollama: TBQ fattn-vec instances (not in ggml_cuda_fattn_vec_instances FA_TYPES),
+# same as ggml-cuda/CMakeLists.txt — fattn dispatch references them on HIP too.
+file(GLOB SRCS_TBQ "../ggml-cuda/template-instances/fattn-vec*tbq*.cu")
+list(APPEND GGML_SOURCES_ROCM ${SRCS_TBQ})
 
 ggml_add_backend_library(ggml-hip
                          ${GGML_HEADERS_ROCM}
-- 
