diff --git a/conversion/base.py b/conversion/base.py
index 87d891f9..1d9f42d2 100644
--- a/conversion/base.py
+++ b/conversion/base.py
@@ -443,15 +443,15 @@ class ModelBase:
                         weight_name = name.removesuffix("_scale_inv")
                         w = self.model_tensors[weight_name]
                         s = self.model_tensors[name]
-                        is_fp8_e4m3 = False
+                        is_native_fp8 = False
                         try:
-                            is_fp8_e4m3 = w().dtype == torch.float8_e4m3fn
+                            is_native_fp8 = w().dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
                         except Exception:
-                            is_fp8_e4m3 = False
+                            is_native_fp8 = False
                         # Native: scalar/1D scales, or block maps whose last dim is a multiple of 32
                         # (e.g. weight_block_size=[128,128] → one GGML d per 32 cols inside each tile).
                         can_native = False
-                        if self._fp8_native and is_fp8_e4m3:
+                        if self._fp8_native and is_native_fp8:
                             if block_size is None:
                                 can_native = True
                             else:
@@ -466,7 +466,7 @@ class ModelBase:
                             )
                             tensors_to_remove.append(name)
                         else:
-                            if self._fp8_native and is_fp8_e4m3 and block_size is not None:
+                            if self._fp8_native and is_native_fp8 and block_size is not None:
                                 logger.warning(
                                     f"{weight_name}: FP8 weight_block_size={block_size} not supported "
                                     "by --fp8-native (need block_size[-1] % 32 == 0); falling back to dequant"
@@ -584,12 +584,12 @@ class ModelBase:
                             continue
                         w = self.model_tensors[weight_name]
                         s = self.model_tensors[name]
-                        is_fp8_e4m3 = False
+                        is_native_fp8 = False
                         try:
-                            is_fp8_e4m3 = w().dtype == torch.float8_e4m3fn
+                            is_native_fp8 = w().dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
                         except Exception:
-                            is_fp8_e4m3 = False
-                        if self._fp8_native and is_fp8_e4m3:
+                            is_native_fp8 = False
+                        if self._fp8_native and is_native_fp8:
                             # Keep E4M3 bytes; absorb per-tensor/per-row scale at pack time.
                             self._fp8_native_tensors.add(weight_name)
                             self._fp8_native_scales[weight_name] = s
@@ -697,22 +697,24 @@ class ModelBase:
         return False
 
     def _pack_fp8_native_tensor(self, name: str, data_torch: Tensor) -> np.ndarray:
-        """Pack float8_e4m3fn weights + stored scale into GGML FP8_E4M3 blocks (no full dequant)."""
+        """Pack float8_e4m3fn/e5m2 weights + stored scale into native GGML FP8 blocks."""
         scale_t = LazyTorchTensor.to_eager(self._fp8_native_scales[name]())
         scale = scale_t.detach().float().cpu().numpy()
         qs = data_torch.view(torch.uint8).cpu().numpy()
         if qs.ndim == 1:
             qs = qs.reshape(1, -1)
+        quant_cls = gguf.quants.FP8_E5M2 if data_torch.dtype == torch.float8_e5m2 else gguf.quants.FP8_E4M3
+        pack = quant_cls.pack_e5m2_with_scale if data_torch.dtype == torch.float8_e5m2 else quant_cls.pack_e4m3_with_scale
         block_size = self._fp8_native_block_sizes.get(name)
         if block_size is not None:
             if qs.ndim != 2:
                 raise ValueError(
                     f"{name}: --fp8-native block_size={block_size} expects 2D weight, got shape {qs.shape}"
                 )
-            block_scales = gguf.quants.FP8_E4M3.expand_block_scales_to_ggml(
+            block_scales = quant_cls.expand_block_scales_to_ggml(
                 scale, (qs.shape[0], qs.shape[1]), block_size
             )
-            return gguf.quants.FP8_E4M3.pack_e4m3_with_scale(qs, block_scales)
+            return pack(qs, block_scales)
         # Per-row scale: (out_features,) or (out_features, 1); else scalar / broadcast.
         if scale.ndim >= 1 and scale.size == qs.shape[0]:
             scale_arg = scale.reshape(qs.shape[0])
@@ -723,7 +725,7 @@ class ModelBase:
                 f"{name}: unsupported FP8 scale shape {scale.shape} for --fp8-native "
                 f"(want scalar, per-row matching {qs.shape[0]}, or block map)"
             )
-        return gguf.quants.FP8_E4M3.pack_e4m3_with_scale(qs, scale_arg)
+        return pack(qs, scale_arg)
 
     # some models need extra generated tensors (like rope_freqs)
     def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:
@@ -946,10 +948,10 @@ class ModelBase:
 
             old_dtype = data_torch.dtype
 
-            # Native FP8: pack E4M3 bytes + scale into GGML_TYPE_FP8_E4M3 without expanding to F16/F32.
+            # Native FP8: pack E4M3/E5M2 bytes + scale without expanding to F16/F32.
             if name in self._fp8_native_tensors:
-                if data_torch.dtype != torch.float8_e4m3fn:
-                    raise ValueError(f"{name}: --fp8-native expected float8_e4m3fn, got {data_torch.dtype}")
+                if data_torch.dtype not in (torch.float8_e4m3fn, torch.float8_e5m2):
+                    raise ValueError(f"{name}: --fp8-native expected float8_e4m3fn/e5m2, got {data_torch.dtype}")
                 bid = None
                 for part in name.split("."):
                     if part.isdecimal():
@@ -964,8 +966,13 @@ class ModelBase:
                         logger.info(f"{new_name}, {old_dtype} --> F32 (1d/norm), shape = {data.shape}")
                         continue
                     packed = self._pack_fp8_native_tensor(name, data_torch)
-                    logger.info(f"{new_name}, {old_dtype} --> FP8_E4M3 (native), shape = {list(data_torch.shape)}")
-                    self.gguf_writer.add_tensor(new_name, packed, raw_dtype=gguf.GGMLQuantizationType.FP8_E4M3)
+                    raw_dtype = (
+                        gguf.GGMLQuantizationType.FP8_E5M2
+                        if data_torch.dtype == torch.float8_e5m2
+                        else gguf.GGMLQuantizationType.FP8_E4M3
+                    )
+                    logger.info(f"{new_name}, {old_dtype} --> {raw_dtype.name} (native), shape = {list(data_torch.shape)}")
+                    self.gguf_writer.add_tensor(new_name, packed, raw_dtype=raw_dtype)
                 continue
 
             # convert any unsupported data types to float32
