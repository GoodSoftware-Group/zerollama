+class FP8_E5M2(FP8_E4M3, qtype=GGMLQuantizationType.FP8_E5M2):
+    """Block FP8 E5M2: F16 scale + 32× IEEE float8_e5m2 (34 B / 32 elems)."""
+
+    @staticmethod
+    def e5m2_to_fp32(x: np.ndarray) -> np.ndarray:
+        x = x.astype(np.uint8)
+        sign = (x >> 7) & 1
+        exp = (x >> 2) & 0x1F
+        man = (x & 0x3).astype(np.float32)
+        special = exp == 0x1F
+        inf = special & (man == 0)
+        nan = special & (man != 0)
+        sub = exp == 0
+        raw = np.where(sub, man * (2.0 ** -16),
+                       (1.0 + man / 4.0) * (2.0 ** (exp.astype(np.float32) - 15.0)))
+        raw = np.where(inf, np.inf, np.where(nan | ((exp == 0) & (man == 0)), 0.0, raw))
+        return np.where(sign.astype(bool), -raw, raw)
+
+    @staticmethod
+    def fp32_to_e5m2(x: np.ndarray) -> np.ndarray:
+        x = np.asarray(x, dtype=np.float32)
+        sign = np.signbit(x).astype(np.uint8) << 7
+        ax = np.abs(x)
+        ax = np.where(np.isfinite(ax), np.minimum(ax, 57344.0), 57344.0)
+        bits = ax.view(np.uint32)
+        fp32_exp = ((bits >> 23) & 0xFF).astype(np.int32) - 127
+        fp32_man = ((bits >> 21) & 0x3).astype(np.int32)
+        round_bit = ((bits >> 20) & 1).astype(np.int32)
+        e5 = fp32_exp + 15
