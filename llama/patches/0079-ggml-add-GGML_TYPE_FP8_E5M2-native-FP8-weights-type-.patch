+static __device__ __forceinline__ int pack_fp8_e5m2_qs_as_q8(const block_fp8_e5m2 * bxi, const int kqs) {
+    float amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < QK_FP8_E5M2; ++j) {
+        amax = fmaxf(amax, fabsf(ggml_cuda_fp8_e5m2_to_fp32(bxi->qs[j])));
+    }
+    const float mul = amax > 0.0f ? 127.0f / amax : 0.0f;
+    int packed = 0;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const float f = ggml_cuda_fp8_e5m2_to_fp32(bxi->qs[4*kqs + j]) * mul;
+        int q = __float2int_rn(f);
+        q = q > 127 ? 127 : (q < -127 ? -127 : q);
+        packed |= (q & 0xFF) << (8*j);
+    }
+    return packed;
+}
+
+static __device__ __forceinline__ float fp8_e5m2_block_d_as_q8(const block_fp8_e5m2 * bxi) {
+    float amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < QK_FP8_E5M2; ++j) {
+        amax = fmaxf(amax, fabsf(ggml_cuda_fp8_e5m2_to_fp32(bxi->qs[j])));
+    }
+    return __half2float(bxi->d) * (amax / 127.0f);
+}
