+#define QK_FP8_E5M2 32
+typedef struct {
+    ggml_half d;                     // block scale (F16)
+    uint8_t   qs[QK_FP8_E5M2];       // IEEE float8_e5m2 bit patterns
+} block_fp8_e5m2;
+static_assert(sizeof(block_fp8_e5m2) == sizeof(ggml_half) + QK_FP8_E5M2, "wrong fp8_e5m2 block size/padding");
+
 #define QK5_0 32
 typedef struct {
     ggml_half d;           // delta
