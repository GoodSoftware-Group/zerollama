From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 10 Jul 2026 04:42:29 -0700
Subject: [PATCH] ollama: wire fused QJL-K attention + CUDA SET_ROWS for
 QJL/Polar
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Wire the CUDA dispatch paths that depend on the types and kernels
added in 0026-0028:

1. ggml-cuda.cu: include fused-attn.cuh, add compute_forward cases for
   GGML_OP_FUSED_ATTN_QJL_TBQ and GGML_OP_ATTN_SCORE_QJL (gated by
   GGML_CUDA_FUSED_ATTN_QJL), add supports_op entries.

2. set-rows.cu: include qjl-set-rows.cuh / polar-set-rows.cuh, add
   SET_ROWS cases for GGML_TYPE_QJL1_256 (gated GGML_CUDA_QJL) and
   GGML_TYPE_Q4_POLAR (gated GGML_CUDA_POLARQUANT). This enables
   on-the-fly quantize-on-write when the KV cache is in QJL/Polar format.

3. llama-graph.cpp (build_attn_mha): add fused QJL-K + TBQ/Polar-V
   attention path that uses ggml_fused_attn_qjl_tbq() when K is
   QJL1_256 and V is Q4_POLAR or TBQ3_0, with causal-decoder flag set.
   Falls back to dequantize→F16→flash-attn for other exotic cache types
   or when conditions aren't met.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 14 ++++++++++++
 ggml/src/ggml-cuda/set-rows.cu  | 33 ++++++++++++++++++++++++++++
 src/llama-graph.cpp             | 38 +++++++++++++++++++++++++++++++++
 3 files changed, 85 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 74192e012..b403207f3 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -25,6 +25,7 @@
 #include "ggml-cuda/diagmask.cuh"
 #include "ggml-cuda/diag.cuh"
 #include "ggml-cuda/fattn.cuh"
+#include "ggml-cuda/fused-attn.cuh"
 #include "ggml-cuda/fwht.cuh"
 #include "ggml-cuda/getrows.cuh"
 #include "ggml-cuda/im2col.cuh"
@@ -2301,6 +2302,14 @@ static bool ggml_cuda_compute_forward(ggml_backend_cuda_context & ctx, struct gg
         case GGML_OP_FILL:
             ggml_cuda_op_fill(ctx, dst);
             break;
+#if defined(GGML_CUDA_FUSED_ATTN_QJL)
+        case GGML_OP_FUSED_ATTN_QJL_TBQ:
+            ggml_cuda_op_fused_attn_qjl_tbq(ctx, dst);
+            break;
+        case GGML_OP_ATTN_SCORE_QJL:
+            ggml_cuda_op_attn_score_qjl(ctx, dst);
+            break;
+#endif
         default:
             return false;
     }
@@ -5068,6 +5077,11 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
         case GGML_OP_DIAG:
         case GGML_OP_SOLVE_TRI:
             return true;
+#if defined(GGML_CUDA_FUSED_ATTN_QJL)
+        case GGML_OP_FUSED_ATTN_QJL_TBQ:
+        case GGML_OP_ATTN_SCORE_QJL:
+            return true;
+#endif
 
         default:
             return false;
diff --git a/ggml/src/ggml-cuda/set-rows.cu b/ggml/src/ggml-cuda/set-rows.cu
index 465997065..ba708a212 100644
--- a/ggml/src/ggml-cuda/set-rows.cu
+++ b/ggml/src/ggml-cuda/set-rows.cu
@@ -1,6 +1,15 @@
 #include "set-rows.cuh"
 #include "cpy-utils.cuh"
 
+#if defined(GGML_CUDA_QJL)
+#include "qjl.cuh"
+#include "qjl-set-rows.cuh"
+#endif
+
+#if defined(GGML_CUDA_POLARQUANT)
+#include "polar-set-rows.cuh"
+#endif
+
 typedef void (*set_rows_kernel_t)(const char * src, char * dst);
 
 // Generic quantized set_rows kernel template
@@ -317,6 +326,30 @@ static void set_rows_cuda(ggml_backend_cuda_context & ctx, const ggml_tensor * s
             nb1, nb2, nb3,
             stream
         );
+#if defined(GGML_CUDA_QJL)
+    } else if (dst->type == GGML_TYPE_QJL1_256) {
+        set_rows_cuda_quant<idx_t, block_qjl1_256, 128, quantize_f32_qjl1_256_block>(
+            src0_d, src1_d, (block_qjl1_256*)dst->data,
+            ne00, ne01, ne02, ne03,
+            ne10, ne11, ne12, ne13,
+            nb01, nb02, nb03,
+            nb10, nb11, nb12,
+            nb1, nb2, nb3,
+            stream
+        );
+#endif
+#if defined(GGML_CUDA_POLARQUANT)
+    } else if (dst->type == GGML_TYPE_Q4_POLAR) {
+        set_rows_cuda_quant<idx_t, block_q4_polar, QK_POLAR, quantize_f32_q4_polar_block>(
+            src0_d, src1_d, (block_q4_polar*)dst->data,
+            ne00, ne01, ne02, ne03,
+            ne10, ne11, ne12, ne13,
+            nb01, nb02, nb03,
+            nb10, nb11, nb12,
+            nb1, nb2, nb3,
+            stream
+        );
+#endif
     } else {
         GGML_ABORT("unsupported type %s", ggml_type_name(dst->type));
     }
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index a8fd11ebc..152882ee6 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2412,6 +2412,43 @@ ggml_tensor * llm_graph_context::build_attn_mha(
             v = ggml_transpose(ctx0, v);
         }
 
+        // Fused QJL-K + TBQ/Polar-V attention path (CUDA only)
+        const bool use_fused_eliza_attn =
+            k->type == GGML_TYPE_QJL1_256 &&
+            (v->type == GGML_TYPE_Q4_POLAR || v->type == GGML_TYPE_TBQ3_0) &&
+            q->ne[0] == n_embd_head_k &&
+            n_embd_head_k == 128 &&
+            n_embd_head_v == 128 &&
+            v_mla == nullptr &&
+            !hparams.attn_soft_cap;
+
+        if (use_fused_eliza_attn) {
+            ggml_tensor * q_fa = ggml_permute(ctx0, q, 0, 2, 1, 3);
+            q_fa = ggml_cont(ctx0, q_fa);
+
+            cur = ggml_fused_attn_qjl_tbq(ctx0, q_fa, k, v, (int) n_head_kv, kq_scale);
+
+            int32_t fa_params[6];
+            memcpy(fa_params, cur->op_params, sizeof(fa_params));
+            fa_params[4] = 1; // causal decoder attention
+            const int64_t n_kv = k->ne[1];
+            fa_params[5] = n_kv >= q_fa->ne[2] ? (int32_t) (n_kv - q_fa->ne[2]) : 0;
+            memcpy(cur->op_params, fa_params, sizeof(fa_params));
+
+            cur = ggml_reshape_2d(ctx0, cur, cur->ne[0]*cur->ne[1], cur->ne[2]*cur->ne[3]);
+        } else {
+        // Fallback: dequantize exotic K-cache types for flash-attn
+        if (k->type == GGML_TYPE_QJL1_256 || k->type == GGML_TYPE_TBQ3_TCQ ||
+            k->type == GGML_TYPE_TBQ3_0 || k->type == GGML_TYPE_Q4_POLAR) {
+            ggml_tensor * k_f32 = ggml_cast(ctx0, k, GGML_TYPE_F32);
+            k = ggml_cast(ctx0, k_f32, GGML_TYPE_F16);
+        }
+        if (v->type == GGML_TYPE_TBQ3_0 || v->type == GGML_TYPE_Q4_POLAR ||
+            v->type == GGML_TYPE_TBQ3_TCQ) {
+            ggml_tensor * v_f32 = ggml_cast(ctx0, v, GGML_TYPE_F32);
+            v = ggml_cast(ctx0, v_f32, GGML_TYPE_F16);
+        }
+
         // this can happen when KV cache is not used (e.g. an embedding model with non-causal attn)
         if (k->type == GGML_TYPE_F32) {
             k = ggml_cast(ctx0, k, GGML_TYPE_F16);
@@ -2446,6 +2483,7 @@ ggml_tensor * llm_graph_context::build_attn_mha(
         }
 
         cur = ggml_reshape_2d(ctx0, cur, cur->ne[0]*cur->ne[1], cur->ne[2]*cur->ne[3]);
+        } // end else (non-fused eliza path)
     } else {
         ggml_tensor * kq = ggml_mul_mat(ctx0, k, q);
         cb(kq, "kq", il);
