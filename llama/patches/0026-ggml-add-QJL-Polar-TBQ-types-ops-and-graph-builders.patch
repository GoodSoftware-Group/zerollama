+        .is_quantized             = true,
+    },
+    [GGML_TYPE_TBQ3_TCQ] = {
+        .type_name                = "tbq3_tcq",
+        .blck_size                = QK_TBQ3_TCQ,
+        .type_size                = sizeof(block_tbq3_tcq),
+        .is_quantized             = true,
+    },
+    [GGML_TYPE_TBQ3_K] = {
+        .type_name                = "tbq3_k",
+        .blck_size                = QK_K,
+        .type_size                = sizeof(block_tbq3_k),
+        .is_quantized             = true,
+    },
+    [GGML_TYPE_TBQ4_K] = {
+        .type_name                = "tbq4_k",
+        .blck_size                = QK_K,
+        .type_size                = sizeof(block_tbq4_k),
+        .is_quantized             = true,
+    },
 };
 
