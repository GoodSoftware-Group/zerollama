From 052ed3777c30ad2cd747fefb2e6c706e2d9d8d1e Mon Sep 17 00:00:00 2001
From: Odilitime <janesmith@airmail.cc>
Date: Tue, 14 Jul 2026 14:51:13 -0700
Subject: [PATCH] common: register Eliza L2 KV cache types and -cpent
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Patches 0026–0030 added ggml types/kernels but never listed them in
kv_cache_types when rebasing onto ggml-org; E8_2 (0062) landed alone.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 common/arg.cpp  | 15 +++++++++++++++
 common/common.h |  1 +
 2 files changed, 16 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index e91a5d30..5af91944 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -309,6 +309,14 @@ const std::vector<ggml_type> kv_cache_types = {
     GGML_TYPE_Q5_0,
     GGML_TYPE_Q5_1,
     GGML_TYPE_E8_2,
+    // Eliza L2 fork KV (patches 0026–0030) — TBQ / QJL / Polar
+    GGML_TYPE_TBQ3_0,
+    GGML_TYPE_TBQ4_0,
+    GGML_TYPE_TBQ3_K,
+    GGML_TYPE_TBQ4_K,
+    GGML_TYPE_QJL1_256,
+    GGML_TYPE_Q4_POLAR,
+    GGML_TYPE_TBQ3_TCQ,
 };
 
 static ggml_type kv_cache_type_from_str(const std::string & s) {
@@ -1461,6 +1469,13 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.n_ctx_checkpoints = value;
         }
     ).set_env("LLAMA_ARG_CTX_CHECKPOINTS").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
+    add_opt(common_arg(
+        {"-cpent", "--checkpoint-every-n-tokens"}, "N",
+        string_format("create a checkpoint every n tokens during prefill (processing), -1 to disable (default: %d)", params.checkpoint_every_nt),
+        [](common_params & params, int value) {
+            params.checkpoint_every_nt = value;
+        }
+    ).set_env("LLAMA_ARG_CHECKPOINT_EVERY_NT").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
     add_opt(common_arg(
         {"-cms", "--checkpoint-min-step"}, "N",
         string_format("minimum spacing between context checkpoints in tokens (default: %d, 0 = no minimum)", params.checkpoint_min_step),
diff --git a/common/common.h b/common/common.h
index 15353170..32bdd825 100644
--- a/common/common.h
+++ b/common/common.h
@@ -623,6 +623,7 @@ struct common_params {
     bool    cache_idle_slots    = true;  // save and clear idle slots upon starting a new task
     int32_t n_ctx_checkpoints   = 32;    // max number of context checkpoints per slot
     int32_t checkpoint_min_step = 8192;  // minimum spacing between context checkpoints
+    int32_t checkpoint_every_nt = 8192;  // L2 fork: checkpoint every n tokens during prefill (-1 disable)
     int32_t cache_ram_mib       = 8192;  // -1 = no limit, 0 - disable, 1 = 1 MiB, etc.
 
     std::string hostname      = "127.0.0.1";
-- 
2.54.0

