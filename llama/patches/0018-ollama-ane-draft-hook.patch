+        if (!g_session.outBuf) {
+            return false;
+        }
+        LOG_INF("%s: P2 matmul chain gate+silu+up ic=%d→oc=%d then ic=%d→oc=%d seq=%d\n",
+                __func__, g_session.ch, g_session.matmulOc, ic2, oc2, seq);
+    } else {
+        LOG_INF("%s: P3 matmul chain up proj ic=%d→oc=%d seq=%d\n", __func__, ic2, oc2, seq);
+    }
+    return true;
