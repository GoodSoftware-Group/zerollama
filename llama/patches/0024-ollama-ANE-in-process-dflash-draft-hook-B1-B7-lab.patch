+    if (g_session.dflashFfnHostFp32) {
+        g_session.matmul6Active = true;
+        g_session.matmul6Dynamic = false;
+        LOG_INF("%s: P23 dflash ffn_gate host_fp32 ic=%d→oc=%d seq=%d\n", __func__, ic6, oc6, seq);
+        return true;
+    }
+    const int spIn6 = seq + oc6;
