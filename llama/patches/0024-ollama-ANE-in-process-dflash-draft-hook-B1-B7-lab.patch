+struct ane_dflash_attn_geom {
+    int   n_heads_kv = 0;
+    int   head_dim   = 0;
+    int   n_dims     = 0;
+    float freq_base  = 1e6f;
+    float freq_scale = 1.f;
+    bool  neox       = true;
+};
