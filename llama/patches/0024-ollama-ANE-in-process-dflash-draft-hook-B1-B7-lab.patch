+static bool ane_session_init_matmul10(int seq, int chain) {
+    const char * w9path = getenv("ZEROLLAMA_ANE_DRAFT_WEIGHT_FILE9");
+    if (chain < 10 || !w9path || !w9path[0] || !g_session.matmulDynamic || !g_session.matmul9Active) {
