+
+common_ane_draft_drive_mode common_ane_draft_get_drive_mode() {
+    const char * v = std::getenv("ZEROLLAMA_ANE_DRAFT_DRIVE");
+    if (!v || !v[0]) {
+        return COMMON_ANE_DRAFT_DRIVE_OFF;
+    }
+    if (strcmp(v, "shadow") == 0) {
+        return COMMON_ANE_DRAFT_DRIVE_SHADOW;
+    }
