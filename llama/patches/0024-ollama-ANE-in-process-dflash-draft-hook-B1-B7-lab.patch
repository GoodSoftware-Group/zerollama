+static NSData * ane_load_gamma_blob(const char * path, int ch) {
+    if (!path || !path[0]) {
+        return nil;
+    }
+    NSData * data = [NSData dataWithContentsOfFile:[NSString stringWithUTF8String:path]];
+    if (!data) {
+        return nil;
+    }
+    NSUInteger expected = 64 + 64 + (NSUInteger) ch * 2;
+    if ([data length] != expected) {
+        return nil;
+    }
+    return data;
+}
