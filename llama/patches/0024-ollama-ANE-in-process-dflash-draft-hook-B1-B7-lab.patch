+        g_session.conv6Active = false;
+        if (want_conv6 && ane_compile_conv_kernel(&g_session.kernel6, wb6, channels, spatial, g_session.ioBytes)) {
+            g_session.inSID6 = ane_bridge_input_surface_id(g_session.kernel6, 0);
