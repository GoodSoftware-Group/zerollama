+        @"            tensor<fp16, [1,1,%d,%d]> yh = matmul(transpose_x=bF, transpose_y=bF, x=x3, y=W)[name=string(\"yh\")];\n"
+        @"            tensor<fp16, [1,1,%d,%d]> yt = transpose(perm=pm, x=yh)[name=string(\"yt\")];\n"
