+    if (!ane_load_matmul_weight_matrix(w6path, ic6, oc6, &g_session.matmul6W, &wcount)) {
+        LOG_WRN("%s: dflash ffn_gate load failed path=%s ic=%d oc=%d\n", __func__, w6path, ic6, oc6);
