@@ -3517,6 +3517,13 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.pooling_type = LLAMA_POOLING_TYPE_NONE;
         }
     ).set_examples({LLAMA_EXAMPLE_SERVER}).set_env("LLAMA_ARG_DECISIONS"));
