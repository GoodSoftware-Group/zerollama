@@ -299,6 +300,8 @@ int llama_server(common_params & params, int argc, char ** argv) {
     ctx_http.post("/v1/reranking",             ex_wrapper(routes.post_rerank));
     ctx_http.post("/v1/decisions",             ex_wrapper(routes.post_decisions));
