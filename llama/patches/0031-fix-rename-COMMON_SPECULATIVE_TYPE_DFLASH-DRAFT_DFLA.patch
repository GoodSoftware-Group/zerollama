ggml-org renamed the speculative enum; ANE hook still used the old
identifier and broke llama-common on Mac builds.
---
 common/ane_draft_hook.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/ane_draft_hook.cpp b/common/ane_draft_hook.cpp
index b57ab1ece..849963b64 100644
--- a/common/ane_draft_hook.cpp
+++ b/common/ane_draft_hook.cpp
@@ -1522,7 +1522,7 @@ static bool ane_should_sync_target_cross(const llama_model * model_dft) {
     if (common_ane_draft_enabled()) {
         return true;
     }
-    if (g_spec_type == COMMON_SPECULATIVE_TYPE_DFLASH) {
+    if (g_spec_type == COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH) {
         return true;
     }
     return model_arch_is(model_dft, "dflash-draft");
