From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Thu, 30 Jul 2026 04:15:00 -0700
Subject: [PATCH] unicode: fuse ASCII pretok materialize with byte-encode (0118)

Build remapped pretok words in one pass from offsets instead of
N substrings then N encode copies. ~1.42x vs NO_BYTE_ENC_FAST on
Qwen2 ASCII; identity held. See docs/faster-bpe-tokenize.md (M15d / 0118).

---
diff --git a/src/unicode.cpp b/src/unicode.cpp
index 21453e570..eb1295149 100644
--- a/src/unicode.cpp
+++ b/src/unicode.cpp
@@ -195,36 +195,20 @@ static std::unordered_map<std::string, uint8_t> unicode_utf8_to_byte_map() {
     return map;
 }
 
-static std::vector<std::string> unicode_byte_encoding_process(const std::vector<std::string> & bpe_words) {
-    // WHY (0117): stock did unordered_map lookup + temporary std::string per byte, then
-    // `+=` into the output. Printable ASCII 0x21..0x7E maps to itself (1-byte UTF-8) —
-    // those words are identity. Flattened LUT + append(len) for the rest.
-    // LLAMA_BPE_NO_BYTE_ENC_FAST=1 keeps the old map+= path for identity A/B.
-    if (getenv("LLAMA_BPE_NO_BYTE_ENC_FAST") != nullptr) {
-        std::vector<std::string> bpe_encoded_words;
-        bpe_encoded_words.reserve(bpe_words.size());
-        for (const auto & word : bpe_words) {
-            std::string encoded_token;
-            encoded_token.reserve(word.size() * 2);
-            for (unsigned char c : word) {
-                encoded_token += unicode_byte_to_utf8(c);
-            }
-            bpe_encoded_words.emplace_back(std::move(encoded_token));
-        }
-        return bpe_encoded_words;
-    }
-
-    struct enc {
-        char    d[4];
-        uint8_t n;
-    };
-    static enc table[256];
+// Shared GPT-2 byte→UTF-8 table (0117). Built once.
+struct unicode_byte_enc {
+    char    d[4];
+    uint8_t n;
+};
+
+static const unicode_byte_enc * unicode_byte_enc_table() {
+    static unicode_byte_enc table[256];
     static bool init = false;
     if (!init) {
         const auto map = unicode_byte_to_utf8_map();
         for (int ch = 0; ch < 256; ++ch) {
             const std::string & s = map.at((uint8_t) ch);
-            enc & e = table[ch];
+            unicode_byte_enc & e = table[ch];
             e.n = (uint8_t) s.size();
             assert(e.n <= 4);
             for (uint8_t i = 0; i < e.n; ++i) {
@@ -236,27 +220,49 @@ static std::vector<std::string> unicode_byte_encoding_process(const std::vector<
         }
         init = true;
     }
+    return table;
+}
 
-    auto word_is_printable_ascii = [](const std::string & word) -> bool {
-        for (unsigned char c : word) {
-            if (c < 0x21u || c > 0x7Eu) {
-                return false;
+static inline bool unicode_word_is_printable_ascii(const unsigned char * p, size_t n) {
+    for (size_t i = 0; i < n; ++i) {
+        if (p[i] < 0x21u || p[i] > 0x7Eu) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static std::vector<std::string> unicode_byte_encoding_process(const std::vector<std::string> & bpe_words) {
+    // WHY (0117): stock did unordered_map lookup + temporary std::string per byte, then
+    // `+=` into the output. Printable ASCII 0x21..0x7E maps to itself (1-byte UTF-8) —
+    // those words are identity. Flattened LUT + append(len) for the rest.
+    // LLAMA_BPE_NO_BYTE_ENC_FAST=1 keeps the old map+= path for identity A/B.
+    if (getenv("LLAMA_BPE_NO_BYTE_ENC_FAST") != nullptr) {
+        std::vector<std::string> bpe_encoded_words;
+        bpe_encoded_words.reserve(bpe_words.size());
+        for (const auto & word : bpe_words) {
+            std::string encoded_token;
+            encoded_token.reserve(word.size() * 2);
+            for (unsigned char c : word) {
+                encoded_token += unicode_byte_to_utf8(c);
             }
+            bpe_encoded_words.emplace_back(std::move(encoded_token));
         }
-        return true;
-    };
+        return bpe_encoded_words;
+    }
 
+    const unicode_byte_enc * table = unicode_byte_enc_table();
     std::vector<std::string> bpe_encoded_words;
     bpe_encoded_words.reserve(bpe_words.size());
     for (const auto & word : bpe_words) {
-        if (word_is_printable_ascii(word)) {
+        if (unicode_word_is_printable_ascii((const unsigned char *) word.data(), word.size())) {
             bpe_encoded_words.push_back(word);
             continue;
         }
         std::string encoded_token;
         encoded_token.reserve(word.size() * 2);
         for (unsigned char c : word) {
-            const enc & e = table[c];
+            const unicode_byte_enc & e = table[c];
             encoded_token.append(e.d, e.n);
         }
         bpe_encoded_words.emplace_back(std::move(encoded_token));
@@ -584,18 +590,45 @@ static inline void unicode_ascii_consume_digits_bytes(
     }
 }
 
+// WHY (0118): fuse pretok offsets → words with optional byte-encode in one pass.
+// Old path built N substrings then N encoded copies (printable words paid twice).
 static std::vector<std::string> unicode_words_from_byte_offsets(
         const std::string & text, const std::vector<size_t> & bpe_offsets, bool byte_encode) {
     std::vector<std::string> bpe_words;
     bpe_words.reserve(bpe_offsets.size());
     size_t start = 0;
-    for (size_t len : bpe_offsets) {
-        bpe_words.emplace_back(text.data() + start, len);
-        start += len;
+    if (!byte_encode) {
+        for (size_t len : bpe_offsets) {
+            bpe_words.emplace_back(text.data() + start, len);
+            start += len;
+        }
+        return bpe_words;
     }
-    if (byte_encode) {
+    if (getenv("LLAMA_BPE_NO_BYTE_ENC_FAST") != nullptr) {
+        for (size_t len : bpe_offsets) {
+            bpe_words.emplace_back(text.data() + start, len);
+            start += len;
+        }
         return unicode_byte_encoding_process(bpe_words);
     }
+
+    const unicode_byte_enc * table = unicode_byte_enc_table();
+    const unsigned char * base = (const unsigned char *) text.data();
+    for (size_t len : bpe_offsets) {
+        const unsigned char * p = base + start;
+        if (unicode_word_is_printable_ascii(p, len)) {
+            bpe_words.emplace_back((const char *) p, len);
+        } else {
+            std::string encoded;
+            encoded.reserve(len * 2);
+            for (size_t i = 0; i < len; ++i) {
+                const unicode_byte_enc & e = table[p[i]];
+                encoded.append(e.d, e.n);
+            }
+            bpe_words.emplace_back(std::move(encoded));
+        }
+        start += len;
+    }
     return bpe_words;
 }
 
