+static __device__ __forceinline__ int pack_fp8_e4m3_qs_as_q8(const block_fp8_e4m3 * bxi, const int kqs) {
+    float amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < QK_FP8_E4M3; ++j) {
+        amax = fmaxf(amax, fabsf(ggml_cuda_fp8_e4m3_to_fp32(bxi->qs[j])));
+    }
+    const float mul = amax > 0.0f ? 127.0f / amax : 0.0f;
+    int packed = 0;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const float f = ggml_cuda_fp8_e4m3_to_fp32(bxi->qs[4*kqs + j]) * mul;
+        int q = __float2int_rn(f);
+        q = q > 127 ? 127 : (q < -127 ? -127 : q);
+        packed |= (q & 0xFF) << (8*j);
+    }
+    return packed;
+}
+
+static __device__ __forceinline__ float fp8_e4m3_block_d_as_q8(const block_fp8_e4m3 * bxi) {
+    float amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < QK_FP8_E4M3; ++j) {
+        amax = fmaxf(amax, fabsf(ggml_cuda_fp8_e4m3_to_fp32(bxi->qs[j])));
+    }
+    return __half2float(bxi->d) * (amax / 127.0f);
+}
+
+// Pack FP8 E4M3 blocks into Q8_0-shaped MMQ tiles (same layout as q8_0 load).
+template <ggml_type type, int J, bool fallback> static __device__ __forceinline__ void ggml_cuda_mmq_load_tiles_fp8_e4m3(
+        const char * __restrict__ x, int * __restrict__ x_tile, const int kbx0, const int i_max, const int stride) {
+    constexpr int warp_size   = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps      = ggml_cuda_mmq_get_nthreads(type, J, fallback) / warp_size;
+    constexpr int I           = ggml_cuda_mmq_get_I(type, J, fallback);
+    constexpr int sram_stride = ggml_cuda_mmq_get_sram_stride(type, J, fallback);
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_tile + 2*MMQ_TILE_NE_K);
+#else
+    constexpr tile_x_sizes txs = mmq_get_dp4a_tile_x_sizes(GGML_TYPE_FP8_E4M3, I);
+    int   * x_qs = (int   *)  x_tile;
+    float * x_df = (float *) (x_qs + txs.qs);
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+
+    constexpr int threads_per_row = 32;
+    constexpr int nrows = warp_size / threads_per_row;
+    const int txi = warp_size > threads_per_row ? threadIdx.x % threads_per_row : threadIdx.x;
+    const int kbx  = txi / QI_FP8_E4M3;
+    const int kqsx = txi % QI_FP8_E4M3;
+
+#pragma unroll
+    for (int i0 = 0; i0 < I; i0 += nrows*nwarps) {
+        int i = i0 + (nrows == 1 ? threadIdx.y : threadIdx.y*nrows + threadIdx.x/threads_per_row);
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_fp8_e4m3 * bxi0 = (const block_fp8_e4m3 *) x + kbx0 + i*stride + kbx;
+        const block_fp8_e4m3 * bxi1 = bxi0 + MMQ_TILE_NE_K/QI_FP8_E4M3;
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        x_qs[i*sram_stride + 0             + txi] = pack_fp8_e4m3_qs_as_q8(bxi0, kqsx);
+        x_qs[i*sram_stride + MMQ_TILE_NE_K + txi] = pack_fp8_e4m3_qs_as_q8(bxi1, kqsx);
+#else
+        x_qs[i*(2*MMQ_TILE_NE_K + 1) + 0             + txi] = pack_fp8_e4m3_qs_as_q8(bxi0, kqsx);
+        x_qs[i*(2*MMQ_TILE_NE_K + 1) + MMQ_TILE_NE_K + txi] = pack_fp8_e4m3_qs_as_q8(bxi1, kqsx);
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    }
+
+    constexpr int blocks_per_tile_x_row = 2*MMQ_TILE_NE_K / QI_FP8_E4M3;
+    constexpr int rows_per_warp = warp_size / blocks_per_tile_x_row;
+    const int kbxd = threadIdx.x % blocks_per_tile_x_row;
+
+#pragma unroll
+    for (int i0 = 0; i0 < I; i0 += nwarps * rows_per_warp) {
+        int i = i0 + threadIdx.y * rows_per_warp + threadIdx.x / blocks_per_tile_x_row;
+
+        if (fallback) {
+            i = min(i, i_max);
+        }
+
+        const block_fp8_e4m3 * bxi = (const block_fp8_e4m3 *) x + kbx0 + i*stride + kbxd;
+        const float d = fp8_e4m3_block_d_as_q8(bxi);
+
+#if defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+        x_df[i*sram_stride                           + kbxd] = d;
+#else
+        x_df[i*(2*MMQ_TILE_NE_K/QI_FP8_E4M3) + i/(QI_FP8_E4M3/2) + kbxd] = d;
+#endif // defined(AMD_MFMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE)
+    }
+}
