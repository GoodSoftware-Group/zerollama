+
+    // node_id -> parent_node_id for all occupied cells (includes prior steps + this ubatch)
+    std::unordered_map<int32_t, int32_t> nid_to_parent;
+    nid_to_parent.reserve((size_t) n_kv);
+    for (uint32_t j = 0; j < (uint32_t) n_kv; ++j) {
