From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@localhost>
Date: Wed, 30 Sep 2026 11:16:38 -0700
Subject: [PATCH] llama: MultiDecode cell node_id + multi-step ancestor mask
 (0130)

Store stable node_id/parent_node_id on KV cells; mask walks node ids so
historical prefix cells survive across ubatches. Exactness step2 PASS.
---
 .../multidecode/multidecode-exactness.cpp     | 121 ++++++++++++++++--
 include/llama.h                               |   9 +-
 src/llama-batch.cpp                           |  27 ++++
 src/llama-batch.h                             |   6 +-
 src/llama-kv-cache-dsv4.cpp                   |   2 +
 src/llama-kv-cache.cpp                        |  67 +++++++---
 src/llama-kv-cells.h                          |  45 +++++++
 7 files changed, 240 insertions(+), 37 deletions(-)

diff --git a/examples/multidecode/multidecode-exactness.cpp b/examples/multidecode/multidecode-exactness.cpp
index ea2feb573..28cf43e93 100644
--- a/examples/multidecode/multidecode-exactness.cpp
+++ b/examples/multidecode/multidecode-exactness.cpp
@@ -10,6 +10,7 @@
 
 #include "llama.h"
 
+#include <algorithm>
 #include <cmath>
 #include <cstdio>
 #include <cstdlib>
@@ -166,9 +167,9 @@ int main(int argc, char ** argv) {
             n_forest, prefix.size(), branch_a.size(), branch_b.size(), leaf_a, leaf_b);
 
     llama_context_params cparams = llama_context_default_params();
-    cparams.n_ctx   = n_forest + 32;
-    cparams.n_batch = n_forest;
-    cparams.n_ubatch = n_forest;
+    cparams.n_ctx   = n_forest + 64;
+    cparams.n_batch = std::max(n_forest, 8);
+    cparams.n_ubatch = cparams.n_batch;
     cparams.n_seq_max = 1;
 
     llama_context * ctx = llama_init_from_model(model, cparams);
@@ -177,7 +178,9 @@ int main(int argc, char ** argv) {
         return 1;
     }
 
-    // --- Path A: MultiDecode forest ---
+    const float eps = 2e-2f; // fp16-tolerant
+
+    // --- Step 1: MultiDecode forest (one-shot) ---
     llama_memory_clear(llama_get_memory(ctx), true);
     llama_batch batch = llama_batch_init(n_forest, 0, 1);
     batch.n_tokens = n_forest;
@@ -192,18 +195,17 @@ int main(int argc, char ** argv) {
     }
 
     if (llama_decode(ctx, batch) != 0) {
-        fprintf(stderr, "MultiDecode llama_decode failed\n");
+        fprintf(stderr, "MultiDecode step1 llama_decode failed\n");
         llama_batch_free(batch);
         llama_free(ctx);
         llama_model_free(model);
         return 1;
     }
 
-    // logits rows appear in batch order for marked outputs → leaf_a then leaf_b
     const float * md_a = llama_get_logits_ith(ctx, leaf_a);
     const float * md_b = llama_get_logits_ith(ctx, leaf_b);
     if (!md_a || !md_b) {
-        fprintf(stderr, "MultiDecode: null leaf logits (a=%p b=%p)\n", (const void *) md_a, (const void *) md_b);
+        fprintf(stderr, "MultiDecode step1: null leaf logits\n");
         llama_batch_free(batch);
         llama_free(ctx);
         llama_model_free(model);
@@ -211,9 +213,14 @@ int main(int argc, char ** argv) {
     }
     std::vector<float> md_logits_a(md_a, md_a + n_vocab);
     std::vector<float> md_logits_b(md_b, md_b + n_vocab);
+    // pick greedy next tokens from forest leaves (fixed for both paths)
+    int best_a = 0, best_b = 0;
+    for (int v = 1; v < n_vocab; ++v) {
+        if (md_logits_a[v] > md_logits_a[best_a]) best_a = v;
+        if (md_logits_b[v] > md_logits_b[best_b]) best_b = v;
+    }
     llama_batch_free(batch);
 
-    // --- Path B: two linear prefills ---
     std::vector<llama_token> path_a = prefix;
     path_a.insert(path_a.end(), branch_a.begin(), branch_a.end());
     std::vector<llama_token> path_b = prefix;
@@ -227,19 +234,107 @@ int main(int argc, char ** argv) {
         return 1;
     }
 
-    const float eps = 2e-2f; // fp16-tolerant
     const float da = max_abs_diff(md_logits_a.data(), lin_a.data(), n_vocab);
     const float db = max_abs_diff(md_logits_b.data(), lin_b.data(), n_vocab);
+    fprintf(stderr, "step1 max_abs_diff leaf_a=%.6g leaf_b=%.6g (eps=%.3g)\n", da, db, eps);
+    if (da > eps || db > eps) {
+        fprintf(stderr, "FAIL: step1 MultiDecode logits diverge from linear\n");
+        llama_free(ctx);
+        llama_model_free(model);
+        return 1;
+    }
+    fprintf(stderr, "PASS: step1 one-shot forest\n");
+
+    // --- Step 2: multi-step append (reuse KV via parent_node_id) ---
+    // Rebuild forest KV (cleared by linear baselines above)
+    llama_memory_clear(llama_get_memory(ctx), true);
+    {
+        llama_batch b1 = llama_batch_init(n_forest, 0, 1);
+        b1.n_tokens = n_forest;
+        b1.parent = (int32_t *) malloc(sizeof(int32_t) * n_forest);
+        for (int i = 0; i < n_forest; ++i) {
+            b1.token[i] = forest_tok[i];
+            b1.pos[i] = forest_pos[i];
+            b1.parent[i] = forest_parent[i];
+            b1.n_seq_id[i] = 1;
+            b1.seq_id[i][0] = 0;
+            b1.logits[i] = 0; // no need for step1 logits again
+        }
+        if (llama_decode(ctx, b1) != 0) {
+            fprintf(stderr, "MultiDecode step2 rebuild failed\n");
+            llama_batch_free(b1);
+            return 1;
+        }
+        llama_batch_free(b1);
+    }
+
+    const llama_pos depth_next = (llama_pos) (prefix.size() + std::max(branch_a.size(), branch_b.size()));
+    const int32_t nid_a = n_forest;
+    const int32_t nid_b = n_forest + 1;
 
-    fprintf(stderr, "max_abs_diff leaf_a=%.6g leaf_b=%.6g (eps=%.3g)\n", da, db, eps);
+    llama_batch b2 = llama_batch_init(2, 0, 1);
+    b2.n_tokens = 2;
+    b2.parent = (int32_t *) malloc(sizeof(int32_t) * 2);
+    b2.node_id = (int32_t *) malloc(sizeof(int32_t) * 2);
+    b2.parent_node_id = (int32_t *) malloc(sizeof(int32_t) * 2);
+    // leaf A continuation
+    b2.token[0] = best_a;
+    b2.pos[0] = depth_next;
+    b2.parent[0] = -1;
+    b2.node_id[0] = nid_a;
+    b2.parent_node_id[0] = leaf_a; // one-shot synth used batch index as node_id
+    b2.n_seq_id[0] = 1;
+    b2.seq_id[0][0] = 0;
+    b2.logits[0] = 1;
+    // leaf B continuation
+    b2.token[1] = best_b;
+    b2.pos[1] = depth_next;
+    b2.parent[1] = -1;
+    b2.node_id[1] = nid_b;
+    b2.parent_node_id[1] = leaf_b;
+    b2.n_seq_id[1] = 1;
+    b2.seq_id[1][0] = 0;
+    b2.logits[1] = 1;
+
+    if (llama_decode(ctx, b2) != 0) {
+        fprintf(stderr, "MultiDecode step2 llama_decode failed\n");
+        llama_batch_free(b2);
+        llama_free(ctx);
+        llama_model_free(model);
+        return 1;
+    }
+    const float * md2_a = llama_get_logits_ith(ctx, 0);
+    const float * md2_b = llama_get_logits_ith(ctx, 1);
+    if (!md2_a || !md2_b) {
+        fprintf(stderr, "MultiDecode step2: null logits\n");
+        llama_batch_free(b2);
+        return 1;
+    }
+    std::vector<float> md2a(md2_a, md2_a + n_vocab);
+    std::vector<float> md2b(md2_b, md2_b + n_vocab);
+    llama_batch_free(b2);
+
+    path_a.push_back(best_a);
+    path_b.push_back(best_b);
+    std::vector<float> lin2a, lin2b;
+    if (decode_linear_leaf_logits(ctx, path_a, lin2a) != 0) {
+        return 1;
+    }
+    if (decode_linear_leaf_logits(ctx, path_b, lin2b) != 0) {
+        return 1;
+    }
+
+    const float d2a = max_abs_diff(md2a.data(), lin2a.data(), n_vocab);
+    const float d2b = max_abs_diff(md2b.data(), lin2b.data(), n_vocab);
+    fprintf(stderr, "step2 max_abs_diff leaf_a=%.6g leaf_b=%.6g (eps=%.3g)\n", d2a, d2b, eps);
 
     llama_free(ctx);
     llama_model_free(model);
 
-    if (da > eps || db > eps) {
-        fprintf(stderr, "FAIL: MultiDecode logits diverge from linear baselines\n");
+    if (d2a > eps || d2b > eps) {
+        fprintf(stderr, "FAIL: step2 multi-step MultiDecode logits diverge from linear\n");
         return 1;
     }
-    fprintf(stderr, "PASS: MultiDecode leaf logits match linear prefills\n");
+    fprintf(stderr, "PASS: MultiDecode step1+step2 (node_id) match linear prefills\n");
     return 0;
 }
