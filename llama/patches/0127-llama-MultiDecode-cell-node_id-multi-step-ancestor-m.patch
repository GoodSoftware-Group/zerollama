                 cells.ext_set(idx, ext);
             }
 
+            // MultiDecode: stable node ids (MD1). One-shot with only parent[]: node_id = batch index.
+            if (ubatch.parent != nullptr) {
+                const int32_t nid = ubatch.node_id ? ubatch.node_id[i] : (int32_t) i;
