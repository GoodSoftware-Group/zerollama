+                    const int32_t p = ubatch.parent[i];
+                    pnid = ubatch.node_id ? ubatch.node_id[p] : p;
+                }
+                cells.node_id_set(idx, nid, pnid);
+            }
+
             for (int32_t s = 0; s < ubatch.n_seq_id[i]; s++) {
                 cells.seq_add(idx, ubatch.seq_id[i][s]);
             }
