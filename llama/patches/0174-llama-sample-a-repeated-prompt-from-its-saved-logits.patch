 common/sampling.h                   |   3 +
 tools/server/server-context.cpp     | 174 +++++++++++++++++++++++++++-
 tools/server/server-prompt-logits.h |  89 ++++++++++++++
 4 files changed, 330 insertions(+), 1 deletion(-)
 create mode 100644 tools/server/server-prompt-logits.h

