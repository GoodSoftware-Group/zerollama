+    void save_prompt_logits(server_slot & slot, int32_t tok_idx) {
+        // a draft context has to see every prompt token, so this row would never be used
+        if (ctx_dft || !llama_prompt_logits_on() || !prompt_logits_attention()) {
+            return;
+        }
+        if (!slot.task || slot.prompt.tokens.has_mtmd || lora_all_alora(slot.lora)) {
+            return;
+        }
+        if (slot.task->type != SERVER_TASK_TYPE_COMPLETION && slot.task->type != SERVER_TASK_TYPE_INFILL) {
+            return;
+        }
+        if (slot.task->params.sampling.backend_sampling) {
+            return;
+        }
+        if (slot.prompt.n_tokens() <= 0 || slot.prompt.n_tokens() != slot.task->n_tokens() || tok_idx < 0) {
+            return;
+        }
+        const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+        if (n_vocab <= 0) {
+            return;
+        }
+        const float * row = llama_get_logits_ith(ctx_tgt, tok_idx);
+        if (!row) {
+            return;
+        }
+        const int32_t n = slot.prompt.n_tokens();
+        const int32_t k = shortlist_k_for(slot.task->params.sampling);
+        slot.prompt_logits.assign(row, row + n_vocab);
+        slot.prompt_logits_n    = n;
+        slot.prompt_logits_k    = k == 0 ? -1 : k;
+        slot.prompt_logits_hash = prompt_logits_hash_tokens(slot.prompt.tokens, n);
+        SLT_DBG(slot, "saved the logits after %d prompt tokens\n", n);
+    }
