+    // The prompt is already in the cache. Sample its saved row and let the
+    // next batch run the chosen token.
+    void reuse_prompt_logits(server_slot & slot) {
+        slot.i_batch = -1;
+        const llama_pos p0 = slot.prompt.tokens.pos_next();
+        SLT_TRC(slot, "cached n_tokens = %d, memory_seq_rm [%d, end)\n", slot.prompt.n_tokens(), p0);
+        slot.mem.seq_rm(slot.id, p0, -1);
+        SLT_INF(slot, "repeated prompt of %d tokens keeps its logits\n", slot.prompt.n_tokens());
+
+        if (slot.task->params.prefill_only) {
+            slot.state = SLOT_STATE_DONE_PROMPT;
+            send_final_response(slot);
+            slot.release();
+            return;
+        }
