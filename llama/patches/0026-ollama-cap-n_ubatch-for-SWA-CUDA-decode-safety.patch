From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 10 Jul 2026 01:07:26 -0700
Subject: [PATCH] ollama: cap n_ubatch for SWA CUDA decode safety

---
 common/common.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/common/common.cpp b/common/common.cpp
index 3d54bd6..180f21a 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1395,6 +1395,18 @@ common_init_result::common_init_result(common_params & params, bool model_only)
         cparams.n_samplers = pimpl->samplers_seq_config.size();
     }
 
+    // SWA / iswa (gemma4, etc.): CUDA illegal access during decode when a single
+    // physical ubatch exceeds ~256 tokens (SUM_ROWS / MUL_MAT on the last chunk).
+    // Reproduced with -ub 288+ on RTX 4090; -ub 256 is stable. Cap before context
+    // creation so graph reservation matches runtime decode.
+    constexpr int32_t k_swa_safe_n_ubatch = 256;
+    if (llama_model_n_swa(model) > 0 && !params.swa_full && cparams.n_ubatch > k_swa_safe_n_ubatch) {
+        LOG_WRN("%s: capping n_ubatch (%d -> %d): SWA CUDA decode is unsafe with larger ubatches\n",
+                __func__, cparams.n_ubatch, k_swa_safe_n_ubatch);
+        cparams.n_ubatch = k_swa_safe_n_ubatch;
+        params.n_ubatch  = k_swa_safe_n_ubatch;
+    }
+
     llama_context * lctx = llama_init_from_model(model, cparams);
     if (lctx == NULL) {
         COM_ERR("failed to create context with model '%s'\n", params.model.path.c_str());
