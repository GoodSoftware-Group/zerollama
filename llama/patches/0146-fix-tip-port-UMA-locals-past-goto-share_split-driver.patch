From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Sat, 24 Oct 2026 20:43:26 -0700
Subject: [PATCH] fix: tip-port UMA locals past goto share_split +
 driverVersion

b11870 still declares prop/is_uma after the NVML goto; hoist assigns
into the predeclared locals (0067). Restore driverVersion init lost in
device-reg rebase.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 4807ccd9f..cfa17a298 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5546,11 +5546,10 @@ static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t *
 // ref: https://github.com/ggml-org/llama.cpp/pull/17368
 #if defined(__linux__) && !defined(GGML_USE_HIP)
     // Check if this is a UMA (Unified Memory Architecture) system
-    cudaDeviceProp prop;
+    // (prop/is_uma declared above — before goto share_split)
     CUDA_CHECK(cudaGetDeviceProperties(&prop, ggml_cuda_get_physical_device(ctx->device)));
-
-    // Check if UMA is explicitly enabled via environment variable
-    bool is_uma = prop.integrated > 0 || ggml_cuda_unified_memory_enabled();
+    uma_env = ggml_cuda_unified_memory_enabled();
+    is_uma = prop.integrated > 0 || uma_env;
 
     if (is_uma) {
         // For UMA systems (like DGX Spark), use system memory info
@@ -6318,6 +6317,7 @@ ggml_backend_reg_t ggml_backend_cuda_reg() {
 
             const ggml_cuda_device_info & info = ggml_cuda_info();
             const bool virtual_devices = info.device_count > info.physical_device_count;
+            int driverVersion = 0;
 
             for (int i = 0; i < info.device_count; i++) {
                 const int physical_id = info.devices[i].physical_device;
