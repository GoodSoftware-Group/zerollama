From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Sat, 24 Oct 2026 20:34:57 -0700
Subject: [PATCH] gguf dual chunk attention metadata keys

---
 gguf-py/gguf/constants.py.rej | 13 +++++++++++++
 gguf-py/gguf/gguf_writer.py   |  9 +++++++++
 2 files changed, 22 insertions(+)
 create mode 100644 gguf-py/gguf/constants.py.rej

diff --git a/gguf-py/gguf/constants.py.rej b/gguf-py/gguf/constants.py.rej
new file mode 100644
index 0000000..37d191e
--- /dev/null
+++ b/gguf-py/gguf/constants.py.rej
@@ -0,0 +1,13 @@
+diff a/gguf-py/gguf/constants.py b/gguf-py/gguf/constants.py	(rejected hunks)
+@@ -222,6 +222,11 @@ class Keys:
+         RECURRENT_LAYERS             = "{arch}.attention.recurrent_layers"
+         TEMPERATURE_SCALE            = "{arch}.attention.temperature_scale"
+         ROPE_PATTERN                 = "{arch}.attention.rope_pattern"
++        # Dual Chunk Attention (Qwen long-ctx / 1M). Metadata only until native FA lands.
++        # See docs/dca-dual-chunk-attention.md
++        DCA_CHUNK_SIZE               = "{arch}.attention.dca.chunk_size"
++        DCA_LOCAL_SIZE               = "{arch}.attention.dca.local_size"
++        DCA_ORIG_CTX_LEN             = "{arch}.attention.dca.original_context_length"
+ 
+         class Indexer:
+             HEAD_COUNT = "{arch}.attention.indexer.head_count"
diff --git a/gguf-py/gguf/gguf_writer.py b/gguf-py/gguf/gguf_writer.py
index 0e7aa50..6cbcbd7 100644
--- a/gguf-py/gguf/gguf_writer.py
+++ b/gguf-py/gguf/gguf_writer.py
@@ -1264,6 +1264,15 @@ class GGUFWriter:
     def add_rope_scaling_yarn_beta_slow(self, value: float) -> None:
         self.add_float32(Keys.Rope.SCALING_YARN_BETA_SLOW.format(arch=self.arch), value)
 
+    def add_dca_chunk_size(self, value: int) -> None:
+        self.add_uint32(Keys.Attention.DCA_CHUNK_SIZE.format(arch=self.arch), value)
+
+    def add_dca_local_size(self, value: int) -> None:
+        self.add_uint32(Keys.Attention.DCA_LOCAL_SIZE.format(arch=self.arch), value)
+
+    def add_dca_orig_ctx_len(self, value: int) -> None:
+        self.add_uint32(Keys.Attention.DCA_ORIG_CTX_LEN.format(arch=self.arch), value)
+
     def add_ssm_conv_kernel(self, value: int) -> None:
         self.add_uint32(Keys.SSM.CONV_KERNEL.format(arch=self.arch), value)
 
