From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Odilitime <janesmith@airmail.cc>
Date: Sun, 12 Jul 2026 11:50:56 -0700
Subject: [PATCH] ggml-metal: partial OUT_PROD support (upstream #23724)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add Metal kernels for outer-product (f32 and q4_0/q4_1/q8_0/mxfp4 × f32)
so OUT_PROD stays on GPU instead of CPU fallback.
---
 ggml/src/ggml-metal/ggml-metal-device.cpp |  23 +++
 ggml/src/ggml-metal/ggml-metal-device.h   |   1 +
 ggml/src/ggml-metal/ggml-metal-device.m   |   9 ++
 ggml/src/ggml-metal/ggml-metal-impl.h     |  27 ++++
 ggml/src/ggml-metal/ggml-metal-ops.cpp    |  65 ++++++++
 ggml/src/ggml-metal/ggml-metal-ops.h      |   1 +
 ggml/src/ggml-metal/ggml-metal.metal      | 175 ++++++++++++++++++++++
 7 files changed, 301 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 4d3779f77..a3f31d9f9 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -2269,3 +2269,26 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_count_equal(ggml
 
     return res;
 }
+
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_out_prod(ggml_metal_library_t lib, const ggml_tensor *  op) {
+    GGML_ASSERT(op->op == GGML_OP_OUT_PROD);
+    GGML_ASSERT(op->src[0]->type == GGML_TYPE_F32 ||
+                op->src[0]->type == GGML_TYPE_Q4_0 || op->src[0]->type == GGML_TYPE_Q4_1 ||
+                op->src[0]->type == GGML_TYPE_Q8_0 || op->src[0]->type == GGML_TYPE_MXFP4);
+    GGML_ASSERT(op->src[1]->type == GGML_TYPE_F32);
+
+    char base[256];
+
+    snprintf(base, 256, "kernel_out_prod_%s_f32", ggml_type_name(op->src[0]->type));
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, base);
+
+    if (!res.pipeline) {
+        res = ggml_metal_library_compile_pipeline(lib, base, base, nullptr);
+    }
+
+    res.nsg = 1;
+    res.smem = (32 + 32) * sizeof(float);
+
+    return res;
+}
