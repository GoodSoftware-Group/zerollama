+// Drafts the tokens that followed the longest earlier copy of the current
+// suffix. The copy can be in this prompt or in an earlier request. A draft
+// that misses outright waits, and the wait doubles each time, so a stretch
+// of new text is not checked on every token.
+struct common_speculative_impl_session : public common_speculative_impl {
+    static constexpr int k_max_draft = 8;
+    static constexpr int k_max_pause = 16;
+
+    llama_session_index index;
+
+    struct seq_info {
+        size_t i_last = 0;
+        int draft_len = k_max_draft;
+        int pause = 0;
+        int paused_for = 0;
+        size_t n_draft_last = 0;
+    };
+
+    std::vector<seq_info> sinfos;
+
+    common_speculative_impl_session(uint32_t n_seq)
+        : common_speculative_impl(COMMON_SPECULATIVE_TYPE_SESSION, n_seq, k_max_draft) {
+        sinfos.resize(n_seq);
+        SPC_INF("%s", "session lookup drafts repeated text from earlier requests (LLAMA_RAD1=0 disables it)\n");
+    }
+
+    void feed(llama_seq_id seq_id, const llama_tokens & prompt) {
+        auto & s = sinfos[seq_id];
+        if (prompt.size() < s.i_last) {
+            s.i_last = 0;
+        }
+        if (prompt.size() <= s.i_last) {
+            return;
+        }
+        std::vector<uint32_t> fresh;
+        fresh.reserve(prompt.size() - s.i_last);
+        for (size_t i = s.i_last; i < prompt.size(); ++i) {
+            if (prompt[i] >= 0) {
+                fresh.push_back((uint32_t) prompt[i]);
+            }
+        }
+        index.extend(fresh.data(), fresh.size());
+        s.i_last = prompt.size();
+    }
+
+    void begin(llama_seq_id seq_id, const llama_tokens & prompt) override {
+        GGML_ASSERT(seq_id < (llama_seq_id) n_seq);
+        sinfos[seq_id].i_last = 0;
+        feed(seq_id, prompt);
+    }
+
+    bool process(const common_batch & /*batch*/) override {
+        return true;
+    }
+
+    void draft_one(llama_seq_id seq_id, common_speculative_draft_params & dp) {
+        auto & s = sinfos[seq_id];
+        auto & result = *dp.result;
+        feed(seq_id, *dp.prompt);
+        s.n_draft_last = 0;
+        if (s.paused_for > 0) {
+            s.paused_for--;
+            return;
+        }
+        if (dp.id_last < 0) {
+            return;
+        }
+        size_t limit = (size_t) s.draft_len;
+        if (dp.n_max > 0 && (size_t) dp.n_max < limit) {
+            limit = (size_t) dp.n_max;
+        }
+        if (limit == 0) {
+            return;
+        }
+        const std::vector<uint32_t> drafted = index.draft((uint32_t) dp.id_last, limit);
+        result.resize(drafted.size());
+        for (size_t i = 0; i < drafted.size(); ++i) {
+            result[i] = (llama_token) drafted[i];
+        }
+        s.n_draft_last = result.size();
+    }
+
+    void draft(common_speculative_draft_params_vec & dparams) override {
+        for (llama_seq_id seq_id = 0; seq_id < (llama_seq_id) n_seq; ++seq_id) {
+            auto & dp = dparams[seq_id];
+            if (!dp.drafting) {
+                continue;
+            }
+            draft_one(seq_id, dp);
+        }
+    }
+
+    void accept(llama_seq_id seq_id, uint16_t n_accepted, bool is_other) override {
+        if (is_other) {
+            return;
+        }
+        GGML_ASSERT(seq_id < (llama_seq_id) n_seq);
+        auto & s = sinfos[seq_id];
+        if (s.n_draft_last == 0) {
+            return;
+        }
+        if (n_accepted >= s.n_draft_last) {
+            s.draft_len = std::min(s.draft_len * 2, k_max_draft);
+        } else {
+            s.draft_len = (int) n_accepted + 1;
+        }
+        if (n_accepted == 0) {
+            s.pause = std::clamp(s.pause * 2, 1, k_max_pause);
+            s.paused_for = s.pause;
+        } else {
+            s.pause = 0;
+        }
+        s.n_draft_last = 0;
+    }
+};
+
