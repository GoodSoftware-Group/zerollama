 tools/server/server-context.cpp | 39 +++++++++++++++++++++++++++++++++
 tools/server/server-context.h   |  2 ++
 tools/server/server-task.h      | 12 ++++++++++
 tools/server/server.cpp         |  1 +
 8 files changed, 126 insertions(+)

