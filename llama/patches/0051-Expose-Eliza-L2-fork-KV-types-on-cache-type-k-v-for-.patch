From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Tue, 14 Jul 2026 02:06:02 -0700
Subject: [PATCH] Expose Eliza L2 fork KV types on --cache-type-k/v for unified
 pin.

Whitelist TBQ/QJL/Polar in kv_cache_types and alias --checkpoint-every-n-tokens
onto checkpoint_min_step so ZEROLLAMA_LLAMA_FORK profiles work on ggml-org.
---
 common/arg.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index 86f8610..fac7754 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -311,6 +311,14 @@ const std::vector<ggml_type> kv_cache_types = {
     GGML_TYPE_IQ4_NL,
     GGML_TYPE_Q5_0,
     GGML_TYPE_Q5_1,
+    // Eliza L2 fork KV types (patches 0026–0030): TurboQuant / QJL / PolarQuant.
+    GGML_TYPE_TBQ3_0,
+    GGML_TYPE_TBQ4_0,
+    GGML_TYPE_TBQ3_K,
+    GGML_TYPE_TBQ4_K,
+    GGML_TYPE_QJL1_256,
+    GGML_TYPE_Q4_POLAR,
+    GGML_TYPE_TBQ3_TCQ,
 };
 
 static ggml_type kv_cache_type_from_str(const std::string & s) {
@@ -1701,6 +1709,15 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.checkpoint_min_step = value;
         }
     ).set_env("LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT").set_examples({LLAMA_EXAMPLE_SERVER}));
+    // Eliza fork L2 profiles emit --checkpoint-every-n-tokens; map onto ggml-org's
+    // checkpoint_min_step so ZEROLLAMA_LLAMA_FORK=1 argv does not crash at startup.
+    add_opt(common_arg(
+        {"-cpent", "--checkpoint-every-n-tokens"}, "N",
+        string_format("alias for --checkpoint-min-step (eliza L2 profiles; default: %d, -1 disables → 0)", params.checkpoint_min_step),
+        [](common_params & params, int value) {
+            params.checkpoint_min_step = value < 0 ? 0 : value;
+        }
+    ).set_env("LLAMA_ARG_CHECKPOINT_EVERY_NT").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
     add_opt(common_arg(
         {"-cram", "--cache-ram"}, "N",
         string_format("set the maximum cache size in MiB (default: %d, -1 - no limit, 0 - disable)"
