+// L3-R6b — metadata + tensor copy-on-write (TAG_KV_CACHE_SHARE_CELLS).
+bool llama_kv_cache::kv_cow_enabled() {
+    static int cached = -1;
+    if (cached < 0) {
+        const char * e = getenv("ZEROLLAMA_KV_COW");
+        cached = (e && (e[0] == '1' || e[0] == 't' || e[0] == 'T' || e[0] == 'y' || e[0] == 'Y' ||
+                        (e[0] == 'o' && e[1] == 'n'))) ? 1 : 0;
+    }
+    return cached == 1;
+}
+
+bool llama_kv_cache::kv_cow_tensors_enabled() {
+    static int cached = -1;
+    if (cached < 0) {
+        const char * e = getenv("ZEROLLAMA_KV_COW_TENSORS");
+        cached = (e && (e[0] == '1' || e[0] == 't' || e[0] == 'T' || e[0] == 'y' || e[0] == 'Y' ||
+                        (e[0] == 'o' && e[1] == 'n'))) ? 1 : 0;
+    }
+    return cached == 1;
+}
+
+bool llama_kv_cache::kv_cow_pages_enabled() {
+    static int cached = -1;
+    if (cached < 0) {
+        const char * e = getenv("ZEROLLAMA_KV_COW_PAGES");
+        cached = (e && (e[0] == '1' || e[0] == 't' || e[0] == 'T' || e[0] == 'y' || e[0] == 'Y' ||
+                        (e[0] == 'o' && e[1] == 'n'))) ? 1 : 0;
+    }
+    return cached == 1;
+}
