+bool llama_kv_cache::layer_tensor_owned(const ggml_tensor * t) const {
+    if (!t || !t->buffer) {
+        return false;
+    }
+    for (const auto & [ctx, buf] : ctxs_bufs) {
+        GGML_UNUSED(ctx);
+        if (buf.get() == t->buffer) {
+            return true;
+        }
+    }
+    return false;
+}
