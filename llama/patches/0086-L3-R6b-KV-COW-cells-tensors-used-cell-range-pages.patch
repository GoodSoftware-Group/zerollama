+bool llama_kv_cache::ensure_unique_tensors(const char * reason) {
+    if (!layers_aliased) {
+        return true;
+    }
+    if (!kv_cow_tensors_enabled()) {
+        return false;
+    }
+
+    // Collect layers whose K/V still live in another cache's buffer.
+    std::vector<size_t> fork_idxs;
+    fork_idxs.reserve(layers.size());
+    for (size_t li = 0; li < layers.size(); ++li) {
+        if (layers[li].k && !layer_tensor_owned(layers[li].k)) {
+            fork_idxs.push_back(li);
+        }
+    }
+    if (fork_idxs.empty()) {
+        layers_aliased = false;
+        return true;
+    }
+
+    const bool is_mla = hparams.is_mla();
+    const uint32_t kv_size = get_size();
+    if (kv_size == 0) {
+        LLAMA_LOG_WARN("%s: COW tensor skip (%s) — empty kv_size\n", __func__, reason ? reason : "?");
+        return false;
+    }
+
+    struct ggml_backend_buft_comparator {
+        bool operator()(const ggml_backend_buffer_type_t & lhs, const ggml_backend_buffer_type_t & rhs) const {
+            return strcmp(ggml_backend_buft_name(lhs), ggml_backend_buft_name(rhs)) < 0;
+        }
+    };
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr, ggml_backend_buft_comparator> ctx_map;
+
+    auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it == ctx_map.end()) {
+            ggml_init_params params = {
+                /*.mem_size   =*/ size_t(2u * (1 + n_stream) * fork_idxs.size() * ggml_tensor_overhead()),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context * ctx = ggml_init(params);
+            if (!ctx) {
+                return nullptr;
+            }
+            ctx_map.emplace(buft, ctx);
+            return ctx;
+        }
+        return it->second.get();
+    };
+
+    struct pending_fork {
+        size_t        li = 0;
+        uint32_t      il = 0;
+        ggml_tensor * src_k = nullptr;
+        ggml_tensor * src_v = nullptr;
+        ggml_tensor * dst_k = nullptr;
+        ggml_tensor * dst_v = nullptr;
+        std::vector<ggml_tensor *> k_stream;
+        std::vector<ggml_tensor *> v_stream;
+    };
+    std::vector<pending_fork> pending;
+    pending.reserve(fork_idxs.size());
+
+    for (size_t li : fork_idxs) {
+        const kv_layer & layer = layers[li];
+        ggml_tensor * src_k = layer.k;
+        ggml_tensor * src_v = layer.v;
+        GGML_ASSERT(src_k && src_k->buffer);
+
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(src_k->buffer);
+        ggml_context * ctx = ctx_for_buft(buft);
+        if (!ctx) {
+            LLAMA_LOG_ERROR("%s: COW tensor fork failed (%s) — ggml_init\n", __func__, reason ? reason : "?");
+            return false;
+        }
+
+        const uint32_t il = layer.il;
+        const uint32_t n_embd_k_gqa = hparams.n_embd_k_gqa(il);
+        const uint32_t n_embd_v_gqa = !v_trans ? hparams.n_embd_v_gqa(il) : hparams.n_embd_v_gqa_max();
+        const bool has_v = !is_mla && src_v != nullptr;
+
+        ggml_tensor * k = ggml_new_tensor_3d(ctx, src_k->type, n_embd_k_gqa, kv_size, n_stream);
+        ggml_tensor * v = has_v ? ggml_new_tensor_3d(ctx, src_v->type, n_embd_v_gqa, kv_size, n_stream) : nullptr;
+        ggml_format_name(k, "cache_k_cow_l%d", il);
+        if (v) {
+            ggml_format_name(v, "cache_v_cow_l%d", il);
+        }
+
+        pending_fork pf;
+        pf.li = li;
+        pf.il = il;
+        pf.src_k = src_k;
+        pf.src_v = src_v;
+        pf.dst_k = k;
+        pf.dst_v = v;
+        pf.k_stream.reserve(n_stream);
+        pf.v_stream.reserve(n_stream);
+        for (uint32_t s = 0; s < n_stream; ++s) {
+            pf.k_stream.push_back(ggml_view_2d(ctx, k, n_embd_k_gqa, kv_size, k->nb[1], s * k->nb[2]));
+            pf.v_stream.push_back(v ? ggml_view_2d(ctx, v, n_embd_v_gqa, kv_size, v->nb[1], s * v->nb[2]) : nullptr);
+        }
+        pending.push_back(std::move(pf));
+    }
+
+    // Allocate private buffers before rebinding layers (all-or-nothing).
+    std::vector<std::pair<ggml_context_ptr, ggml_backend_buffer_ptr>> new_bufs;
+    new_bufs.reserve(ctx_map.size());
+    for (auto & [buft, ctx] : ctx_map) {
+        ggml_backend_buffer_t buf = nullptr;
+        if (hparams.no_alloc) {
+            buf = ggml_backend_buft_alloc_buffer(buft, /*size =*/ 0);
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t != nullptr; t = ggml_get_next_tensor(ctx.get(), t)) {
+                t->buffer = buf;
+            }
+        } else {
+            buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft);
+        }
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: COW tensor fork failed (%s) — buffer alloc (%s)\n",
+                    __func__, reason ? reason : "?", ggml_backend_buft_name(buft));
+            return false; // pending tensors die with ctx_map; layers unchanged
+        }
+        LLAMA_LOG_INFO("%s: COW tensor buffer %s = %8.2f MiB (%s)\n",
+                __func__, ggml_backend_buffer_name(buf),
+                ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0,
+                reason ? reason : "?");
+        // Zero so unused cells are defined when pages mode copies only used spans.
+        if (!hparams.no_alloc) {
+            ggml_backend_buffer_clear(buf, 0);
+        }
+        new_bufs.emplace_back(std::move(ctx), buf);
+    }
+
+    const bool pages = kv_cow_pages_enabled();
+    size_t pages_bytes = 0;
+
+    // Commit: rebind layers, then copy from donor (full tensor or used-cell ranges).
+    for (auto & pf : pending) {
+        const kv_layer & old_layer = layers[pf.li];
+        if (pages) {
+            for (uint32_t s = 0; s < n_stream; ++s) {
+                const cell_ranges_t cr = build_used_cell_ranges(s);
+                uint32_t used_cells = 0;
+                for (const auto & r : cr.data) {
+                    used_cells += r.second - r.first;
+                }
+                const bool dense = kv_size > 0 && (used_cells * 5 >= kv_size * 4); // ≥80%
+                if (cr.data.empty()) {
+                    continue;
+                }
+                if (dense) {
+                    if (old_layer.k_stream[s] && pf.k_stream[s]) {
+                        ggml_backend_tensor_copy(old_layer.k_stream[s], pf.k_stream[s]);
+                        pages_bytes += ggml_nbytes(pf.k_stream[s]);
+                    }
+                    if (old_layer.v_stream[s] && pf.v_stream[s]) {
+                        ggml_backend_tensor_copy(old_layer.v_stream[s], pf.v_stream[s]);
+                        pages_bytes += ggml_nbytes(pf.v_stream[s]);
+                    }
+                } else {
+                    if (old_layer.k_stream[s] && pf.k_stream[s]) {
+                        pages_bytes += copy_tensor_cell_ranges(old_layer.k_stream[s], pf.k_stream[s], cr, /*is_v=*/false);
+                    }
+                    if (old_layer.v_stream[s] && pf.v_stream[s]) {
+                        pages_bytes += copy_tensor_cell_ranges(old_layer.v_stream[s], pf.v_stream[s], cr, /*is_v=*/true);
+                    }
+                }
+            }
+        } else {
+            if (pf.dst_k && pf.src_k) {
+                ggml_backend_tensor_copy(pf.src_k, pf.dst_k);
+            }
+            if (pf.dst_v && pf.src_v) {
+                ggml_backend_tensor_copy(pf.src_v, pf.dst_v);
+            }
+        }
+        layers[pf.li] = { pf.il, pf.dst_k, pf.dst_v, std::move(pf.k_stream), std::move(pf.v_stream) };
+    }
+    for (auto & nb : new_bufs) {
+        ctxs_bufs.emplace_back(std::move(nb));
+    }
+
+    layers_aliased = false;
+    ++cow_tensor_forks_total;
+    if (pages) {
+        cow_pages_bytes_copied += pages_bytes;
+        LLAMA_LOG_INFO("%s: COW fork tensors pages (%s) layers=%zu bytes=%zu forks=%llu\n",
+                __func__, reason ? reason : "?", fork_idxs.size(), pages_bytes,
+                (unsigned long long) cow_tensor_forks_total);
+    } else {
+        LLAMA_LOG_INFO("%s: COW fork tensors (%s) layers=%zu forks=%llu\n",
+                __func__, reason ? reason : "?", fork_idxs.size(),
+                (unsigned long long) cow_tensor_forks_total);
+    }
+    return true;
+}
