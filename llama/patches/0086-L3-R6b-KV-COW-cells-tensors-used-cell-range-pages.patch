+llama_kv_cache::cell_ranges_t llama_kv_cache::build_used_cell_ranges(uint32_t strm) const {
+    cell_ranges_t cr { strm, {} };
+    const auto & cells = (*v_cells)[strm];
+    uint32_t begin = cells.size();
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (!cells.is_empty(i)) {
+            if (begin == cells.size()) {
+                begin = i;
+            }
+        } else if (begin != cells.size()) {
+            cr.data.emplace_back(begin, i);
+            begin = cells.size();
+        }
+    }
+    if (begin != cells.size()) {
+        cr.data.emplace_back(begin, cells.size());
+    }
+    return cr;
+}
+
+static void cow_copy_bytes(const ggml_tensor * src, ggml_tensor * dst, size_t offset, size_t size) {
+    if (size == 0) {
+        return;
+    }
+    if (src->buffer && dst->buffer &&
+            ggml_backend_buffer_is_host(src->buffer) &&
+            ggml_backend_buffer_is_host(dst->buffer) &&
+            src->data && dst->data) {
+        memcpy((char *) dst->data + offset, (const char *) src->data + offset, size);
+        return;
+    }
+    std::vector<uint8_t> tmp(size);
+    ggml_backend_tensor_get(src, tmp.data(), offset, size);
+    ggml_backend_tensor_set(dst, tmp.data(), offset, size);
+}
+
+size_t llama_kv_cache::copy_tensor_cell_ranges(
+        const ggml_tensor * src,
+              ggml_tensor * dst,
+        const cell_ranges_t & cr,
+        bool is_v) const {
+    if (!src || !dst || cr.data.empty()) {
+        return 0;
+    }
+
+    size_t bytes = 0;
+    if (!is_v || !v_trans) {
+        // Contiguous rows: offset = cell * row_size
+        const size_t row = src->nb[1];
+        for (const auto & range : cr.data) {
+            const size_t n = range.second - range.first;
+            const size_t off = (size_t) range.first * row;
+            const size_t sz = n * row;
+            cow_copy_bytes(src, dst, off, sz);
+            bytes += sz;
+        }
+        return bytes;
+    }
+
+    // v_trans: per-embedding-row scatter (matches state_write_data)
+    const uint32_t kv_size = (uint32_t) src->ne[1]; // cells along dim1 for stream view
+    const uint32_t n_embd = (uint32_t) src->ne[0];
+    const size_t el = ggml_type_size(src->type);
+    for (uint32_t j = 0; j < n_embd; ++j) {
+        for (const auto & range : cr.data) {
+            const size_t n = range.second - range.first;
+            const size_t off = ((size_t) range.first + (size_t) j * kv_size) * el;
+            const size_t sz = n * el;
+            cow_copy_bytes(src, dst, off, sz);
+            bytes += sz;
+        }
+    }
+    return bytes;
+}
