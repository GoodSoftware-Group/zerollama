+bool llama_kv_cache::ensure_unique_cells(const char * reason) {
+    const bool shared = (other != nullptr) || (v_cells_impl && v_cells_impl.use_count() > 1);
+    if (!shared && !layers_aliased) {
+        return true;
+    }
+    if (!kv_cow_enabled()) {
+        return false;
+    }
+    if (layers_aliased) {
+        if (!ensure_unique_tensors(reason)) {
+            LLAMA_LOG_WARN("%s: COW skip (%s) — K/V still aliased; set ZEROLLAMA_KV_COW_TENSORS=1 for tensor fork\n",
+                    __func__, reason ? reason : "?");
+            return false;
+        }
+    }
+    if (!shared) {
+        return true;
+    }
+    // Deep-copy cell metadata into a private vector; detach from sibling cache.
+    v_cells_impl = std::make_shared<llama_kv_cells_vec>(*v_cells_impl);
+    v_cells = v_cells_impl.get();
+    other = nullptr;
+    ++cow_forks_total;
+    LLAMA_LOG_INFO("%s: COW fork cells (%s) forks=%llu\n",
+            __func__, reason ? reason : "?", (unsigned long long) cow_forks_total);
+    return true;
+}
