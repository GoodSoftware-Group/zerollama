From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Odilitime <janesmith@airmail.cc>
Date: Tue, 14 Jul 2026 02:31:57 -0700
Subject: [PATCH] Metal SET_ROWS for TBQ KV + CPU type_traits; TBQ4 flash-attn
 dequant.

Unblocks Apple L2 fork profiles (tbq4_0/tbq3_0) on unified ggml-org pin
after SET_ROWS abort on Metal-preallocated cache tensors. Stage ane bridge
@rpath for lab probes without DYLD_LIBRARY_PATH.
---
 common/CMakeLists.txt                         |   9 +
 ggml/src/ggml-cpu/ggml-cpu.c                  |  12 ++
 ggml/src/ggml-cpu/quants.c                    |  78 +++++++
 ggml/src/ggml-cpu/quants.h                    |  10 +
 ggml/src/ggml-metal/CMakeLists.txt            |   3 +
 .../eliza-shipped/tbq_set_rows.metal          | 204 ++++++++++++++++++
 ggml/src/ggml-metal/ggml-metal-device.m       |   3 +
 ggml/src/ggml-metal/ggml-metal.metal          | 105 +++++++++
 src/llama-graph.cpp                           |   9 +-
 9 files changed, 430 insertions(+), 3 deletions(-)
 create mode 100644 ggml/src/ggml-metal/eliza-shipped/tbq_set_rows.metal

diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index cec50b97f..9e8c650e4 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -200,6 +200,15 @@ if (APPLE AND EXISTS "${_ZEROLLAMA_ANE_BRIDGE}")
         "-framework Foundation"
         "-framework IOSurface"
         "-framework Metal")
+    # Bare `libane_bridge.dylib` install name breaks dyld unless cwd/DYLD is set.
+    # Copy beside llama-server and rewrite to @rpath so L2 probes and serve work.
+    add_custom_command(TARGET ${TARGET} POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/bin"
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${_ZEROLLAMA_ANE_BRIDGE}" "${CMAKE_BINARY_DIR}/bin/libane_bridge.dylib"
+        COMMAND install_name_tool -change libane_bridge.dylib @rpath/libane_bridge.dylib
+            "$<TARGET_FILE:${TARGET}>"
+        COMMENT "ANE: stage libane_bridge + @rpath install name")
     message(STATUS "llama-common: ANE draft session enabled (${_ZEROLLAMA_ANE_BRIDGE})")
 else()
     target_sources(${TARGET} PRIVATE
