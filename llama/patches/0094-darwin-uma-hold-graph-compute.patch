From 6759674cb0dcfad20d9b5fa6b7639723200f341e Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Wed, 22 Jul 2026 23:25:07 -0700
Subject: [PATCH] Darwin UMA HOLD_GPU around llama_context::graph_compute
 (zerollama M22).

Link libuma_client into libllama via ZEROLLAMA_UMA; acquire in
llama_backend_init (single glue copy); sync under HOLD so RELEASE cannot
race Metal drain.
---
 src/CMakeLists.txt    | 11 +++++++++++
 src/llama-context.cpp | 26 ++++++++++++++++++++++++++
 src/llama.cpp         | 20 ++++++++++++++++++++
 3 files changed, 57 insertions(+)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index f4cfb133..cc031cec 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -60,6 +60,17 @@ target_compile_features   (llama PRIVATE cxx_std_17) # don't bump
 
 target_link_libraries(llama PUBLIC ggml)
 
+# zerollama M22: optional UMA broker client for Darwin Metal admission (libuma_client only).
+if (ZEROLLAMA_UMA)
+    if (NOT ZEROLLAMA_UMA_INCLUDE OR NOT ZEROLLAMA_UMA_LIB)
+        message(FATAL_ERROR "ZEROLLAMA_UMA=ON requires -DZEROLLAMA_UMA_INCLUDE=... and -DZEROLLAMA_UMA_LIB=...")
+    endif()
+    target_compile_definitions(llama PRIVATE ZEROLLAMA_UMA=1)
+    target_include_directories(llama PRIVATE "${ZEROLLAMA_UMA_INCLUDE}")
+    target_link_libraries(llama PRIVATE "${ZEROLLAMA_UMA_LIB}")
+    message(STATUS "ZEROLLAMA_UMA: linking ${ZEROLLAMA_UMA_LIB}")
+endif()
+
 if (BUILD_SHARED_LIBS)
     set_target_properties(llama PROPERTIES POSITION_INDEPENDENT_CODE ON)
     target_compile_definitions(llama PRIVATE LLAMA_BUILD)
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index da9c4cd8..71cc7c88 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -12,6 +12,10 @@
 #include "llama-ext.h"
 #include "llama.h"
 
+#if defined(ZEROLLAMA_UMA)
+#include "uma_glue.h"
+#endif
+
 #include <cinttypes>
 #include <cmath>
 #include <cstring>
@@ -2497,11 +2501,33 @@ ggml_status llama_context::graph_compute(
         set_n_threads_fn.second(set_n_threads_fn.first, n_threads);
     }
 
+#if defined(ZEROLLAMA_UMA)
+    // Admission only: HOLD_GPU around Metal graph compute + drain (M21 lesson —
+    // RELEASE must not race ggml_backend_sched_synchronize).
+    const char * uma_phase = batched ? "prefill" : "decode";
+    const bool uma_gate = uma_mlx_runtime_enabled();
+    if (uma_gate) {
+        if (uma_mlx_lease_begin(uma_phase) != 0) {
+            LLAMA_LOG_ERROR("%s: uma lease begin (%s) failed: %s\n", __func__, uma_phase, uma_mlx_last_error());
+            return GGML_STATUS_FAILED;
+        }
+    }
+#endif
+
     auto status = ggml_backend_sched_graph_compute_async(sched.get(), gf);
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: ggml_backend_sched_graph_compute_async failed with error %d\n", __func__, status);
     }
 
+#if defined(ZEROLLAMA_UMA)
+    if (uma_gate) {
+        if (status == GGML_STATUS_SUCCESS) {
+            ggml_backend_sched_synchronize(sched.get());
+        }
+        uma_mlx_lease_end();
+    }
+#endif
+
     // fprintf(stderr, "splits: %d\n", ggml_backend_sched_get_n_splits(sched));
 
     return status;
diff --git a/src/llama.cpp b/src/llama.cpp
index 0de6048f..7d0321fc 100644
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -15,6 +15,11 @@
 #include "ggml-backend.h"
 #include "gguf.h"
 
+#if defined(ZEROLLAMA_UMA)
+#include "uma_glue.h"
+#include <cstdlib>
+#endif
+
 #include <algorithm>
 #include <cassert>
 #include <cinttypes>
@@ -99,6 +104,18 @@ void llama_backend_init(void) {
     if (!ggml_backend_reg_count()) {
         ggml_backend_load_all();
     }
+
+#if defined(ZEROLLAMA_UMA)
+    // Single copy of uma glue lives in libllama — acquire here so graph_compute
+    // leases share the same broker client (do not also link uma into the exe).
+    if (getenv("UMA_JOB_NAME") == nullptr && getenv("UMA_PROJECT") == nullptr) {
+        setenv("UMA_JOB_NAME", "llama-server", 1);
+    }
+    if (uma_mlx_acquire() != 0) {
+        fprintf(stderr, "uma broker: %s\n", uma_mlx_last_error());
+        abort();
+    }
+#endif
 }
 
 void llama_numa_init(enum ggml_numa_strategy numa) {
@@ -114,6 +131,9 @@ void llama_numa_init(enum ggml_numa_strategy numa) {
 }
 
 void llama_backend_free(void) {
+#if defined(ZEROLLAMA_UMA)
+    uma_mlx_release();
+#endif
     ggml_quantize_free();
 }
 
