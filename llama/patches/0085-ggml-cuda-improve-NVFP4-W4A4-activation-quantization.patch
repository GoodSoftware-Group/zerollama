 ggml/src/ggml-cuda/mmq.cuh      | 107 +++++++++--
 ggml/src/ggml-cuda/quantize.cu  | 323 +++++++++++++++++++++++---------
 ggml/src/ggml-cuda/quantize.cuh |   4 +
 4 files changed, 361 insertions(+), 114 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 58fd22d8..352b21e4 100644
