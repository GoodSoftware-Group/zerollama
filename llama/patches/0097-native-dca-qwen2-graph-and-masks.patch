+void llama_kv_cache::set_input_kq_mask_dca(ggml_tensor * dst, const llama_ubatch * ubatch, int dca_stage) const {
+    const uint32_t n_tokens = ubatch->n_tokens;
+
+    GGML_ASSERT(ggml_backend_buffer_is_host(dst->buffer));
+    GGML_ASSERT(hparams.dca_enabled());
+    GGML_ASSERT(dca_stage >= 0 && dca_stage <= 2);
+
+    const int64_t n_kv     = dst->ne[0];
+    const int64_t n_stream = dst->ne[3];
+    GGML_ASSERT(n_tokens % n_stream == 0);
+    const int64_t n_tps = n_tokens / n_stream;
+
+    const uint32_t c_len = hparams.dca_chunk_len();
+    const llama_dca::mask_kind kind =
+        dca_stage == 0 ? llama_dca::mask_kind::INTRA :
+        dca_stage == 1 ? llama_dca::mask_kind::SUCC  :
+                         llama_dca::mask_kind::INTER;
+
+    auto fill = [&](auto * data) {
+        using T = std::remove_reference_t<decltype(*data)>;
+        const T mask_keep = llama_cast<T>(0.0f);
+        const T mask_drop = llama_cast<T>(-INFINITY);
+
+        for (uint32_t s = 0; s < n_stream; ++s) {
+            for (uint32_t ii = 0; ii < n_tps; ++ii) {
+                const uint32_t i = s * n_tps + ii;
+                const llama_seq_id seq_id = ubatch->seq_id[i][0];
+                const auto & cells = (*v_cells).at(seq_to_stream[seq_id]);
+                const llama_pos p1 = ubatch->pos[i];
+                const uint64_t idst = n_kv * i;
+
