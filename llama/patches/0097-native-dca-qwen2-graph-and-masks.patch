+    inp->self_kq_mask_intra = build_attn_inp_kq_mask(ctx0, mctx_cur, ubatch, cparams);
+    inp->self_kq_mask_succ  = build_attn_inp_kq_mask(ctx0, mctx_cur, ubatch, cparams);
