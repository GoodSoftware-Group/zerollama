From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 24 Jul 2026 18:59:05 -0700
Subject: [PATCH] Darwin UMA HOLD_ANE around ane_draft_session eval (zerollama
 M23).
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Admission only: lease ANE while in-process draft eval runs. Independent of
HOLD_GPU (Metal decode ∥ ANE draft). Resolve uma_* via dlsym(RTLD_DEFAULT)
into libllama's single libuma glue (M22) — do not static-link libuma into
llama-common (duplicate g_client).
---
 common/CMakeLists.txt       |  8 +++++++
 common/ane_draft_session.mm | 42 ++++++++++++++++++++++++++++++++++++-
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index f1a8ffa..809a8e8 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -220,3 +220,11 @@ else()
         message(STATUS "llama-common: ANE draft session stub (missing ${_ZEROLLAMA_ANE_BRIDGE})")
     endif()
 endif()
+
+# zerollama M23: HOLD_ANE around ane_draft_session eval via dlsym→libllama uma.
+# Do not link libuma into common (duplicate g_client vs M22 llama link).
+if (ZEROLLAMA_UMA)
+    target_compile_definitions(${TARGET} PRIVATE ZEROLLAMA_UMA=1)
+    message(STATUS "llama-common: ZEROLLAMA_UMA HOLD_ANE for ane_draft_session (dlsym)")
+endif()
+
diff --git a/common/ane_draft_session.mm b/common/ane_draft_session.mm
index 2215d5c..ec55026 100644
--- a/common/ane_draft_session.mm
+++ b/common/ane_draft_session.mm
@@ -14,6 +14,10 @@
 #include "ane_bridge.h"
 #include "log.h"
 
+#if defined(ZEROLLAMA_UMA)
+#include <dlfcn.h>
+#endif
+
 #include <cstdlib>
 #include <cmath>
 #include <vector>
@@ -3264,7 +3268,7 @@ static bool ane_session_init_dflash_chain17(int seq) {
     return true;
 }
 
-static bool ane_session_eval(void) {
+static bool ane_session_eval_ungated(void) {
     if (g_session.dflashChain13Active || g_session.dflashChain12Active) {
         return ane_session_eval_dflash_chain12(g_session.sp);
     }
@@ -3448,6 +3452,42 @@ static bool ane_session_eval(void) {
     return true;
 }
 
+
+/* Admission: HOLD_ANE around ANE eval (F0390). Independent of HOLD_GPU so
+ * Metal decode ∥ ANE draft is allowed. Resolve uma_* via dlsym so
+ * libllama-common does not static-link a second libuma copy (duplicate g_client);
+ * symbols live in libllama (M22). No-op when UMA off / not in process. */
+static bool ane_session_eval(void) {
+#if defined(ZEROLLAMA_UMA)
+    typedef int (*uma_runtime_fn)(void);
+    typedef int (*uma_begin_fn)(const char *, const char *);
+    typedef void (*uma_end_fn)(const char *);
+    typedef const char *(*uma_err_fn)(void);
+    static uma_runtime_fn runtime_enabled;
+    static uma_begin_fn lease_begin;
+    static uma_end_fn lease_end;
+    static uma_err_fn last_error;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        runtime_enabled = (uma_runtime_fn)dlsym(RTLD_DEFAULT, "uma_mlx_runtime_enabled");
+        lease_begin = (uma_begin_fn)dlsym(RTLD_DEFAULT, "uma_mlx_lease_begin_unit");
+        lease_end = (uma_end_fn)dlsym(RTLD_DEFAULT, "uma_mlx_lease_end_unit");
+        last_error = (uma_err_fn)dlsym(RTLD_DEFAULT, "uma_mlx_last_error");
+    });
+    if (runtime_enabled && lease_begin && lease_end && runtime_enabled()) {
+        if (lease_begin("ane", "draft") != 0) {
+            const char * err = last_error ? last_error() : "HOLD_ANE failed";
+            LOG_ERR("%s: uma HOLD_ANE failed: %s\n", __func__, err ? err : "?");
+            return false;
+        }
+        const bool ok = ane_session_eval_ungated();
+        lease_end("ane");
+        return ok;
+    }
+#endif
+    return ane_session_eval_ungated();
+}
+
 int ane_draft_session_channels(void) {
     return g_session.ch;
 }
