From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Sun, 12 Jul 2026 11:55:26 -0700
Subject: [PATCH] fix: sync llama_kv_cache.h with shared-cells constructor

Align the public constructor and storage accessors with the in-tree
implementation used by Phase 15 / hybrid memory.
---
 src/llama-kv-cache.h | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 17ab9e3..085b384 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -5,6 +5,7 @@
 #include "llama-kv-cells.h"
 #include "llama-memory.h"
 
+#include <memory>
 #include <unordered_map>
 #include <vector>
 
@@ -95,6 +96,7 @@ public:
 
     llama_kv_cache(
             const llama_model & model,
+          const llama_hparams & hparams,
                     ggml_type   type_k,
                     ggml_type   type_v,
                          bool   v_trans,
@@ -105,9 +107,10 @@ public:
                      uint32_t   n_pad,
                      uint32_t   n_swa,
                llama_swa_type   swa_type,
+               llama_memory_t   mem_other,
         const layer_filter_cb & filter,
         const  layer_reuse_cb & reuse,
-                     uint32_t   kv_size_max = 0);
+        const  layer_share_cb & share);
 
     ~llama_kv_cache() = default;
 
@@ -157,6 +160,9 @@ public:
     ggml_type type_k() const;
     ggml_type type_v() const;
 
+    std::vector<uint32_t> get_layer_ids() const;
+    ggml_tensor * get_k_storage(int32_t il) const;
+
     // zerollama Phase 15 v20: external PA page bind helpers (llama-kv-ext.h)
     int32_t  cell_index_for(llama_seq_id seq_id, llama_pos pos, uint32_t * out_stream = nullptr) const;
     uint32_t n_kv_layers() const;
@@ -276,7 +282,10 @@ private:
     // note: this is not part of the KV state and it's only used to speed-up the find_slot() method
     std::vector<uint32_t> v_heads;
 
-    std::vector<llama_kv_cells> v_cells;
+    llama_kv_cache * other = nullptr;
+
+    std::shared_ptr<llama_kv_cells_vec> v_cells_impl;
+    llama_kv_cells_vec & v_cells;
 
     // maps from a sequence id to a stream id
     std::vector<uint32_t> seq_to_stream;
