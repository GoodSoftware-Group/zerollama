From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Sat, 24 Oct 2026 20:34:43 -0700
Subject: [PATCH] ollama: wire ANE draft sources into llama-common CMake

---
 common/CMakeLists.txt     |  2 ++
 common/CMakeLists.txt.rej | 35 +++++++++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+)
 create mode 100644 common/CMakeLists.txt.rej

diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index 8e3c88dac..779e5532b 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -59,6 +59,8 @@ add_library(${TARGET}
     ${LLAMA_CHAT_PARSERS_SOURCES}
     arg.cpp
     arg.h
+    ane_draft_hook.cpp
+    ane_draft_hook.h
     base64.hpp
     chat-auto-parser-generator.cpp
     chat-auto-parser-helpers.cpp
diff --git a/common/CMakeLists.txt.rej b/common/CMakeLists.txt.rej
new file mode 100644
index 000000000..d3adbb781
--- /dev/null
+++ b/common/CMakeLists.txt.rej
@@ -0,0 +1,35 @@
+diff a/common/CMakeLists.txt b/common/CMakeLists.txt	(rejected hunks)
+@@ -184,3 +186,33 @@ if (LLAMA_LLGUIDANCE)
+ endif()
+ 
+ target_link_libraries(${TARGET} PUBLIC llama Threads::Threads)
++
++# B1: in-process ANE draft session (Darwin + libane_bridge only).
++set(_ZEROLLAMA_ANE_REPO "$ENV{HOME}/Sites/inference/ane")
++if (DEFINED ENV{ANE_REPO})
++    set(_ZEROLLAMA_ANE_REPO "$ENV{ANE_REPO}")
++endif()
++set(_ZEROLLAMA_ANE_BRIDGE "${_ZEROLLAMA_ANE_REPO}/bridge/libane_bridge.dylib")
++
++if (APPLE AND EXISTS "${_ZEROLLAMA_ANE_BRIDGE}")
++    target_sources(${TARGET} PRIVATE
++        ane_draft_session.mm
++        ane_draft_session.h
++        ane_iosurface_map.h)
++    target_compile_definitions(${TARGET} PRIVATE LLAMA_ANE_DRAFT_SESSION=1)
++    target_include_directories(${TARGET} PRIVATE "${_ZEROLLAMA_ANE_REPO}/bridge")
++    target_link_directories(${TARGET} PRIVATE "${_ZEROLLAMA_ANE_REPO}/bridge")
++    target_link_libraries(${TARGET} PRIVATE
++        ane_bridge
++        "-framework Foundation"
++        "-framework IOSurface"
++        "-framework Metal")
++    message(STATUS "llama-common: ANE draft session enabled (${_ZEROLLAMA_ANE_BRIDGE})")
++else()
++    target_sources(${TARGET} PRIVATE
++        ane_draft_session_stub.cpp
++        ane_draft_session.h)
++    if (APPLE)
++        message(STATUS "llama-common: ANE draft session stub (missing ${_ZEROLLAMA_ANE_BRIDGE})")
++    endif()
++endif()
