+static bool llama_tensor_is_host_weight(const ggml_tensor * t) {
+    return t != nullptr && t->buffer != nullptr &&
+        ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+        ggml_backend_buffer_is_host(t->buffer);
+}
+
+// True when a layer keeps every routed expert in host memory, which is the
+// case Flywheel can cache on the device.
+static bool llama_model_has_host_moe(const llama_model & model) {
+    if (model.hparams.n_expert == 0) {
+        return false;
+    }
+    for (const llama_layer & layer : model.layers) {
+        const ggml_tensor * experts[] = { layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps };
+        bool any = false;
+        bool all_host = true;
+        for (const ggml_tensor * t : experts) {
+            if (t == nullptr) {
+                continue;
+            }
+            any = true;
+            if (!llama_tensor_is_host_weight(t)) {
+                all_host = false;
+            }
+        }
+        if (any && all_host) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Memory left on the GPUs after the weights, the KV cache and the compute
+// buffers, minus the reserve the driver and a later graph still need.
+static size_t llama_flywheel_budget(const std::vector<ggml_backend_ptr> & backends) {
+    size_t budget = 0;
+    for (const auto & backend : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
+        const auto dev_type = ggml_backend_dev_type(dev);
+        if (dev_type != GGML_BACKEND_DEVICE_TYPE_GPU && dev_type != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            continue;
+        }
+        size_t free = 0;
+        size_t total = 0;
+        ggml_backend_dev_memory(dev, &free, &total);
+        if (free > LLAMA_FLYWHEEL_RESERVE) {
+            budget += free - LLAMA_FLYWHEEL_RESERVE;
+        }
+    }
+    return budget;
+}
