From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Odilitime <janesmith@airmail.cc>
Date: Sat, 27 Jun 2026 22:03:57 -0700
Subject: [PATCH] fix: cell_index_for + stage Ollama compat in CMake

---
 src/CMakeLists.txt        | 3 +++
 src/llama-kv-cache.cpp    | 4 ----
 tools/mtmd/CMakeLists.txt | 2 ++
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index e43104a..0d75522 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -38,6 +38,8 @@ add_library(llama
             llama-vocab.cpp
             unicode-data.cpp
             unicode.cpp
+            ollama-compat/llama-ollama-compat.cpp
+            ollama-compat/llama-ollama-compat-util.cpp
             unicode.h
             ${LLAMA_MODELS_SOURCES}
             # milady: DFlash draft model
@@ -53,6 +55,7 @@ set_target_properties(llama PROPERTIES
 )
 
 target_include_directories(llama PRIVATE .)
+target_include_directories(llama PRIVATE ollama-compat)
 target_include_directories(llama PUBLIC ../include)
 target_compile_features   (llama PRIVATE cxx_std_17) # don't bump
 
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index e4bf025..ef45bdd 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -634,10 +634,6 @@ llama_pos llama_kv_cache::seq_pos_max(llama_seq_id seq_id) const {
 }
 
 int32_t llama_kv_cache::cell_index_for(llama_seq_id seq_id, llama_pos pos, uint32_t * out_stream) const {
-    if (other) {
-        return other->cell_index_for(seq_id, pos, out_stream);
-    }
-
     if (seq_id < 0 || (size_t) seq_id >= seq_to_stream.size()) {
         return -1;
     }
diff --git a/tools/mtmd/CMakeLists.txt b/tools/mtmd/CMakeLists.txt
index 294ff61..38c80c6 100644
--- a/tools/mtmd/CMakeLists.txt
+++ b/tools/mtmd/CMakeLists.txt
@@ -56,6 +56,8 @@ target_link_libraries     (mtmd PRIVATE Threads::Threads)
 target_include_directories(mtmd PUBLIC  .)
 target_include_directories(mtmd PRIVATE ../..)
 target_include_directories(mtmd PRIVATE ../../vendor)
+target_include_directories(mtmd PRIVATE ../../src/ollama-compat)
+target_compile_definitions(mtmd PRIVATE OLLAMA_COMPAT_MTMD_BUILD)
 target_compile_features   (mtmd PRIVATE cxx_std_17)
 
 if (BUILD_SHARED_LIBS)
