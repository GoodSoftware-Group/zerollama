@@ -1576,6 +1576,33 @@ bool ggml_metal_device_supports_op(ggml_metal_device_t dev, const struct ggml_te
                 const int64_t H = op->src[0]->ne[1];
                 return op->src[4]->type == GGML_TYPE_F32 && C % H == 0 && (C / H == 64 || C / H == 128);
