 .../eliza-shipped/fused_attn_qjl_polar.metal  |  10 +-
 .../eliza-shipped/qjl_set_rows.metal          |  26 ++++
 ggml/src/ggml-metal/ggml-metal-device.cpp     |  21 +++
 ggml/src/ggml-metal/ggml-metal-device.h       |   2 +
 ggml/src/ggml-metal/ggml-metal-device.m       |  27 ++++
 ggml/src/ggml-metal/ggml-metal-impl.h         |  16 ++
 ggml/src/ggml-metal/ggml-metal-ops.cpp        | 139 ++++++++++++++++++
 ggml/src/ggml-metal/ggml-metal-ops.h          |   3 +
 ggml/src/ggml-metal/ggml-metal.cpp            |   4 +
 10 files changed, 250 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-metal/CMakeLists.txt b/ggml/src/ggml-metal/CMakeLists.txt
index 7cc9d1c30..4c8ed3e83 100644
--- a/ggml/src/ggml-metal/CMakeLists.txt
+++ b/ggml/src/ggml-metal/CMakeLists.txt
@@ -47,6 +47,7 @@ if (GGML_METAL_EMBED_LIBRARY)
     # JIT-compiled — so append the QJL encode body (projection + kernels) here.
     # Skip duplicate includes/structs (block_qjl1_256 + kargs come from common/impl).
     set(METALLIB_QJL_SET_ROWS "${CMAKE_CURRENT_SOURCE_DIR}/eliza-shipped/qjl_set_rows.metal")
+    set(METALLIB_FUSED_POLAR  "${CMAKE_CURRENT_SOURCE_DIR}/eliza-shipped/fused_attn_qjl_polar.metal")
 
     add_custom_command(
         OUTPUT "${METALLIB_EMBED_ASM}"
@@ -54,15 +55,18 @@ if (GGML_METAL_EMBED_LIBRARY)
         COMMAND sed -e "/__embed_ggml-common.h__/r ${METALLIB_COMMON}"       -e "/__embed_ggml-common.h__/d"         < "${METALLIB_SOURCE}"           > "${METALLIB_SOURCE_EMBED_TMP}"
         COMMAND sed -e "/\#include \"ggml-metal-impl.h\"/r ${METALLIB_IMPL}" -e "/\#include \"ggml-metal-impl.h\"/d" < "${METALLIB_SOURCE_EMBED_TMP}" > "${METALLIB_SOURCE_EMBED}"
         # Lines 7-8: QJL_HEAD_DIM / QJL_PROJECTION_DIM. Skip PACKED_BYTES + duplicate
-        # structs (11-30). From 32: comments + projection table + set_rows kernels.
+        # structs (11-30). From 32: comments + projection table + set_rows + qjl_project.
         COMMAND sh -c "printf '%s\\n' '// ELIZA-QJL-SET-ROWS-EMBED' >> \"${METALLIB_SOURCE_EMBED}\" && sed -n '7,8p;32,\$p' \"${METALLIB_QJL_SET_ROWS}\" >> \"${METALLIB_SOURCE_EMBED}\""
+        # Fused QJL+Polar attn: skip includes/local block structs; keep HEAD_DIM + kernels.
+        # block_qjl1_256 / block_q4_polar / QK_POLAR come from embedded ggml-common.h.
+        COMMAND sh -c "printf '%s\\n' '// ELIZA-FUSED-ATTN-QJL-POLAR-EMBED' '#define HEAD_DIM 128' '#define POLAR_Q4_N_LEVELS 16' >> \"${METALLIB_SOURCE_EMBED}\" && sed -n '57,\$p' \"${METALLIB_FUSED_POLAR}\" >> \"${METALLIB_SOURCE_EMBED}\""
         COMMAND echo ".section __DATA,__ggml_metallib"          >  "${METALLIB_EMBED_ASM}"
         COMMAND echo ".globl _ggml_metallib_start"              >> "${METALLIB_EMBED_ASM}"
         COMMAND echo "_ggml_metallib_start:"                    >> "${METALLIB_EMBED_ASM}"
         COMMAND echo .incbin "\"${METALLIB_SOURCE_EMBED}\""     >> "${METALLIB_EMBED_ASM}"
         COMMAND echo ".globl _ggml_metallib_end"                >> "${METALLIB_EMBED_ASM}"
         COMMAND echo "_ggml_metallib_end:"                      >> "${METALLIB_EMBED_ASM}"
-        DEPENDS ../ggml-common.h ggml-metal.metal ggml-metal-impl.h ${METALLIB_QJL_SET_ROWS}
+        DEPENDS ../ggml-common.h ggml-metal.metal ggml-metal-impl.h ${METALLIB_QJL_SET_ROWS} ${METALLIB_FUSED_POLAR}
         COMMENT "Generate assembly for embedded Metal library"
         VERBATIM
     )
diff --git a/ggml/src/ggml-metal/eliza-shipped/fused_attn_qjl_polar.metal b/ggml/src/ggml-metal/eliza-shipped/fused_attn_qjl_polar.metal
index e8ce17b45..1ad528242 100644
--- a/ggml/src/ggml-metal/eliza-shipped/fused_attn_qjl_polar.metal
+++ b/ggml/src/ggml-metal/eliza-shipped/fused_attn_qjl_polar.metal
@@ -41,9 +41,11 @@ using namespace metal;
 #define QJL_RESIDUAL_BYTES  (QK_POLAR / 8)
 #define POLAR_Q4_N_LEVELS   16
 
+// Field names match ggml-common.h (signs + d) so embed and metallib share one ABI
+// with Metal SET_ROWS / CUDA fused_attn.
 struct block_qjl1_256 {
-    uint8_t  qs[QJL_PACKED_BYTES];
-    ushort   norm_bf16;
+    uint8_t  signs[QJL_PACKED_BYTES];
+    ushort   d;
 };
 
 struct block_q4_polar {
@@ -129,7 +131,7 @@ static inline float qjl_score_one_token(
         device const block_qjl1_256 * pk_head,
         float4 q0, float4 q1, uint t, float sm_scale, uint tid) {
     device const block_qjl1_256 & blk = pk_head[t];
-    uint bits  = blk.qs[tid];
+    uint bits  = blk.signs[tid];
     float4 s0 = float4(
         float(int(((bits >> 0) & 1u) << 1) - 1),
         float(int(((bits >> 1) & 1u) << 1) - 1),
@@ -143,7 +145,7 @@ static inline float qjl_score_one_token(
     float4 acc4 = fma(q0, s0, fma(q1, s1, float4(0.0f)));
     float acc = acc4.x + acc4.y + acc4.z + acc4.w;
     float dot_v = simd_sum(acc);
-    return QJL_SCORE_SCALE * bf16_to_fp32(blk.norm_bf16) * dot_v * sm_scale;
+    return QJL_SCORE_SCALE * bf16_to_fp32(blk.d) * dot_v * sm_scale;
 }
 
 // Decode one block_q4_polar -> 128 real head-dim V values via v_buf, FMA into
diff --git a/ggml/src/ggml-metal/eliza-shipped/qjl_set_rows.metal b/ggml/src/ggml-metal/eliza-shipped/qjl_set_rows.metal
index a637839ca..32686ab3d 100644
--- a/ggml/src/ggml-metal/eliza-shipped/qjl_set_rows.metal
+++ b/ggml/src/ggml-metal/eliza-shipped/qjl_set_rows.metal
@@ -4206,3 +4206,29 @@ template [[host_name("kernel_set_rows_f32_i64_qjl1_256")]] kernel void kernel_se
         constant ggml_metal_kargs_set_rows &, device const void *, device const void *, device void *, uint3, uint);
 template [[host_name("kernel_set_rows_f32_i32_qjl1_256")]] kernel void kernel_set_rows_qjl1_256_t<int>(
         constant ggml_metal_kargs_set_rows &, device const void *, device const void *, device void *, uint3, uint);
+
+// Project Q head_dim→proj_dim for fused QJL attention (matches CUDA qjl_project_q).
+// Layout in/out: [n_q_pos][n_heads][dim] contiguous. Dispatch (ceil(proj/32), n_heads, n_q_pos)
+// with 32 threads along j.
+kernel void kernel_qjl_project_q_f32(
+        device const float * q                          [[buffer(0)]],
+        device       float * out                        [[buffer(1)]],
+        constant int & head_dim                         [[buffer(2)]],
+        constant int & proj_dim                         [[buffer(3)]],
+        constant int & n_heads                          [[buffer(4)]],
+        constant int & n_q_pos                          [[buffer(5)]],
+        uint3          tgpig                            [[threadgroup_position_in_grid]],
+        uint           tid                              [[thread_index_in_threadgroup]]) {
+    const int j  = int(tgpig.x) * 32 + int(tid);
+    const int hq = int(tgpig.y);
+    const int qp = int(tgpig.z);
+    if (j >= proj_dim || hq >= n_heads || qp >= n_q_pos) {
+        return;
+    }
+    device const float * qh = q + (ulong(qp) * ulong(n_heads) + ulong(hq)) * ulong(head_dim);
+    float acc = 0.0f;
+    for (int i = 0; i < head_dim; ++i) {
+        acc = fma(qh[i], qjl_projection_value(uint(i), uint(j)), acc);
+    }
+    out[(ulong(qp) * ulong(n_heads) + ulong(hq)) * ulong(proj_dim) + ulong(j)] = acc;
+}
