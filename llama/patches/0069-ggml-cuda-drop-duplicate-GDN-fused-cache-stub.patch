From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Sat, 24 Oct 2026 20:34:56 -0700
Subject: [PATCH] ggml-cuda: drop duplicate GDN fused-cache stub

---
 ggml/src/ggml-cuda/gated_delta_net.cu.rej | 29 +++++++----------------
 1 file changed, 9 insertions(+), 20 deletions(-)

diff --git a/ggml/src/ggml-cuda/gated_delta_net.cu.rej b/ggml/src/ggml-cuda/gated_delta_net.cu.rej
index eb89e48d4..ce8bb6976 100644
--- a/ggml/src/ggml-cuda/gated_delta_net.cu.rej
+++ b/ggml/src/ggml-cuda/gated_delta_net.cu.rej
@@ -1,27 +1,16 @@
 diff a/ggml/src/ggml-cuda/gated_delta_net.cu b/ggml/src/ggml-cuda/gated_delta_net.cu	(rejected hunks)
-@@ -233,6 +233,14 @@ static void launch_gated_delta_net(const float * q_d,
+@@ -233,14 +233,6 @@ static void launch_gated_delta_net(const float * q_d,
      }
  }
  
-+void ggml_cuda_op_gated_delta_net_fused_cache(
-+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_cuda_gated_delta_net_fused_cache cache) {
-+    // Stub for link compatibility with ggml-cuda.cu fusion detector. Fusion is disabled
-+    // (try_gdn_cache_fusion returns 0) because the row-per-warp kernel dropped cache writes.
-+    GGML_UNUSED(cache);
-+    ggml_cuda_op_gated_delta_net(ctx, dst);
-+}
-+
+-void ggml_cuda_op_gated_delta_net_fused_cache(
+-        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_cuda_gated_delta_net_fused_cache cache) {
+-    // Stub for link compatibility with ggml-cuda.cu fusion detector. Fusion is disabled
+-    // (try_gdn_cache_fusion returns 0) because the row-per-warp kernel dropped cache writes.
+-    GGML_UNUSED(cache);
+-    ggml_cuda_op_gated_delta_net(ctx, dst);
+-}
+-
  void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
      ggml_tensor * src_q     = dst->src[0];
      ggml_tensor * src_k     = dst->src[1];
-@@ -306,3 +314,10 @@ void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor *
-                                       sv2, sv3, sb1, sb2, sb3, neqk1, rq3, scale, stream);
-     }
- }
-+
-+// Stub: patch 0084 removed the fused-cache kernel; fusion matcher is disabled above.
-+void ggml_cuda_op_gated_delta_net_fused_cache(
-+        ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_cuda_gated_delta_net_fused_cache cache) {
-+    GGML_UNUSED(cache);
-+    ggml_cuda_op_gated_delta_net(ctx, dst);
-+}
