+class FP8_E4M3(__Quant, qtype=GGMLQuantizationType.FP8_E4M3):
+    """Block FP8 E4M3FN: F16 scale + 32× IEEE float8_e4m3fn (34 B / 32 elems)."""
+
+    @staticmethod
+    def e4m3_to_fp32(x: np.ndarray) -> np.ndarray:
+        x = x.astype(np.uint8)
+        sign = (x >> 7) & 1
+        exp = (x >> 3) & 0xF
+        man = (x & 0x7).astype(np.float32)
+        nan = (exp == 0xF) & ((x & 0x7) == 0x7)  # E4M3FN NaN only
+        sub = exp == 0
+        raw = np.where(
+            sub,
+            man * (2.0 ** -9),
+            (1.0 + man / 8.0) * (2.0 ** (exp.astype(np.float32) - 7.0)),
+        )
+        raw = np.where(nan | ((exp == 0) & (man == 0)), 0.0, raw)
+        return np.where(sign.astype(bool), -raw, raw)
+
+    @staticmethod
+    def fp32_to_e4m3(x: np.ndarray) -> np.ndarray:
+        x = np.asarray(x, dtype=np.float32)
+        sign = (np.signbit(x).astype(np.uint8)) << 7
+        ax = np.abs(x)
+        ax = np.minimum(ax, 448.0)
+        bits = ax.view(np.uint32)
+        fp32_exp = ((bits >> 23) & 0xFF).astype(np.int32) - 127
+        fp32_man = ((bits >> 20) & 0x7).astype(np.int32)
+        round_bit = ((bits >> 19) & 1).astype(np.int32)
+        e4 = fp32_exp + 7
+
+        sub_man = np.clip((ax * 512.0 + 0.5).astype(np.int32), 0, 7)
+        sub_res = np.where(sub_man >= 1, sub_man, 0).astype(np.uint8)
+
+        man = fp32_man + round_bit
+        exp = e4.copy()
+        overflow = man > 7
+        man = np.where(overflow, 0, man)
+        exp = np.where(overflow, exp + 1, exp)
+        # E4M3FN: exp==15 mant 0..6 is finite; only mant 7 is NaN — saturate those to 0x7E.
+        saturate = (exp > 15) | ((exp == 15) & (man >= 7))
+        normal = np.where(saturate, np.uint8(0x7E), ((exp << 3) | man).astype(np.uint8))
+
+        out = np.where(
+            ax <= 0.0,
+            np.uint8(0),
+            np.where(e4 <= 0, sub_res, normal),
+        )
+        # NaN/Inf → 0x7F
+        bad = ~np.isfinite(x)
+        out = np.where(bad, np.uint8(0x7F), out)
+        return (sign | out).astype(np.uint8)
+
+    @classmethod
+    def quantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        n_blocks = blocks.shape[0]
+        amax = np.max(np.abs(blocks), axis=-1, keepdims=True)
+        d = (amax / 448.0).astype(np.float32)
+        with np.errstate(divide="ignore"):
+            id_ = np.where(d > 0, 1.0 / d, 0.0)
+        qs = cls.fp32_to_e4m3(blocks * id_)
+        d_f16 = d.astype(np.float16).view(np.uint8).reshape(n_blocks, 2)
+        return np.concatenate([d_f16, qs], axis=-1)
+
+    @classmethod
+    def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
+        n_blocks = blocks.shape[0]
+        d_f16, qs = np.hsplit(blocks, [2])
+        d = d_f16.view(np.float16).astype(np.float32).reshape(n_blocks, 1)
+        vals = cls.e4m3_to_fp32(qs)
+        return d * vals
+
+    @classmethod
+    def pack_e4m3_with_scale(cls, qs: np.ndarray, scale: float | np.ndarray) -> np.ndarray:
+        """Pack raw float8_e4m3fn bytes with per-tensor or per-row F32 scale into blocks.
+
+        qs: uint8 array shaped (rows, cols) with cols % 32 == 0.
+        scale: scalar or per-row array.
+        Returns uint8 array shaped (rows, (cols/32)*34) for GGUFWriter.
+        """
+        qs = np.asarray(qs, dtype=np.uint8)
+        if qs.ndim == 1:
+            qs = qs.reshape(1, -1)
+        flat_rows = qs.reshape(-1, qs.shape[-1])
+        rows, cols = flat_rows.shape
+        if cols % 32 != 0:
+            raise ValueError(f"FP8_E4M3 pack requires cols % 32 == 0, got {cols}")
+        n_blocks_per_row = cols // 32
+        scale_arr = np.asarray(scale, dtype=np.float32)
+        if scale_arr.ndim == 0:
+            scale_arr = np.full((rows,), float(scale_arr), dtype=np.float32)
+        else:
+            scale_arr = scale_arr.reshape(-1)
+            if scale_arr.size == 1:
+                scale_arr = np.full((rows,), float(scale_arr[0]), dtype=np.float32)
+            if scale_arr.size != rows:
+                raise ValueError(f"scale size {scale_arr.size} != rows {rows}")
+
+        out = np.empty((rows, n_blocks_per_row, 34), dtype=np.uint8)
+        for r in range(rows):
+            d_f16 = np.frombuffer(np.float16(scale_arr[r]).tobytes(), dtype=np.uint8)
+            for b in range(n_blocks_per_row):
+                out[r, b, 0:2] = d_f16
+                out[r, b, 2:] = flat_rows[r, b * 32:(b + 1) * 32]
+        return out.reshape(rows, n_blocks_per_row * 34)
+
