+
+    for (int i = 0; i < nb; i++) {
+        float amax = 0.0f;
+        for (int j = 0; j < QK_FP8_E4M3; j++) {
+            amax = MAX(amax, fabsf(x[i * QK_FP8_E4M3 + j]));
