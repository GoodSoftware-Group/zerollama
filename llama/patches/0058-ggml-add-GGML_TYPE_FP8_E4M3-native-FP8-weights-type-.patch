+        const float id = d ? 1.0f / d : 0.0f;
+        y[i].d = GGML_FP32_TO_FP16(d);
+        for (int j = 0; j < QK_FP8_E4M3; ++j) {
+            y[i].qs[j] = ggml_fp32_to_fp8_e4m3(x[i * QK_FP8_E4M3 + j] * id);
+        }
+    }
