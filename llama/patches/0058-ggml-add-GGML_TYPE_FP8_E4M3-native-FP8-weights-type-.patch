         return False
 
+    def _pack_fp8_native_tensor(self, name: str, data_torch: Tensor) -> np.ndarray:
+        """Pack float8_e4m3fn weights + stored scale into GGML FP8_E4M3 blocks (no full dequant)."""
+        scale_t = LazyTorchTensor.to_eager(self._fp8_native_scales[name]())
+        scale = scale_t.detach().float().cpu().numpy()
+        qs = data_torch.view(torch.uint8).cpu().numpy()
+        # Per-row scale: (out_features,) or (out_features, 1); else scalar / broadcast.
+        if scale.ndim >= 1 and scale.size == qs.shape[0]:
+            scale_arg = scale.reshape(qs.shape[0])
+        elif scale.size == 1:
+            scale_arg = float(scale.reshape(-1)[0])
+        else:
+            raise ValueError(
+                f"{name}: unsupported FP8 scale shape {scale.shape} for --fp8-native "
+                f"(want scalar or per-row matching {qs.shape[0]})"
+            )
+        return gguf.quants.FP8_E4M3.pack_e4m3_with_scale(qs, scale_arg)
+
     # some models need extra generated tensors (like rope_freqs)
     def generate_extra_tensors(self) -> Iterable[tuple[str, Tensor]]:
         return ()
@@ -912,6 +964,28 @@ class ModelBase:
 
             old_dtype = data_torch.dtype
 
+            # Native FP8: pack E4M3 bytes + scale into GGML_TYPE_FP8_E4M3 without expanding to F16/F32.
+            if name in self._fp8_native_tensors:
+                if data_torch.dtype != torch.float8_e4m3fn:
+                    raise ValueError(f"{name}: --fp8-native expected float8_e4m3fn, got {data_torch.dtype}")
+                bid = None
+                for part in name.split("."):
+                    if part.isdecimal():
+                        bid = int(part)
+                        break
+                for new_name, data_torch in (self.modify_tensors(data_torch, name, bid)):
+                    if data_torch.ndim <= 1 or new_name.endswith("_norm.weight"):
+                        # norms / 1D stay F32 via normal path
+                        data_torch = data_torch.to(torch.float32)
+                        data = data_torch.numpy()
+                        self.gguf_writer.add_tensor(new_name, data, raw_dtype=gguf.GGMLQuantizationType.F32)
+                        logger.info(f"{new_name}, {old_dtype} --> F32 (1d/norm), shape = {data.shape}")
+                        continue
+                    packed = self._pack_fp8_native_tensor(name, data_torch)
+                    logger.info(f"{new_name}, {old_dtype} --> FP8_E4M3 (native), shape = {list(data_torch.shape)}")
+                    self.gguf_writer.add_tensor(new_name, packed, raw_dtype=gguf.GGMLQuantizationType.FP8_E4M3)
+                continue
+
             # convert any unsupported data types to float32
             if data_torch.dtype not in (torch.float16, torch.float32):
                 data_torch = data_torch.to(torch.float32)
