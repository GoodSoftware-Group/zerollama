From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Thu, 9 Jul 2026 12:55:00 -0700
Subject: [PATCH] ollama: disable ctx-checkpoints on multi-GPU SWA

gemma4 dual-GPU crashes in common_prompt_checkpoint::update_tgt during
long prefills: llama_state_seq_get_data_ext + PARTIAL_ONLY dump hits
CUDA illegal access on the secondary device. Disable checkpoints when
n_swa > 0 and more than one GPU is present.
---
 tools/server/server-context.cpp | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index a9edbd7..fb6dcfb 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1150,6 +1150,26 @@ private:
 
         n_swa = params_base.swa_full ? 0 : llama_model_n_swa(model_tgt);
 
+        // Multi-GPU SWA (gemma4 iswa dual-KV): creating context checkpoints during
+        // prefill dumps PARTIAL_ONLY state via llama_state_seq_get_data_ext and
+        // reliably hits CUDA illegal access on the secondary device. Prefer full
+        // re-prefill over crashing; matches the prior ollama --ctx-checkpoints 0
+        // mitigation, but scoped to the broken configuration only.
+        if (n_swa > 0 && params_base.n_ctx_checkpoints > 0) {
+            int n_gpu = 0;
+            for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+                const enum ggml_backend_dev_type type = ggml_backend_dev_type(ggml_backend_dev_get(i));
+                if (type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+                    n_gpu++;
+                }
+            }
+            if (n_gpu > 1) {
+                SRV_WRN("disabling ctx-checkpoints (%d -> 0): multi-GPU SWA checkpoint dump is unsafe\n",
+                        params_base.n_ctx_checkpoints);
+                params_base.n_ctx_checkpoints = 0;
+            }
+        }
+
         // Necessary similarity of prompt for slot selection
         slot_prompt_similarity = params_base.slot_prompt_similarity;
 
