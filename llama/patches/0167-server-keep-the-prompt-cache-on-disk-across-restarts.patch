+                    if (nd != entry->drft.size()) {
+                        SRV_WRN("failed to restore disk draft state with size %zu\n", entry->drft.size());
+                        warm->drop(pick->path);
+                        return false;
+                    }
+                }
+
+                std::list<std::shared_ptr<const common_prompt_checkpoint>> ckpts;
