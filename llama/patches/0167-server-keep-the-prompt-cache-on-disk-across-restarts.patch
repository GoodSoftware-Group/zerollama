+            if (!entry || entry->main.empty() || (!entry->drft.empty() && ctx_dft == nullptr) || (entry->drft.empty() && ctx_dft != nullptr)) {
+                if (!entry || entry->main.empty() || (!entry->drft.empty() && ctx_dft == nullptr)) {
