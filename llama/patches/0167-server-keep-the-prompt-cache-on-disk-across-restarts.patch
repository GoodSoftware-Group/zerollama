 tools/server/server-slot-sched.cpp |  63 +++
 tools/server/server-slot-sched.h   |   6 +
 tools/server/server-warm-disk.h    | 724 +++++++++++++++++++++++++++++
 5 files changed, 896 insertions(+), 1 deletion(-)
 create mode 100644 tools/server/server-warm-disk.h

