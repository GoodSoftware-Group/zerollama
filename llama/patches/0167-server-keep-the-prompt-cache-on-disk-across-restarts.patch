@@ -205,6 +215,59 @@ bool server_prompt_cache::load(server_prompt & prompt, const server_tokens & tok
         }
     }
 
+    // a disk entry is used only when it keeps more of the cached prompt than the RAM hit
+    if (warm && !tokens_new.has_mtmd && !tokens_new.empty() && lora_get_enabled_ids(lora_new).empty()) {
+        const auto & query = tokens_new.get_tokens();
+        if (const auto pick = warm->better(query.data(), query.size(), f_keep_best, f_sim_best)) {
