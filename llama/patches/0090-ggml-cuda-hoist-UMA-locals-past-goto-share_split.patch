From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 17 Jul 2026 13:10:37 -0700
Subject: [PATCH] ggml-cuda: hoist UMA locals past goto share_split

nvcc rejects goto that bypasses C++ initialization of uma_env/is_uma when
NVML memory reporting jumps to share_split.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 902859090..7368a0515 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4692,6 +4692,13 @@ static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t *
     std::lock_guard<std::mutex> lock(ctx->device_mutex);
 #endif
 
+    // Declared before any goto share_split — nvcc rejects goto past C++ initialization.
+#if defined(__linux__)
+    bool uma_env = false;
+    bool is_uma = false;
+    cudaDeviceProp prop;
+#endif
+
     ggml_cuda_set_device(ctx->device);
 
 #if defined(GGML_USE_HIP)
@@ -4729,12 +4736,11 @@ static void ggml_backend_cuda_device_get_memory(ggml_backend_dev_t dev, size_t *
 // ref: https://github.com/ggml-org/llama.cpp/pull/17368
 #if defined(__linux__)
     // Check if this is a UMA (Unified Memory Architecture) system
-    cudaDeviceProp prop;
     CUDA_CHECK(cudaGetDeviceProperties(&prop, ggml_cuda_get_physical_device(ctx->device)));
 
     // Check if UMA is explicitly enabled via environment variable
-    bool uma_env = getenv("GGML_CUDA_ENABLE_UNIFIED_MEMORY") != nullptr;
-    bool is_uma = prop.integrated > 0 || uma_env;
+    uma_env = getenv("GGML_CUDA_ENABLE_UNIFIED_MEMORY") != nullptr;
+    is_uma = prop.integrated > 0 || uma_env;
 
     if (is_uma) {
         // For UMA systems (like DGX Spark), use system memory info
