-            entry.logits.resize(n_f);
-            if (!read_raw(in, entry.logits.data(), (size_t) n_f * sizeof(float))) {
+            // A file written without a trailer ends here. ZLOG is the logits
+            // after the last token. ZRAT is the seconds per token of the
