From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nobody <>
Date: Sat, 21 Nov 2026 14:30:46 -0800
Subject: [PATCH] llama: rank a saved prompt by the prefill that wrote it

The disk cache ranked every file by the latest prefill, so a slow prompt saved earlier looked cheap to recompute after a fast one. The file keeps that prefill's seconds per token, and a file without one still uses the latest measurement.
---
 tools/server/server-context.cpp    |   1 +
 tools/server/server-slot-sched.cpp |   3 +-
 tools/server/server-warm-disk.h    | 135 ++++++++++++++++++++++-------
 3 files changed, 107 insertions(+), 32 deletions(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index ce7948e..42e2ce9 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -626,6 +626,7 @@ struct server_slot {
                 ent.logits_n    = prompt.logits_n;
                 ent.logits_k    = prompt.logits_k;
                 ent.logits_hash = prompt.logits_hash;
+                ent.prefill_s   = saved != nullptr ? saved->prefill_s : prompt_cache.cost.token_s;
                 prompt_cache.warm->store(std::move(ent));
             } catch (const std::bad_alloc &) {
                 SLT_WRN(*this, "%s", "prompt disk cache skipped, out of memory\n");
diff --git a/tools/server/server-slot-sched.cpp b/tools/server/server-slot-sched.cpp
index 3baddf7..3c82922 100644
--- a/tools/server/server-slot-sched.cpp
+++ b/tools/server/server-slot-sched.cpp
@@ -265,7 +265,8 @@ bool server_prompt_cache::load(server_prompt & prompt, const server_tokens & tok
         const auto & query = tokens_new.get_tokens();
         if (cost.timed()) {
             for (const auto & pick : warm->matches(query.data(), query.size())) {
-                const double gain = llama_warm_gain(pick.lcp, cost.token_s, (size_t) pick.bytes, cost.restore() + cost.load_s);
+                const double per = pick.prefill_s > 0.0 ? pick.prefill_s : cost.token_s;
+                const double gain = llama_warm_gain(pick.lcp, per, (size_t) pick.bytes, cost.restore() + cost.load_s);
                 if (gain > best_gain) {
                     best_gain = gain;
                     disk_pick = pick;
diff --git a/tools/server/server-warm-disk.h b/tools/server/server-warm-disk.h
