@@ -0,0 +1,44 @@
+#pragma once
+
+#include "common.cuh"
+
+#if defined(GGML_CUDA_FUSED_ATTN_QJL)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+void fused_attn_qjl_tbq_cuda(
+        const float * q_sketch_d,
+        const void  * packed_k_d,
+        const void  * packed_v_d,
+        int n_heads, int n_kv_heads, int n_q_pos, int n_kv,
+        float sm_scale, int kv_tile,
+        float * out_d,
+        cudaStream_t stream);
+
+void fused_attn_qjl_polar_cuda(
+        const float * q_sketch_d,
+        const void  * packed_k_d,
+        const void  * packed_v_d,
+        int n_heads, int n_kv_heads, int n_q_pos, int n_kv,
+        float sm_scale, int v_use_qjl, int kv_tile, int causal, int q_pos_base,
+        float * out_d,
+        cudaStream_t stream);
+
+void qjl_score_dp4a_cuda(
+        const int8_t * q_sketch_i8_d,
+        const float  * q_scale_d,
+        const void   * packed_k_d,
+        int n_heads, int n_kv_heads, int n_kv_tokens,
+        float * scores_d,
+        cudaStream_t stream);
+
+#ifdef __cplusplus
+}
+#endif
+
+void ggml_cuda_op_fused_attn_qjl_tbq(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+void ggml_cuda_op_attn_score_qjl(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+#endif // GGML_CUDA_FUSED_ATTN_QJL
diff --git a/ggml/src/ggml-cuda/polar-set-rows.cuh b/ggml/src/ggml-cuda/polar-set-rows.cuh
new file mode 100644
index 0000000..2ecc803
--- /dev/null
+++ b/ggml/src/ggml-cuda/polar-set-rows.cuh
@@ -0,0 +1,97 @@
+#pragma once
+
+// Device-side PolarQuant Q4 encode for GGML_OP_SET_ROWS (V-cache writes).
+#if defined(GGML_CUDA_POLARQUANT)
+
+#include "common.cuh"
+#include "ggml-common.h"
+
+__device__ __forceinline__ float polar_qjl_sign_setrows(int i) {
+    uint32_t state = 42u;
+    if (state == 0u) {
+        state = 1u;
+    }
+    float bit = -1.0f;
+    for (int k = 0; k <= i; ++k) {
+        state ^= state << 13;
+        state ^= state >> 17;
+        state ^= state << 5;
+        bit = (state & 1u) ? 1.0f : -1.0f;
+    }
+    return bit;
+}
+
+__device__ __forceinline__ void polar_hadamard_inplace_setrows(float * x) {
+    for (int h = 1; h < QK_POLAR; h <<= 1) {
+        for (int i = 0; i < QK_POLAR; i += (h << 1)) {
+            for (int j = i; j < i + h; ++j) {
+                const float a = x[j];
+                const float b = x[j + h];
+                x[j]     = a + b;
+                x[j + h] = a - b;
+            }
+        }
+    }
+}
+
+__device__ __forceinline__ uint8_t polar_q4_bucketize_setrows(float v) {
+    const float boundaries[15] = {
+        -2.423958757e+00f, -1.868302108e+00f, -1.461390631e+00f, -1.121190365e+00f,
+        -8.175165476e-01f, -5.351446099e-01f, -2.648274426e-01f,  4.996003611e-16f,
+         2.648274426e-01f,  5.351446099e-01f,  8.175165476e-01f,  1.121190365e+00f,
+         1.461390631e+00f,  1.868302108e+00f,  2.423958757e+00f,
+    };
+    uint8_t code = 0;
+    for (int i = 0; i < 15; ++i) {
+        if (v > boundaries[i]) {
+            code = (uint8_t) (i + 1);
+        }
+    }
+    return code;
+}
+
+__device__ inline void quantize_f32_q4_polar_block(const float * x, block_q4_polar * y) {
+    const float centroids[16] = {
+        -2.754354807e+00f, -2.093562707e+00f, -1.643041510e+00f, -1.279739752e+00f,
+        -9.626409783e-01f, -6.723921169e-01f, -3.978971029e-01f, -1.317577823e-01f,
+         1.317577823e-01f,  3.978971029e-01f,  6.723921169e-01f,  9.626409783e-01f,
+         1.279739752e+00f,  1.643041510e+00f,  2.093562707e+00f,  2.754354807e+00f,
+    };
+
+    float norm_sq = 0.0f;
+    for (int i = 0; i < QK_POLAR; ++i) {
+        const float v = x[i];
+        norm_sq += v * v;
+    }
+    const float l2     = sqrtf(norm_sq);
+    const float inv_l2 = (l2 > 1e-10f) ? (1.0f / l2) : 0.0f;
+    y->d = __float2half(l2);
+
+    float buf[QK_POLAR];
+    for (int i = 0; i < QK_POLAR; ++i) {
+        buf[i] = x[i] * inv_l2;
+    }
+    polar_hadamard_inplace_setrows(buf);
+
+    uint8_t codes[QK_POLAR];
+    for (int i = 0; i < QK_POLAR; ++i) {
+        codes[i] = polar_q4_bucketize_setrows(buf[i]);
+    }
+    for (int i = 0; i < QK_POLAR / 2; ++i) {
+        const uint8_t lo = codes[2 * i];
+        const uint8_t hi = codes[2 * i + 1];
+        y->qs[i] = (uint8_t) ((hi << 4) | (lo & 0x0Fu));
+    }
+
+    for (int i = 0; i < QJL_RESIDUAL_BYTES; ++i) {
+        y->qjl[i] = 0;
+    }
+    float proj = 0.0f;
+    for (int i = 0; i < QK_POLAR; ++i) {
+        const float c = centroids[codes[i]];
+        proj += (buf[i] - c) * polar_qjl_sign_setrows(i);
+    }
+    y->qjl[0] = (proj >= 0.0f) ? 1u : 0u;
+}
+
+#endif // GGML_CUDA_POLARQUANT
diff --git a/ggml/src/ggml-cuda/polarquant.cu b/ggml/src/ggml-cuda/polarquant.cu
new file mode 100644
index 0000000..24723a2
--- /dev/null
+++ b/ggml/src/ggml-cuda/polarquant.cu
@@ -0,0 +1,431 @@
+// PolarQuant Q4 CUDA kernels.
+//
+// Translation of the CPU reference at
+// packages/native-plugins/polarquant-cpu/src/{polar_dequantize_ref.c,
+// polar_dot_ref.c, polar_hadamard.c, polar_qjl.c}.
+//
+// Per block (QK_POLAR = 128 elements):
+//   1. Unpack 16 Lloyd-Max centroid indices (4 bits each).
+//   2. Look up centroid value from POLAR_Q4_CENTROIDS.
+//   3. (optional) Apply 1-bit QJL residual sign correction.
+//   4. Apply size-128 in-place Walsh-Hadamard butterfly.
+//   5. Multiply by inv_d = 1/QK_POLAR (orthonormal compensation).
+//   6. Multiply by per-block fp16 L2 norm.
+//
+// Compile-only validation: file body is gated on GGML_CUDA_POLARQUANT.
+
+#include "ggml.h"
+#include "ggml-impl.h"
+#include "polarquant.cuh"
+
+#if defined(GGML_CUDA_POLARQUANT)
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cstdint>
+#include <cmath>
+
+// Lloyd-Max centroids for X ~ N(0,1), 16 levels. Bit-exact match for
+// POLAR_Q4_CENTROIDS in
+// packages/native-plugins/polarquant-cpu/include/polarquant/polar_centroids.h
+// (auto-generated by scripts/gen_centroids.py).
+__constant__ float k_polar_q4_centroids_cuda[16] = {
+    -2.754354807e+00f,
+    -2.093562707e+00f,
+    -1.643041510e+00f,
+    -1.279739752e+00f,
+    -9.626409783e-01f,
+    -6.723921169e-01f,
+    -3.978971029e-01f,
+    -1.317577823e-01f,
+     1.317577823e-01f,
+     3.978971029e-01f,
+     6.723921169e-01f,
+     9.626409783e-01f,
+     1.279739752e+00f,
+     1.643041510e+00f,
+     2.093562707e+00f,
+     2.754354807e+00f,
+};
+
+// QJL correction magnitude — matches POLAR_QJL_CORRECTION_MAGNITUDE in
+// packages/native-plugins/polarquant-cpu/include/polarquant/polarquant.h.
+#define POLAR_QJL_CORRECTION_MAGNITUDE_CUDA 0.5f
+#define POLAR_QJL_SEED_CUDA 42u
+
+// Generate the per-block xorshift32 +/-1 sign vector.
+// Bit-identical to polar_qjl_signs() in
+// packages/native-plugins/polarquant-cpu/src/polar_qjl.c.
+static __device__ __forceinline__ float polar_qjl_sign_cuda(int i) {
+    // Re-runs the xorshift32 from index 0. For per-thread reads we just
+    // skip-ahead by re-iterating; the i is small (<128) and the per-call
+    // cost is negligible vs. the rest of the per-block work. The CPU
+    // reference also re-runs the loop; this matches exactly.
+    uint32_t state = POLAR_QJL_SEED_CUDA;
+    if (state == 0u) state = 1u;
+    float bit = -1.0f;
+    for (int k = 0; k <= i; ++k) {
+        state ^= state << 13;
+        state ^= state >> 17;
+        state ^= state << 5;
+        bit = (state & 1u) ? 1.0f : -1.0f;
+    }
+    return bit;
+}
+
+// In-place Walsh-Hadamard transform of size 128 in shared memory.
+// Mirrors polar_hadamard_inplace in polar_hadamard.c — same iteration
+// order (h = 1, 2, 4, ..., 64), no normalization (the 1/QK_POLAR scale
+// is applied separately by the caller).
+static __device__ __forceinline__ void polar_hadamard_inplace_cuda(float * x) {
+    #pragma unroll 7
+    for (int h = 1; h < QK_POLAR; h <<= 1) {
+        for (int i = 0; i < QK_POLAR; i += (h << 1)) {
+            for (int j = i; j < i + h; ++j) {
+                const float a = x[j];
+                const float b = x[j + h];
+                x[j]     = a + b;
+                x[j + h] = a - b;
+            }
+        }
+    }
+}
+
+// Per-block dequantize. Each block produces QK_POLAR floats. We launch
+// one CUDA block per polar block; the body runs serially because the
+// in-place WHT butterfly has a hard sequential dependency between stages
+// (we'd need a per-stage __syncthreads barrier to parallelize the inner
+// loop, which costs more than just running the 7 stages serially on
+// thread 0). The bottleneck on real workloads is always the 4-bit unpack
+// + LUT, which we vectorize across QK_POLAR threads in step 1+2; the
+// final WHT is a fixed 7*64 = 448-op tail.
+
+template <typename dst_t>
+__global__ void polar_dequantize_kernel(
+    const block_q4_polar * __restrict__ x,
+    dst_t * __restrict__ y,
+    int nrows,
+    int use_qjl)
+{
+    const int b = blockIdx.x;
+    if (b >= nrows) return;
+
+    const block_q4_polar * src = &x[b];
+    __shared__ float buf[QK_POLAR];
+
+    const int tid = threadIdx.x;
+
+    // 1+2. Unpack codes -> centroid values. 64 threads, each handles 2 elements.
+    if (tid < QK_POLAR / 2) {
+        const uint8_t byte = src->qs[tid];
+        const uint8_t lo = (uint8_t)(byte & 0x0Fu);
+        const uint8_t hi = (uint8_t)((byte >> 4) & 0x0Fu);
+        buf[2 * tid    ] = k_polar_q4_centroids_cuda[lo];
+        buf[2 * tid + 1] = k_polar_q4_centroids_cuda[hi];
+    }
+    __syncthreads();
+
+    // 3. Optional QJL residual correction.
+    if (use_qjl) {
+        if (tid == 0) {
+            const uint8_t bit = (uint8_t)(src->qjl[0] & 1u);
+            const float sign  = bit ? 1.0f : -1.0f;
+            const float mag   = POLAR_QJL_CORRECTION_MAGNITUDE_CUDA / sqrtf((float) QK_POLAR);
+            for (int i = 0; i < QK_POLAR; ++i) {
+                buf[i] += sign * mag * polar_qjl_sign_cuda(i);
+            }
+        }
+        __syncthreads();
+    }
+
+    // 4+5. Inverse Hadamard + 1/QK_POLAR scale. Single-thread pass.
+    if (tid == 0) {
+        polar_hadamard_inplace_cuda(buf);
+        const float inv_d = 1.0f / (float) QK_POLAR;
+        for (int i = 0; i < QK_POLAR; ++i) {
+            buf[i] *= inv_d;
+        }
+    }
+    __syncthreads();
+
+    // 6. Per-block fp16 L2 rescale + write out.
+    const float l2 = __half2float(src->d);
+    if (tid < QK_POLAR) {
+        const float v = buf[tid] * l2;
+        if constexpr (std::is_same<dst_t, float>::value) {
+            y[b * QK_POLAR + tid] = v;
+        } else if constexpr (std::is_same<dst_t, half>::value) {
+            y[b * QK_POLAR + tid] = __float2half(v);
+        } else { // nv_bfloat16
+            y[b * QK_POLAR + tid] = __float2bfloat16(v);
+        }
+    }
+}
+
+void dequantize_row_q4_polar_cuda(
+    const void * x_d,
+    float * y_d,
+    int64_t nrows,
+    int use_qjl,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(nrows > 0);
+    const block_q4_polar * x = (const block_q4_polar *) x_d;
+    const dim3 grid((unsigned) nrows, 1, 1);
+    const dim3 block(QK_POLAR, 1, 1); // 128 threads
+    polar_dequantize_kernel<float><<<grid, block, 0, stream>>>(x, y_d, (int) nrows, use_qjl);
+}
+
+// ---------------- Q4_POLAR x Q8_0 dot product ----------------
+//
+// One CUDA block per (row_x, row_y) output. Inside the block we walk
+// the (n_per_row / QK_POLAR) PolarQuant blocks for row_x and accumulate
+// against the matching 4 Q8_0 blocks for row_y. QK_POLAR = 128 = 4 * QK8_0.
+//
+// Block geometry: 128 threads/block, organized as one "lane" per
+// PolarQuant slot. The dequantized fp32 buffer lives in shared memory.
+
+__global__ void polar_mul_mat_q4_polar_q8_0_kernel(
+    const block_q4_polar * __restrict__ x,
+    const block_q8_0 * __restrict__ y,
+    float * __restrict__ dst,
+    int nrows_x,
+    int nrows_y,
+    int n_per_row,
+    int use_qjl)
+{
+    const int row_x = blockIdx.x;
+    const int row_y = blockIdx.y;
+    if (row_x >= nrows_x || row_y >= nrows_y) return;
+
+    const int n_polar = n_per_row / QK_POLAR;
+    const int n_q8_per_polar = QK_POLAR / QK8_0; // = 4
+
+    const block_q4_polar * x_row = x + row_x * n_polar;
+    const block_q8_0     * y_row = y + row_y * (n_per_row / QK8_0);
+
+    __shared__ float buf[QK_POLAR];
+    const int tid = threadIdx.x;
+    float acc = 0.0f;
+
+    for (int b = 0; b < n_polar; ++b) {
+        const block_q4_polar * src = x_row + b;
+
+        // 1+2. Unpack codes -> centroid values.
+        if (tid < QK_POLAR / 2) {
+            const uint8_t byte = src->qs[tid];
+            const uint8_t lo = (uint8_t)(byte & 0x0Fu);
+            const uint8_t hi = (uint8_t)((byte >> 4) & 0x0Fu);
+            buf[2 * tid    ] = k_polar_q4_centroids_cuda[lo];
+            buf[2 * tid + 1] = k_polar_q4_centroids_cuda[hi];
+        }
+        __syncthreads();
+
+        // 3. Optional QJL residual correction.
+        if (use_qjl) {
+            if (tid == 0) {
+                const uint8_t bit = (uint8_t)(src->qjl[0] & 1u);
+                const float sign  = bit ? 1.0f : -1.0f;
+                const float mag   = POLAR_QJL_CORRECTION_MAGNITUDE_CUDA / sqrtf((float) QK_POLAR);
+                for (int i = 0; i < QK_POLAR; ++i) {
+                    buf[i] += sign * mag * polar_qjl_sign_cuda(i);
+                }
+            }
+            __syncthreads();
+        }
+
+        // 4+5. WHT + 1/QK_POLAR. Single-thread.
+        if (tid == 0) {
+            polar_hadamard_inplace_cuda(buf);
+            const float inv_d = 1.0f / (float) QK_POLAR;
+            for (int i = 0; i < QK_POLAR; ++i) {
+                buf[i] *= inv_d;
+            }
+        }
+        __syncthreads();
+
+        // 6+7. Per-block L2 + Q8_0 dot.
+        const float l2 = __half2float(src->d);
+        if (tid < QK_POLAR) {
+            // Each thread owns one element of buf. Find which Q8_0 block
+            // and slot it goes in.
+            const int qb     = tid / QK8_0;     // which of 4 Q8_0 blocks
+            const int qslot  = tid % QK8_0;     // which slot inside that block
+            const block_q8_0 * yb = y_row + b * n_q8_per_polar + qb;
+            const float scale = __half2float(yb->d);
+            acc += l2 * buf[tid] * scale * (float) yb->qs[qslot];
+        }
+        __syncthreads();
+    }
+
+    // Block reduction.
+    __shared__ float s_partial[4]; // 128 / 32 = 4 warps
+    const unsigned mask = 0xFFFFFFFFu;
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        acc += __shfl_xor_sync(mask, acc, off);
+    }
+    if ((tid & 31) == 0) {
+        s_partial[tid >> 5] = acc;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        float total = 0.0f;
+        for (int w = 0; w < 4; ++w) total += s_partial[w];
+        dst[row_x * nrows_y + row_y] = total;
+    }
+}
+
+void mul_mat_q4_polar_q8_0_cuda(
+    const void * x_d,
+    const void * y_d,
+    float * dst_d,
+    int nrows_x,
+    int nrows_y,
+    int n_per_row,
+    int use_qjl,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(nrows_x > 0 && nrows_y > 0 && n_per_row > 0);
+    GGML_ASSERT((n_per_row % QK_POLAR) == 0);
+    const block_q4_polar * x = (const block_q4_polar *) x_d;
+    const block_q8_0     * y = (const block_q8_0     *) y_d;
+    const dim3 grid((unsigned) nrows_x, (unsigned) nrows_y, 1);
+    const dim3 block(QK_POLAR, 1, 1);
+    polar_mul_mat_q4_polar_q8_0_kernel<<<grid, block, 0, stream>>>(
+        x, y, dst_d, nrows_x, nrows_y, n_per_row, use_qjl);
+}
+
+// ---------------- get_rows for Q4_POLAR ----------------
+//
+// Mirrors the structure of get_rows_cuda_q in getrows.cu, but the
+// dequantize step needs the full block (WHT cannot be done piecewise),
+// so we launch one CUDA block per (selected_row, polar_block_within_row).
+
+template <typename dst_t>
+__global__ void polar_get_rows_kernel(
+    const block_q4_polar * __restrict__ src0,
+    const int32_t * __restrict__ src1,
+    dst_t * __restrict__ dst,
+    int64_t ne00,
+    size_t nb01, size_t nb02, size_t nb03,
+    int64_t ne10, int64_t ne11, int64_t ne12,
+    size_t nb10, size_t nb11, size_t nb12,
+    size_t nb1, size_t nb2, size_t nb3,
+    int use_qjl)
+{
+    const int64_t i_polar = blockIdx.x;       // which polar block within the dst row
+    const int64_t i10     = blockIdx.y;       // which selected row
+    const int64_t i11     = blockIdx.z % ne11;
+    const int64_t i12     = blockIdx.z / ne11;
+    if (i_polar * QK_POLAR >= ne00) return;
+    if (i12 >= ne12) return;
+
+    const int32_t i01 = src1[i10 * (nb10 / sizeof(int32_t))
+                            + i11 * (nb11 / sizeof(int32_t))
+                            + i12 * (nb12 / sizeof(int32_t))];
+    const int64_t i02 = i11;
+    const int64_t i03 = i12;
+
+    const block_q4_polar * src_row = (const block_q4_polar *)
+        ((const char *) src0
+         + (size_t) i01 * nb01
+         + (size_t) i02 * nb02
+         + (size_t) i03 * nb03);
+
+    dst_t * dst_row = (dst_t *) ((char *) dst
+                                  + (size_t) i10 * nb1
+                                  + (size_t) i11 * nb2
+                                  + (size_t) i12 * nb3);
+
+    const block_q4_polar * src = src_row + i_polar;
+    __shared__ float buf[QK_POLAR];
+    const int tid = threadIdx.x;
+
+    if (tid < QK_POLAR / 2) {
+        const uint8_t byte = src->qs[tid];
+        const uint8_t lo = (uint8_t)(byte & 0x0Fu);
+        const uint8_t hi = (uint8_t)((byte >> 4) & 0x0Fu);
+        buf[2 * tid    ] = k_polar_q4_centroids_cuda[lo];
+        buf[2 * tid + 1] = k_polar_q4_centroids_cuda[hi];
+    }
+    __syncthreads();
+
+    if (use_qjl && tid == 0) {
+        const uint8_t bit = (uint8_t)(src->qjl[0] & 1u);
+        const float sign  = bit ? 1.0f : -1.0f;
+        const float mag   = POLAR_QJL_CORRECTION_MAGNITUDE_CUDA / sqrtf((float) QK_POLAR);
+        for (int i = 0; i < QK_POLAR; ++i) {
+            buf[i] += sign * mag * polar_qjl_sign_cuda(i);
+        }
+    }
+    if (use_qjl) __syncthreads();
+
+    if (tid == 0) {
+        polar_hadamard_inplace_cuda(buf);
+        const float inv_d = 1.0f / (float) QK_POLAR;
+        for (int i = 0; i < QK_POLAR; ++i) {
+            buf[i] *= inv_d;
+        }
+    }
+    __syncthreads();
+
+    const float l2 = __half2float(src->d);
+    if (tid < QK_POLAR) {
+        const int64_t out_idx = i_polar * QK_POLAR + tid;
+        if (out_idx < ne00) {
+            const float v = buf[tid] * l2;
+            if constexpr (std::is_same<dst_t, float>::value) {
+                dst_row[out_idx] = v;
+            } else if constexpr (std::is_same<dst_t, half>::value) {
+                dst_row[out_idx] = __float2half(v);
+            } else {
+                dst_row[out_idx] = __float2bfloat16(v);
+            }
+        }
+    }
+}
+
+void get_rows_q4_polar_cuda(
+    const void * src0_d,
+    const int32_t * src1_d,
+    void * dst_d,
+    int dst_type,
+    int64_t ne00,
+    size_t nb01, size_t nb02, size_t nb03,
+    int64_t ne10, int64_t ne11, int64_t ne12,
+    size_t nb10, size_t nb11, size_t nb12,
+    size_t nb1, size_t nb2, size_t nb3,
+    int use_qjl,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(ne00 > 0 && (ne00 % QK_POLAR) == 0);
+    const block_q4_polar * src0 = (const block_q4_polar *) src0_d;
+    const dim3 grid((unsigned) (ne00 / QK_POLAR), (unsigned) ne10, (unsigned) (ne11 * ne12));
+    const dim3 block(QK_POLAR, 1, 1);
+
+    switch ((ggml_type) dst_type) {
+        case GGML_TYPE_F32:
+            polar_get_rows_kernel<float><<<grid, block, 0, stream>>>(
+                src0, src1_d, (float *) dst_d, ne00,
+                nb01, nb02, nb03, ne10, ne11, ne12,
+                nb10, nb11, nb12, nb1, nb2, nb3, use_qjl);
+            break;
+        case GGML_TYPE_F16:
+            polar_get_rows_kernel<half><<<grid, block, 0, stream>>>(
+                src0, src1_d, (half *) dst_d, ne00,
+                nb01, nb02, nb03, ne10, ne11, ne12,
+                nb10, nb11, nb12, nb1, nb2, nb3, use_qjl);
+            break;
+        case GGML_TYPE_BF16:
+            polar_get_rows_kernel<nv_bfloat16><<<grid, block, 0, stream>>>(
+                src0, src1_d, (nv_bfloat16 *) dst_d, ne00,
+                nb01, nb02, nb03, ne10, ne11, ne12,
+                nb10, nb11, nb12, nb1, nb2, nb3, use_qjl);
+            break;
+        default:
+            GGML_ABORT("get_rows_q4_polar_cuda: unsupported dst type %d", dst_type);
+    }
+}
+
+#endif // GGML_CUDA_POLARQUANT
diff --git a/ggml/src/ggml-cuda/polarquant.cuh b/ggml/src/ggml-cuda/polarquant.cuh
new file mode 100644
index 0000000..5acc7a6
--- /dev/null
+++ b/ggml/src/ggml-cuda/polarquant.cuh
@@ -0,0 +1,80 @@
+#pragma once
+
+// PolarQuant Q4 CUDA support.
+//
+// Block layout (block_q4_polar, ggml-common.h):
+//   ggml_half d;                          // per-block fp16 L2 norm
+//   uint8_t   qs[QK_POLAR / 2];           // 4-bit centroid indices, 2 per byte (low nibble even)
+//   uint8_t   qjl[QJL_RESIDUAL_BYTES];    // optional 1-bit QJL residual sign
+// Total 82 bytes per block (= 5.125 bpw with QJL residual on, 4.125 bpw on disk if qjl=0).
+//
+// Math reference: packages/native-plugins/polarquant-cpu/src/{polar_dequantize_ref.c,
+// polar_dot_ref.c, polar_hadamard.c, polar_qjl.c}. Bit parity must hold
+// against those — this CUDA port reproduces the same Lloyd-Max centroid
+// table, the same iterative 7-stage Walsh-Hadamard butterfly, and the same
+// xorshift32 sign sequence used by the QJL residual correction.
+//
+// Compile-only validation: file body is gated on GGML_CUDA_POLARQUANT.
+
+#include "common.cuh"
+
+#if defined(GGML_CUDA_POLARQUANT)
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Dequantize one row of block_q4_polar to fp32.
+//   x_d : block_q4_polar, length nrows.
+//   y_d : fp32, length nrows * QK_POLAR.
+//   use_qjl : non-zero applies the QJL residual correction. Must match
+//             encoder. Default per the W3-B Polar slot is "QJL gated to off
+//             by runtime flag" — see Q4_POLAR commit 7d0fa96.
+void dequantize_row_q4_polar_cuda(
+    const void * x_d,
+    float * y_d,
+    int64_t nrows,
+    int use_qjl,
+    cudaStream_t stream);
+
+// Q4_POLAR x Q8_0 mul-mat (vector path: produces one fp32 dot product per
+// (block_q4_polar row x block_q8_0 row) pair).
+//   x_d : block_q4_polar, [nrows_x * (n_per_row / QK_POLAR)]
+//   y_d : block_q8_0,     [nrows_y * (n_per_row / QK8_0)]
+//   dst : fp32, [nrows_x * nrows_y]
+// nrows_x = the number of Q4_POLAR rows we mul-mat. nrows_y = the batch.
+// n_per_row = the row length in scalar elements. Must be a multiple of
+// QK_POLAR (=128).
+void mul_mat_q4_polar_q8_0_cuda(
+    const void * x_d,
+    const void * y_d,
+    float * dst_d,
+    int nrows_x,
+    int nrows_y,
+    int n_per_row,
+    int use_qjl,
+    cudaStream_t stream);
+
+// get_rows for Q4_POLAR: dequantize selected rows into fp32 / fp16 / bf16
+// destination. Mirrors get_rows_cuda_q in getrows.cu, but goes through the
+// PolarQuant decoder so the nibble unpack + WHT + L2 rescale is fused in
+// one pass (since the dequantize_q4_polar device-side function is too
+// heavy to fit the float2-output dequantize_q* signature).
+void get_rows_q4_polar_cuda(
+    const void * src0_d,
+    const int32_t * src1_d,
+    void * dst_d,
+    int dst_type,                  // ggml_type cast to int (F32=0, F16=1, BF16=30)
+    int64_t ne00,
+    size_t nb01, size_t nb02, size_t nb03,
+    int64_t ne10, int64_t ne11, int64_t ne12,
+    size_t nb10, size_t nb11, size_t nb12,
+    size_t nb1,  size_t nb2,  size_t nb3,
+    int use_qjl,
+    cudaStream_t stream);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // GGML_CUDA_POLARQUANT
diff --git a/ggml/src/ggml-cuda/qjl-set-rows.cuh b/ggml/src/ggml-cuda/qjl-set-rows.cuh
new file mode 100644
index 0000000..b1f3bfb
--- /dev/null
+++ b/ggml/src/ggml-cuda/qjl-set-rows.cuh
@@ -0,0 +1,50 @@
+#pragma once
+
+// Device-side QJL quantize for GGML_OP_SET_ROWS (KV cache writes).
+#if defined(GGML_CUDA_QJL)
+
+#include "common.cuh"
+#include "ggml-common.h"
+
+// Host uploads the default projection matrix before SET_ROWS kernels run.
+extern __device__ float * ggml_cuda_qjl_prj_dev;
+
+__device__ __forceinline__ uint16_t qjl_fp32_to_bf16_dev_setrows(float f) {
+    uint32_t u;
+    memcpy(&u, &f, sizeof(u));
+    const uint32_t lsb = (u >> 16) & 1u;
+    u += 0x7FFFu + lsb;
+    return (uint16_t) (u >> 16);
+}
+
+// Quantize one 128-float key row into block_qjl1_256 (matches qjl_quantize_row_ref).
+__device__ inline void quantize_f32_qjl1_256_block(const float * x, block_qjl1_256 * y) {
+    const float * prj = ggml_cuda_qjl_prj_dev;
+    if (prj == nullptr) {
+        return;
+    }
+
+    float norm_sq = 0.0f;
+    for (int i = 0; i < 128; ++i) {
+        const float v = x[i];
+        norm_sq += v * v;
+    }
+    y->d = qjl_fp32_to_bf16_dev_setrows(sqrtf(norm_sq));
+
+    for (int byte_i = 0; byte_i < (QK_QJL / 8); ++byte_i) {
+        uint8_t packed = 0;
+        for (int bit = 0; bit < 8; ++bit) {
+            const int j = byte_i * 8 + bit;
+            float acc = 0.0f;
+            for (int i = 0; i < 128; ++i) {
+                acc += x[i] * prj[i * QK_QJL + j];
+            }
+            if (acc > 0.0f) {
+                packed |= (uint8_t) (1u << bit);
+            }
+        }
+        y->signs[byte_i] = packed;
+    }
+}
+
+#endif // GGML_CUDA_QJL
diff --git a/ggml/src/ggml-cuda/qjl.cu b/ggml/src/ggml-cuda/qjl.cu
new file mode 100644
index 0000000..812c402
--- /dev/null
+++ b/ggml/src/ggml-cuda/qjl.cu
@@ -0,0 +1,387 @@
+// QJL (Quantized JL Transform) CUDA kernels.
+//
+// Production translation of the research kernels at
+// packages/training/scripts/quantization/qjl/csrc/{qjl_quant_kernel.cu,
+// qjl_score_kernel.cu}. The research kernels carry calibration counters,
+// outlier hashing, and torch::extension plumbing; this file strips those
+// to the in-fork production essentials and dispatches directly on
+// block_qjl1_256 (ggml type 46).
+//
+// Math reference: packages/native-plugins/qjl-cpu/src/qjl_quantize_ref.c
+// and qjl_score_ref.c. Parity must hold against those — every bit-pack
+// pattern matches the CPU shim at ggml/src/ggml-cpu/qjl/quants-qjl.c.
+//
+// Compile-only validation: this file is only compiled when GGML_CUDA_QJL
+// is defined. The CMake glob in ggml-cuda/CMakeLists.txt picks up the .cu
+// unconditionally; the body is gated by the macro so the no-flag build
+// still produces an empty object file (no symbols).
+
+#include "ggml.h"
+#include "ggml-impl.h"
+#include "qjl.cuh"
+
+#if defined(GGML_CUDA_QJL)
+
+#include "common.cuh"
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cstdint>
+#include <cmath>
+#include <cstdlib>
+#include <mutex>
+
+// Device pointer read by qjl-set-rows.cuh during SET_ROWS.
+__device__ float * ggml_cuda_qjl_prj_dev = nullptr;
+
+namespace {
+
+static float * g_qjl_prj_h = nullptr;
+static float * g_qjl_prj_d = nullptr;
+static std::once_flag g_qjl_prj_once;
+
+static uint64_t qjl_splitmix64(uint64_t * state) {
+    uint64_t z = (*state += 0x9E3779B97F4A7C15ULL);
+    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+    return z ^ (z >> 31);
+}
+
+static double qjl_u01_open(uint64_t * state) {
+    const uint64_t v = qjl_splitmix64(state);
+    return ((double) ((v >> 11) | 1ULL)) * (1.0 / 9007199254740992.0);
+}
+
+static void qjl_make_projection_mt(float * prj, int head_dim, int proj_dim, uint64_t seed) {
+    uint64_t state = seed ^ 0xC0FFEE1234567890ULL;
+    const int total = head_dim * proj_dim;
+    int i = 0;
+    while (i + 1 < total) {
+        const double u1 = qjl_u01_open(&state);
+        const double u2 = qjl_u01_open(&state);
+        const double r  = sqrt(-2.0 * log(u1));
+        const double th = 6.28318530717958647692 * u2;
+        prj[i++] = (float) (r * cos(th));
+        prj[i++] = (float) (r * sin(th));
+    }
+    if (i < total) {
+        const double u1 = qjl_u01_open(&state);
+        const double u2 = qjl_u01_open(&state);
+        const double r  = sqrt(-2.0 * log(u1));
+        const double th = 6.28318530717958647692 * u2;
+        prj[i++] = (float) (r * cos(th));
+    }
+}
+
+static void qjl_init_projection_host() {
+    constexpr int head_dim = 128;
+    constexpr int proj_dim = 256;
+    g_qjl_prj_h = (float *) malloc(sizeof(float) * head_dim * proj_dim);
+    GGML_ASSERT(g_qjl_prj_h != nullptr);
+    qjl_make_projection_mt(g_qjl_prj_h, head_dim, proj_dim, 42ULL);
+}
+
+} // namespace
+
+void ggml_cuda_qjl_ensure_projection(cudaStream_t stream) {
+    std::call_once(g_qjl_prj_once, []() {
+        qjl_init_projection_host();
+        CUDA_CHECK(cudaMalloc(&g_qjl_prj_d, sizeof(float) * 128 * 256));
+        CUDA_CHECK(cudaMemcpy(g_qjl_prj_d, g_qjl_prj_h, sizeof(float) * 128 * 256, cudaMemcpyHostToDevice));
+        CUDA_CHECK(cudaMemcpyToSymbol(ggml_cuda_qjl_prj_dev, &g_qjl_prj_d, sizeof(float *)));
+    });
+    GGML_UNUSED(stream);
+}
+
+#define QJL_PROJ_DIM   QK_QJL                  // 256
+#define QJL_HASH_BYTES (QJL_PROJ_DIM / 8)      // 32
+#define QJL_WARP_SIZE  32
+
+// bf16 pattern (uint16) -> fp32. Matches qjl_bf16_to_fp32 in the CPU shim.
+static __device__ __forceinline__ float qjl_bf16_to_fp32_dev(uint16_t bits) {
+    uint32_t u = ((uint32_t) bits) << 16;
+    float f;
+    memcpy(&f, &u, sizeof(f));
+    return f;
+}
+
+// fp32 -> bf16 pattern (round-to-nearest-even, matches qjl_fp32_to_bf16
+// in the CPU shim).
+static __device__ __forceinline__ uint16_t qjl_fp32_to_bf16_dev(float f) {
+    uint32_t u;
+    memcpy(&u, &f, sizeof(u));
+    // round-to-nearest-even with ties to even.
+    uint32_t lsb = (u >> 16) & 1u;
+    uint32_t round_bias = 0x7FFFu + lsb;
+    uint32_t rounded = u + round_bias;
+    return (uint16_t) (rounded >> 16);
+}
+
+// ---------------- quantize ----------------
+//
+// One block per row. Per row we:
+//   - compute ||key||_2 (fp32 reduction across the 128 lanes)
+//   - compute sketch[j] = sum_i key[i] * prj[i*proj_dim + j], for each of
+//     the 256 sketch dims, packing the sign into a 32-byte signs[] buffer.
+//
+// Block geometry: 256 threads/block, one thread per sketch dim. Each
+// thread loads its prj column (head_dim=128 values) and dot-products
+// against the shared key. The 256 results are then ballot-reduced into
+// 32 packed sign bytes via warp shfl + a single uint32 atomic-or per byte.
+
+__global__ void qjl_quantize_kernel(
+    const float * __restrict__ x,
+    block_qjl1_256 * __restrict__ y,
+    const float * __restrict__ prj,
+    int nrows)
+{
+    const int row = blockIdx.x;
+    if (row >= nrows) return;
+
+    const int tid = threadIdx.x;
+    const int j   = tid; // sketch dim index, 0..255
+
+    __shared__ float s_key[QJL_HEAD_DIM];
+
+    // Cooperative load of the row's head_dim=128 key into shared.
+    if (tid < QJL_HEAD_DIM) {
+        s_key[tid] = x[row * QJL_HEAD_DIM + tid];
+    }
+    __syncthreads();
+
+    // Per-thread sketch[j] = sum_i s_key[i] * prj[i * proj_dim + j].
+    float acc = 0.0f;
+    if (j < QJL_PROJ_DIM) {
+        #pragma unroll
+        for (int i = 0; i < QJL_HEAD_DIM; ++i) {
+            acc += s_key[i] * prj[i * QJL_PROJ_DIM + j];
+        }
+    }
+
+    // Pack signs LSB-first. Use a warp-level ballot to combine 32 lanes
+    // into a single uint32, then one byte at a time into the output.
+    // Layout: 8 warps of 32 threads cover all 256 sketch dims.
+    const unsigned active_mask = 0xFFFFFFFFu;
+    unsigned bits = __ballot_sync(active_mask, acc > 0.0f);
+
+    // lane 0 of each warp writes 4 bytes of packed signs at offset
+    // (warp_id * 4) within signs[].
+    const int warp_id = tid >> 5;
+    const int lane    = tid & 31;
+    if (lane == 0) {
+        // bits[lane k] -> bit k of byte (warp_id*4 + k/8) at position k%8
+        // Since bits is already LSB-first by lane, the 4 bytes are
+        // (bits & 0xFF), (bits >> 8 & 0xFF), (bits >> 16 & 0xFF), (bits >> 24 & 0xFF).
+        y[row].signs[warp_id * 4 + 0] = (uint8_t) ( bits        & 0xFFu);
+        y[row].signs[warp_id * 4 + 1] = (uint8_t) ((bits >> 8)  & 0xFFu);
+        y[row].signs[warp_id * 4 + 2] = (uint8_t) ((bits >> 16) & 0xFFu);
+        y[row].signs[warp_id * 4 + 3] = (uint8_t) ((bits >> 24) & 0xFFu);
+    }
+
+    // Compute ||key||_2 with a block-level reduction; lane 0 of warp 0 writes d.
+    float ks = 0.0f;
+    if (tid < QJL_HEAD_DIM) {
+        ks = s_key[tid] * s_key[tid];
+    }
+    // Warp reduce sum
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        ks += __shfl_xor_sync(active_mask, ks, off);
+    }
+    __shared__ float s_partial[8];
+    if ((tid & 31) == 0 && warp_id < 8) {
+        s_partial[warp_id] = ks;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        float total = 0.0f;
+        // Only the first 4 warps contributed to head_dim=128.
+        for (int w = 0; w < 4; ++w) total += s_partial[w];
+        y[row].d = qjl_fp32_to_bf16_dev(sqrtf(total));
+    }
+}
+
+void quantize_row_qjl1_256_cuda(
+    const float * x_d,
+    void * y_d,
+    int64_t nrows,
+    const float * prj_d,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(nrows > 0);
+    GGML_ASSERT(QJL_HEAD_DIM == 128 && "QJL CUDA path only supports head_dim=128");
+    block_qjl1_256 * y = (block_qjl1_256 *) y_d;
+    const dim3 grid((unsigned) nrows, 1, 1);
+    const dim3 block(QJL_PROJ_DIM, 1, 1);
+    qjl_quantize_kernel<<<grid, block, 0, stream>>>(x_d, y, prj_d, (int) nrows);
+}
+
+// ---------------- dequantize ----------------
+//
+// Mirrors qjl_dequantize_row_ref:
+//   recon[i] = scl * norm * sum_j sign(blk->signs, j) * prj[i*proj_dim + j]
+// with scl = sqrt(pi/2) / proj_dim.
+//
+// Block geometry: one block per row, 128 threads/block (one per head_dim
+// output slot). Each thread runs its 256-term inner product directly. We
+// load the signs once into shared.
+
+__global__ void qjl_dequantize_kernel(
+    const block_qjl1_256 * __restrict__ x,
+    float * __restrict__ y,
+    const float * __restrict__ prj,
+    int nrows)
+{
+    const int row = blockIdx.x;
+    if (row >= nrows) return;
+
+    const int i = threadIdx.x;
+    if (i >= QJL_HEAD_DIM) return;
+
+    __shared__ uint8_t s_signs[QJL_HASH_BYTES];
+    if (threadIdx.x < QJL_HASH_BYTES) {
+        s_signs[threadIdx.x] = x[row].signs[threadIdx.x];
+    }
+    __syncthreads();
+
+    const float norm = qjl_bf16_to_fp32_dev(x[row].d);
+    const float scl  = QJL_SQRT_PI_OVER_2 / (float) QJL_PROJ_DIM * norm;
+
+    float acc = 0.0f;
+    const float * prj_row = prj + i * QJL_PROJ_DIM;
+    #pragma unroll 8
+    for (int j = 0; j < QJL_PROJ_DIM; ++j) {
+        const int bit = (s_signs[j >> 3] >> (j & 7)) & 1;
+        acc += bit ? prj_row[j] : -prj_row[j];
+    }
+    y[row * QJL_HEAD_DIM + i] = scl * acc;
+}
+
+void dequantize_row_qjl1_256_cuda(
+    const void * x_d,
+    float * y_d,
+    int64_t nrows,
+    const float * prj_d,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(nrows > 0);
+    const block_qjl1_256 * x = (const block_qjl1_256 *) x_d;
+    const dim3 grid((unsigned) nrows, 1, 1);
+    const dim3 block(QJL_HEAD_DIM, 1, 1);
+    qjl_dequantize_kernel<<<grid, block, 0, stream>>>(x, y_d, prj_d, (int) nrows);
+}
+
+// ---------------- attention score ----------------
+//
+// score[hq, t] = ||k_t|| * sqrt(pi/2)/proj_dim *
+//                sum_j sign(packed[t, j]) * q_sketch[hq, j]
+// h_kv = hq / (n_heads / n_kv_heads).
+//
+// Block geometry: grid (n_heads, n_kv_tokens), block (proj_dim/8 = 32)
+// — 32 threads per block reduce 8 sign bytes each, dot-producting against
+// q_sketch[hq] in 8-wide chunks. We use warp shfl reduction and one
+// scalar write per output.
+
+__global__ void qjl_score_kernel(
+    const float * __restrict__ q_sketch,        // [n_heads,    proj_dim]
+    const block_qjl1_256 * __restrict__ packed, // [n_kv_heads, n_kv_tokens]
+    int n_heads,
+    int n_kv_heads,
+    int n_kv_tokens,
+    float * __restrict__ scores)                // [n_heads,    n_kv_tokens]
+{
+    const int hq = blockIdx.x;
+    const int t  = blockIdx.y;
+    if (hq >= n_heads || t >= n_kv_tokens) return;
+
+    const int gqa = n_heads / n_kv_heads;
+    const int hk  = hq / gqa;
+
+    const block_qjl1_256 & blk = packed[hk * n_kv_tokens + t];
+    const float * qs = q_sketch + hq * QJL_PROJ_DIM;
+
+    // 32 threads, each handles 8 sketch dims (one byte of packed signs).
+    const int tid = threadIdx.x;
+    const uint8_t byte_signs = blk.signs[tid];
+    float acc = 0.0f;
+    #pragma unroll
+    for (int b = 0; b < 8; ++b) {
+        const int j = tid * 8 + b;
+        const float qv = qs[j];
+        acc += ((byte_signs >> b) & 1) ? qv : -qv;
+    }
+
+    // Warp reduction (32 threads = 1 warp, perfect fit).
+    const unsigned mask = 0xFFFFFFFFu;
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        acc += __shfl_xor_sync(mask, acc, off);
+    }
+
+    if (tid == 0) {
+        const float norm = qjl_bf16_to_fp32_dev(blk.d);
+        const float scl  = QJL_SQRT_PI_OVER_2 / (float) QJL_PROJ_DIM;
+        scores[hq * n_kv_tokens + t] = scl * norm * acc;
+    }
+}
+
+void attn_score_qjl_cuda(
+    const float * q_sketch_d,
+    const void  * packed_k_d,
+    int n_heads,
+    int n_kv_heads,
+    int n_kv_tokens,
+    float * scores_d,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(n_heads > 0 && n_kv_heads > 0 && n_kv_tokens > 0);
+    GGML_ASSERT((n_heads % n_kv_heads) == 0);
+    const block_qjl1_256 * packed = (const block_qjl1_256 *) packed_k_d;
+    const dim3 grid(n_heads, n_kv_tokens, 1);
+    const dim3 block(QJL_HASH_BYTES, 1, 1); // = 32
+    qjl_score_kernel<<<grid, block, 0, stream>>>(
+        q_sketch_d, packed, n_heads, n_kv_heads, n_kv_tokens, scores_d);
+}
+
+// ---------------- Q projection ----------------
+//
+// sketch[j] = sum_i q[i] * prj[i * proj_dim + j], one thread per (q_pos, head, j).
+
+__global__ void qjl_project_q_kernel(
+    const float * __restrict__ q,
+    const float * __restrict__ prj,
+    float * __restrict__ out,
+    int head_dim,
+    int proj_dim,
+    int n_heads,
+    int n_q_pos) {
+    const int j   = blockIdx.x * blockDim.x + threadIdx.x;
+    const int hq  = blockIdx.y;
+    const int qp  = blockIdx.z;
+    if (j >= proj_dim || hq >= n_heads || qp >= n_q_pos) return;
+
+    const float * qh = q + ((size_t) qp * n_heads + hq) * head_dim;
+    float acc = 0.f;
+    for (int i = 0; i < head_dim; ++i) {
+        acc += qh[i] * prj[i * proj_dim + j];
+    }
+    out[((size_t) qp * n_heads + hq) * proj_dim + j] = acc;
+}
+
+void qjl_project_q_cuda(
+    const float * q_d,
+    float * q_sketch_d,
+    int head_dim,
+    int proj_dim,
+    int n_heads,
+    int n_q_pos,
+    cudaStream_t stream) {
+    GGML_ASSERT(head_dim > 0 && proj_dim > 0 && n_heads > 0 && n_q_pos > 0);
+    ggml_cuda_qjl_ensure_projection(stream);
+    const dim3 block(256, 1, 1);
+    const dim3 grid((proj_dim + 255) / 256, n_heads, n_q_pos);
+    qjl_project_q_kernel<<<grid, block, 0, stream>>>(
+        q_d, g_qjl_prj_d, q_sketch_d, head_dim, proj_dim, n_heads, n_q_pos);
+}
+
+#endif // GGML_CUDA_QJL
