+
+// Decode one block_tbq3_tcq into 128 fp32 values via the sliding 9-bit
+// window. Bit-identical to eliza_dequantize_turbo3_tcq_block.
+//
+// One CUDA block per polar block, 128 threads per block; each thread
+// decodes one symbol. The 9-bit window read crosses at most 2 bytes
+// (since 9 > 8) — always 2 in practice once t >= 1. We load qs[] into
+// shared memory once at block entry to avoid 128 redundant global reads.
+
+__device__ __forceinline__ int tbq3_tcq_extract_state(const uint8_t * __restrict__ qs, int t) {
+    // bit_pos = t*3, read 9 bits.
+    const int bit_pos  = t * 3;
+    const int byte_idx = bit_pos >> 3;
+    const int bit_off  = bit_pos & 7;
+    uint16_t raw = (uint16_t) qs[byte_idx];
+    if (byte_idx + 1 < 49) {
+        raw |= ((uint16_t) qs[byte_idx + 1]) << 8;
+    }
+    return (int) ((raw >> bit_off) & 0x1FF);
+}
+
+__global__ void tbq3_tcq_dequantize_kernel(
+    const block_tbq3_tcq * __restrict__ x,
+    float * __restrict__ y,
+    int nrows)
+{
+    const int b = blockIdx.x;
+    if (b >= nrows) return;
+
+    __shared__ uint8_t s_qs[49];
+    const int tid = threadIdx.x;
+    if (tid < 49) {
+        s_qs[tid] = x[b].qs[tid];
+    }
+    __syncthreads();
+
+    if (tid >= QK_TBQ3_TCQ) return;
+
+    const float n     = __half2float(x[b].d);
+    const int   state = tbq3_tcq_extract_state(s_qs, tid);
+    y[b * QK_TBQ3_TCQ + tid] = k_tbq3_tcq_codebook_cuda[state] * n;
+}
+
+void dequantize_row_tbq3_tcq_cuda(
+    const void * x_d,
+    float * y_d,
+    int64_t nrows,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(nrows > 0);
+    const block_tbq3_tcq * x = (const block_tbq3_tcq *) x_d;
+    const dim3 grid((unsigned) nrows, 1, 1);
+    const dim3 block(QK_TBQ3_TCQ, 1, 1);
+    tbq3_tcq_dequantize_kernel<<<grid, block, 0, stream>>>(x, y_d, (int) nrows);
+}
+
+// ---------------- TBQ3_TCQ x Q8_0 dot product ----------------
+//
+// One CUDA block per (row_x, row_y). Inside the block we walk the
+// (n_per_row / QK_TBQ3_TCQ) TCQ blocks for row_x and accumulate against
+// the matching 4 Q8_0 blocks for row_y.
+
+__global__ void tbq3_tcq_mul_mat_kernel(
+    const block_tbq3_tcq * __restrict__ x,
+    const block_q8_0     * __restrict__ y,
+    float * __restrict__ dst,
+    int nrows_x,
+    int nrows_y,
+    int n_per_row)
+{
+    const int row_x = blockIdx.x;
+    const int row_y = blockIdx.y;
+    if (row_x >= nrows_x || row_y >= nrows_y) return;
+
+    const int n_tcq = n_per_row / QK_TBQ3_TCQ;
+    const int n_q8_per_tcq = QK_TBQ3_TCQ / QK8_0; // = 4
+
+    const block_tbq3_tcq * x_row = x + row_x * n_tcq;
+    const block_q8_0     * y_row = y + row_y * (n_per_row / QK8_0);
+
+    const int tid = threadIdx.x;
+    float acc = 0.0f;
+
+    __shared__ uint8_t s_qs[49];
+
+    for (int b = 0; b < n_tcq; ++b) {
+        const block_tbq3_tcq * src = x_row + b;
+        if (tid < 49) {
+            s_qs[tid] = src->qs[tid];
+        }
+        __syncthreads();
+
+        if (tid < QK_TBQ3_TCQ) {
+            const float n     = __half2float(src->d);
+            const int   state = tbq3_tcq_extract_state(s_qs, tid);
+            const float xv    = k_tbq3_tcq_codebook_cuda[state] * n;
+
+            const int qb     = tid / QK8_0;
+            const int qslot  = tid % QK8_0;
+            const block_q8_0 * yb = y_row + b * n_q8_per_tcq + qb;
+            const float scale = __half2float(yb->d);
+            acc += xv * scale * (float) yb->qs[qslot];
+        }
+        __syncthreads();
+    }
+
+    // Block reduction.
+    __shared__ float s_partial[4]; // 128 / 32 = 4 warps
+    const unsigned mask = 0xFFFFFFFFu;
+    #pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        acc += __shfl_xor_sync(mask, acc, off);
+    }
+    if ((tid & 31) == 0) {
+        s_partial[tid >> 5] = acc;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        float total = 0.0f;
+        for (int w = 0; w < 4; ++w) total += s_partial[w];
+        dst[row_x * nrows_y + row_y] = total;
+    }
+}
+
+void mul_mat_tbq3_tcq_q8_0_cuda(
+    const void * x_d,
+    const void * y_d,
+    float * dst_d,
+    int nrows_x,
+    int nrows_y,
+    int n_per_row,
+    cudaStream_t stream)
+{
+    GGML_ASSERT(nrows_x > 0 && nrows_y > 0 && n_per_row > 0);
+    GGML_ASSERT((n_per_row % QK_TBQ3_TCQ) == 0);
+    const block_tbq3_tcq * x = (const block_tbq3_tcq *) x_d;
+    const block_q8_0     * y = (const block_q8_0     *) y_d;
+    const dim3 grid((unsigned) nrows_x, (unsigned) nrows_y, 1);
+    const dim3 block(QK_TBQ3_TCQ, 1, 1);
+    tbq3_tcq_mul_mat_kernel<<<grid, block, 0, stream>>>(
+        x, y, dst_d, nrows_x, nrows_y, n_per_row);
+}
+
+#endif // GGML_CUDA_TBQ3_TCQ
