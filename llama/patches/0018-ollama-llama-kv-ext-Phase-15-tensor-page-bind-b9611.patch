 src/llama-kv-cache.cpp | 53 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 5382cd726..8ea01dd73 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -678,6 +678,59 @@ llama_pos llama_kv_cache::seq_pos_max(llama_seq_id seq_id) const {
     return cells.seq_pos_max(seq_id);
 }
 
+int32_t llama_kv_cache::cell_index_for(llama_seq_id seq_id, llama_pos pos, uint32_t * out_stream) const {
+    if (other) {
+        return other->cell_index_for(seq_id, pos, out_stream);
+    }
+
+    if (seq_id < 0 || (size_t) seq_id >= seq_to_stream.size()) {
+        return -1;
+    }
+
+    const uint32_t stream = seq_to_stream[seq_id];
+    const auto & cells = v_cells[stream];
+
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (cells.is_empty(i)) {
+            continue;
+        }
+        if (cells.seq_has(i, seq_id) && cells.pos_get(i) == pos) {
+            if (out_stream) {
+                *out_stream = stream;
+            }
+            return (int32_t) i;
+        }
+    }
+
+    return -1;
+}
+
+uint32_t llama_kv_cache::n_kv_layers() const {
+    return (uint32_t) layers.size();
+}
+
+ggml_tensor * llama_kv_cache::kv_tensor_k(int32_t kv_layer, uint32_t stream) const {
+    if (kv_layer < 0 || (size_t) kv_layer >= layers.size()) {
+        return nullptr;
+    }
+    const auto & lay = layers[kv_layer];
+    if (n_stream > 1 && stream < lay.k_stream.size()) {
+        return lay.k_stream[stream];
+    }
+    return lay.k;
+}
+
+ggml_tensor * llama_kv_cache::kv_tensor_v(int32_t kv_layer, uint32_t stream) const {
+    if (kv_layer < 0 || (size_t) kv_layer >= layers.size()) {
+        return nullptr;
+    }
+    const auto & lay = layers[kv_layer];
+    if (n_stream > 1 && stream < lay.v_stream.size()) {
+        return lay.v_stream[stream];
+    }
+    return lay.v;
+}
+
