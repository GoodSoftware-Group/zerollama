+static inline bool unicode_ascii_is_letter_byte(unsigned char b) {
+    return ((b | 0x20u) - (unsigned char) 'a') < 26u;
+}
+
+static inline bool unicode_ascii_is_digit_byte(unsigned char b) {
+    return (b - (unsigned char) '0') < 10u;
