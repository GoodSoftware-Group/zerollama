+static inline bool unicode_want_simd_pretok() {
+    // WHY (0126): SWAR/NEON ASCII letter+digit consume. Opt-out keeps the 0114 8-wide LUT loop.
+    return getenv("LLAMA_BPE_NO_SIMD_PRETOK") == nullptr;
