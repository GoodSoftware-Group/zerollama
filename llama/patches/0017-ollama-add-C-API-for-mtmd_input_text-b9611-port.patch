From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zerollama <zerollama@local>
Date: Fri, 10 Jul 2026 00:55:23 -0700
Subject: [PATCH] ollama: add C API for mtmd_input_text (b9611 port)

---
 tools/mtmd/mtmd.cpp | 10 ++++++++++
 tools/mtmd/mtmd.h   |  3 +++
 2 files changed, 13 insertions(+)

diff --git a/tools/mtmd/mtmd.cpp b/tools/mtmd/mtmd.cpp
index 4063d28e0..9113b440e 100644
--- a/tools/mtmd/mtmd.cpp
+++ b/tools/mtmd/mtmd.cpp
@@ -440,6 +440,16 @@ const char * mtmd_default_marker() {
     return "<__media__>";
 }
 
+mtmd_input_text * mtmd_input_text_init(const char * text, bool add_special, bool parse_special) {
+    return new mtmd_input_text{text, add_special, parse_special};
+}
+
+void mtmd_input_text_free(mtmd_input_text * input_text) {
+    if (input_text) {
+        delete input_text;
+    }
+}
+
 static clip_flash_attn_type mtmd_get_clip_flash_attn_type(enum llama_flash_attn_type flash_attn_type) {
     switch (flash_attn_type) {
         case LLAMA_FLASH_ATTN_TYPE_AUTO:     return CLIP_FLASH_ATTN_TYPE_AUTO;
diff --git a/tools/mtmd/mtmd.h b/tools/mtmd/mtmd.h
index 78587f3fe..2255a62a8 100644
--- a/tools/mtmd/mtmd.h
+++ b/tools/mtmd/mtmd.h
@@ -85,6 +85,9 @@ typedef struct mtmd_input_chunks mtmd_input_chunks;
 typedef struct mtmd_input_text   mtmd_input_text;
 typedef struct mtmd_batch        mtmd_batch;
 
+MTMD_API mtmd_input_text * mtmd_input_text_init(const char * text, bool add_special, bool parse_special);
+MTMD_API void                mtmd_input_text_free(mtmd_input_text * input_text);
+
 typedef bool (*mtmd_progress_callback)(float progress, void * user_data);
 
 struct mtmd_context_params {
