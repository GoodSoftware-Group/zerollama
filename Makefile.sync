# Unified llama.cpp vendor sync (ggml-org master + Ollama/zerollama patches).
# Runtime sibling and in-process ggml share LLAMA_CPP_COMMIT.
UPSTREAM=https://github.com/ggml-org/llama.cpp.git
WORKDIR=vendor/llama-cpp-8f114a9b
FETCH_HEAD=8f114a9b
# Full git ref for checkout / rev-list (see repo-root LLAMA_CPP_COMMIT).
FETCH_REF=8f114a9b573b69035299f9b924047f53c1e22c7e
# build-info.cpp int field (past latest tag b9951 on master tip).
BUILD_NUMBER=9952

# WHY sync order matters: build-info.cpp only stamps FETCH_HEAD/BUILD_NUMBER via sed.
# If rsync from vendor/ is skipped, binaries report the new pin while in-tree
# llama/llama.cpp and ggml still reflect an older checkout — Phase 17 smoke,
# native KV, and operator `llama_print_build_info()` all lie.
#
# WHY `make sync` does NOT run `checkout`: `checkout` resets vendor/ to bare
# FETCH_REF and destroys Ollama patch commits before rsync — you would ship an
# unpatch tree while build-info still says ad56033f. Use:
#   make -f Makefile.sync clean apply-patches   # once per pin bump
#   ./scripts/vendor/sync_vendor_llama.sh              # after every vendor edit
# `make sync` is a thin alias for the script (no git checkout).

.PHONY: help
help:
	@echo "Available targets:"
	@echo "    sync                 Sync with upstream repositories"
	@echo "    checkout             Checkout upstream repository"
	@echo "    apply-patches        Apply patches to local repository"
	@echo "    format-patches       Format patches from local repository"
	@echo "    clean                Clean local repository"
	@echo
	@echo "Example:"
	@echo "    make -f $(lastword $(MAKEFILE_LIST)) clean apply-patches sync"

.PHONY: sync sync-from-vendor
sync sync-from-vendor:
	./scripts/vendor/sync_vendor_llama.sh

# Legacy granular targets (rsync only — never reset vendor checkout)
llama/build-info.cpp: llama/build-info.cpp.in llama/llama.cpp
	sed -e 's|@FETCH_HEAD@|$(FETCH_HEAD)|' \
	    -e 's|@LLAMA_BUILD_NUMBER@|$(BUILD_NUMBER)|' \
	    -e 's|@BUILD_COMPILER@||' \
	    -e 's|@BUILD_TARGET@||' \
	    <$< >$@

ml/backend/ggml/ggml/src/ggml-metal/ggml-metal-embed.metal: ml/backend/ggml/ggml
	go generate ./$(@D)

.PHONY: llama/llama.cpp
llama/llama.cpp: $(WORKDIR)
	rsync -arvzc --delete -f "include LICENSE" -f "merge $@/.rsync-filter" $(addprefix $(WORKDIR),/LICENSE /) $@

.PHONY: ml/backend/ggml/ggml
ml/backend/ggml/ggml: $(WORKDIR)
	rsync -arvzc --delete -f "include LICENSE" -f "merge $@/.rsync-filter" $(addprefix $(WORKDIR),/LICENSE /ggml/) $@

PATCHES=$(wildcard llama/patches/*.patch)
PATCHED=$(join $(dir $(PATCHES)), $(addsuffix ed, $(addprefix ., $(notdir $(PATCHES)))))

.PHONY: apply-patches
.NOTPARALLEL:
apply-patches: $(PATCHED)

llama/patches/.%.patched: llama/patches/%.patch
	@if git -c user.name=nobody -c 'user.email=<>' -C $(WORKDIR) am -3 $(realpath $<); then \
		touch $@;                                                                           \
	else                                                                                    \
		echo "Patch failed. Resolve any conflicts then continue.";                          \
		echo "1. Run 'git -C $(WORKDIR) am --continue'";                                    \
		echo "2. Run 'make -f $(lastword $(MAKEFILE_LIST)) format-patches'";                \
		echo "3. Run 'make -f $(lastword $(MAKEFILE_LIST)) clean apply-patches'";           \
		exit 1;                                                                             \
	fi

.PHONY: checkout
checkout: $(WORKDIR)
	git -C $(WORKDIR) fetch
	git -C $(WORKDIR) checkout -f $(FETCH_REF)

$(WORKDIR):
	git clone $(UPSTREAM) $(WORKDIR)
	git -C $(WORKDIR) checkout -f $(FETCH_REF)

.PHONY: format-patches
format-patches: llama/patches
	git -C $(WORKDIR) format-patch \
		--no-signature \
		--no-numbered \
		--zero-commit \
		-o $(realpath $<) \
		$(FETCH_REF)

.PHONY: clean
clean: checkout
	@git -C $(WORKDIR) am --abort || true
	@for rel in \
	  common/ane_draft_hook.cpp \
	  common/ane_draft_hook.h \
	  common/ane_draft_session.h \
	  common/ane_draft_session.mm \
	  common/ane_draft_session_stub.cpp \
	  common/ane_iosurface_map.h \
	  src/llama-ext.h \
	  src/ollama-compat; do \
	  if [ -e "$(WORKDIR)/$$rel" ] && ! git -C $(WORKDIR) ls-files --error-unmatch "$$rel" >/dev/null 2>&1; then \
	    echo ">>> removing untracked $$rel (blocks git am)"; \
	    rm -rf "$(WORKDIR)/$$rel"; \
	  fi; \
	done
	$(RM) llama/patches/.*.patched

.PHONY: print-base
print-base:
	@echo $(FETCH_REF)
